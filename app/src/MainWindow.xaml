<Window x:Class="Syno.TinyTorrent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syno.TinyTorrent"
    xmlns:icons="using:Syno"
    xmlns:table="using:Syno.TableView">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="{ThemeResource TinyTorrentCaptionHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Caption" Background="{ThemeResource TinyTorrentChromeBrush}" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInset" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInset" Width="0" />
            </Grid.ColumnDefinitions>
            <Image x:Name="CaptionLogo" Grid.Column="1" Width="{ThemeResource TinyTorrentCaptionHeight}"
                Height="{ThemeResource TinyTorrentCaptionHeight}" Margin="8,0">
                <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/tinyTorrent.svg" /></Image.Source>
            </Image>
            <TextBlock x:Name="CaptionText" Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <Grid Grid.Column="3" />
            <StackPanel x:Name="CaptionActions" Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="AddButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Add}" />
                <Button x:Name="PauseButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Pause}" />
                <Button x:Name="ResumeButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Resume}" />
                <Button x:Name="LanguageButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.SwitchLanguage}" />
                <Button x:Name="ThemeButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.SwitchTheme}" />
                <Button x:Name="ExitButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Exit}" />
            </StackPanel>
        </Grid>
        <table:Table x:Name="Torrents" Grid.Row="1" ShowsFitButton="True" ItemsSource="{x:Bind Model.Torrents}">
            <table:Table.EmptyContent>
                <Grid x:Name="EmptyState" Visibility="{x:Bind Model.IsEmptyVisible, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24" Spacing="12">
                        <TextBlock x:Name="EmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                        <TextBlock x:Name="EmptyInstruction" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="EmptyAdd" HorizontalAlignment="Center" Command="{x:Bind Model.Add}" />
                    </StackPanel>
                </Grid>
            </table:Table.EmptyContent>
            <table:Table.Columns>
                <table:Column x:Name="NameColumn" Id="name" Width="280" MinWidth="160" CanHide="False">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" AutomationProperties.HelpText="{x:Bind ErrorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="SizeColumn" Id="size" Width="110" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="ProgressColumn" Id="progress" Width="148" CellAlignment="Stretch">
                    <table:Column.CellTemplate>
                        <DataTemplate x:DataType="local:Torrent">
                            <Grid VerticalAlignment="Center" RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ProgressBar Minimum="0" Maximum="1" Height="4" Value="{x:Bind Progress, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Row="1" Text="{x:Bind ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="StatusColumn" Id="status" Width="160">
                    <table:Column.CellTemplate>
                        <DataTemplate x:DataType="local:Torrent">
                            <Grid VerticalAlignment="Center" ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="DownColumn" Id="down" Width="130" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind DownloadText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="UpColumn" Id="up" Width="130" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind UploadText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
            </table:Table.Columns>
        </table:Table>
        <StackPanel Grid.Row="2" Margin="16,8,16,12" Spacing="4">
            <InfoBar x:Name="Feedback" IsClosable="False" Severity="{x:Bind Model.Severity, Mode=OneWay}" Message="{x:Bind Model.Message, Mode=OneWay}" IsOpen="{x:Bind Model.HasFeedback, Mode=OneWay}" />
            <TextBlock x:Name="TorrentError" TextWrapping="Wrap" Text="{x:Bind Model.TorrentError, Mode=OneWay}" />
            <TextBlock x:Name="Rates" Text="{x:Bind Model.Rates, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>
