<Window x:Class="Syno.TinyTorrent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syno.TinyTorrent"
    xmlns:icons="using:Syno"
    xmlns:table="using:Syno.TableView">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Loaded="OnLoaded" AllowDrop="True" Background="Transparent" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="{ThemeResource TinyTorrentCaptionHeight}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Caption" Background="{ThemeResource TinyTorrentChromeBrush}" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInset" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInset" Width="0" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AppMenu" Grid.Column="1" Width="32" Margin="8,0" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Click="OnMenu" PointerEntered="OnLogoEntered" PointerExited="OnLogoExited" GotFocus="OnLogoFocus" LostFocus="OnLogoFocus">
            <Grid>
            <Image x:Name="CaptionLogo" Width="{ThemeResource TinyTorrentCaptionHeight}"
                Height="{ThemeResource TinyTorrentCaptionHeight}">
                <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/tinyTorrent.svg" /></Image.Source>
            </Image>
            <FontIcon x:Name="MenuGlyph" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Menu}" FontSize="16" Visibility="Collapsed" />
            </Grid>
            </Button>
            <TextBlock x:Name="CaptionText" Grid.Column="2" Margin="8,0" VerticalAlignment="Center"
                FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <Grid Grid.Column="3" />
            <StackPanel x:Name="CaptionActions" Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="AddButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Add}" />
                <Button x:Name="MagnetButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.AddMagnet}" />
                <Button x:Name="PauseButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Pause}" />
                <Button x:Name="ResumeButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Resume}" />
                <Button x:Name="OverflowButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" IsEnabled="{x:Bind Model.HasSelection, Mode=OneWay}" Click="OnOverflow" />
                <Button x:Name="LanguageButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.SwitchLanguage}" />
                <Button x:Name="ThemeButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.SwitchTheme}" />
                <Button x:Name="ExitButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Exit}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="16,12,16,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="TorrentsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <ToggleButton Grid.Column="1" Content="{x:Bind Model.ErrorCount, Mode=OneWay}" IsChecked="{x:Bind Model.ErrorsOnly, Mode=TwoWay}" />
            <TextBox x:Name="Search" Grid.Column="3" Text="{x:Bind Model.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <table:Table x:Name="Torrents" Grid.Row="2" ShowsFitButton="True" ItemsSource="{x:Bind Model.VisibleTorrents}" CanReorder="{x:Bind Model.CanReorder, Mode=OneWay}">
            <table:Table.EmptyContent>
                <Grid x:Name="EmptyState" Visibility="{x:Bind Model.IsEmptyVisible, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24" Spacing="12">
                        <TextBlock x:Name="EmptyTitle" Text="{x:Bind Model.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                        <TextBlock x:Name="EmptyInstruction" Text="{x:Bind Model.EmptyInstruction, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="EmptyAdd" Content="{x:Bind Model.EmptyActionText, Mode=OneWay}" HorizontalAlignment="Center" Command="{x:Bind Model.EmptyAction, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </table:Table.EmptyContent>
            <table:Table.Columns>
                <table:Column x:Name="QueueColumn" Id="queue" Width="48" CellAlignment="Right" DefinesRowOrder="True">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind QueueText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="NameColumn" Id="name" Width="280" MinWidth="160" CanHide="False">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" AutomationProperties.HelpText="{x:Bind ErrorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="SizeColumn" Id="size" Width="110" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="ProgressColumn" Id="progress" Width="148" CellAlignment="Stretch">
                    <table:Column.CellTemplate>
                        <DataTemplate x:DataType="local:Torrent">
                            <Grid VerticalAlignment="Center" RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ProgressBar Minimum="0" Maximum="1" Height="4" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind IsProgressNormal, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                <ProgressBar Minimum="0" Maximum="1" Height="4" Value="{x:Bind Progress, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsPaused, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                <ProgressBar Minimum="0" Maximum="1" Height="4" Value="{x:Bind Progress, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsError, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Row="1" Text="{x:Bind ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="StatusColumn" Id="status" Width="160">
                    <table:Column.CellTemplate>
                        <DataTemplate x:DataType="local:Torrent">
                            <Grid VerticalAlignment="Center" ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="DownColumn" Id="down" Width="130" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind DownloadText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="UpColumn" Id="up" Width="130" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind UploadText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="EtaColumn" Id="eta" Width="90" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind EtaText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="RatioColumn" Id="ratio" Width="80" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind RatioText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="PeersColumn" Id="peers" Width="100" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind PeersText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="AddedColumn" Id="added" Width="160">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind AddedText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
            </table:Table.Columns>
        </table:Table>
        <Grid Grid.Row="3" Visibility="{x:Bind Model.HasInspector, Mode=OneWay}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,12" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Model.Inspector.Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="InspectorClose" Grid.Column="1" Click="OnInspectorClose" />
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <Grid ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="4"><TextBlock x:Name="DownloadedLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Model.InspectorDownloaded, Mode=OneWay}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="RemainingLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Model.InspectorRemaining, Mode=OneWay}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock x:Name="RatioLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Model.Inspector.RatioText, Mode=OneWay}" /></StackPanel>
                    <StackPanel Grid.Row="1" Spacing="4"><TextBlock x:Name="FolderLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Model.InspectorFolder, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock x:Name="AddedLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Model.Inspector.AddedText, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock x:Name="TransferLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{x:Bind Model.Inspector.Status, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="4" Margin="16,8,16,12" Spacing="4">
            <InfoBar x:Name="Feedback" IsClosable="False" Severity="{x:Bind Model.Severity, Mode=OneWay}" Message="{x:Bind Model.Message, Mode=OneWay}" IsOpen="{x:Bind Model.HasFeedback, Mode=OneWay}" />
            <TextBlock x:Name="TorrentError" TextWrapping="Wrap" Text="{x:Bind Model.TorrentError, Mode=OneWay}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Rates" Text="{x:Bind Model.Rates, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleButton x:Name="Alternative" Grid.Column="1" IsChecked="{x:Bind Model.AlternativeLimits, Mode=TwoWay}" IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"><TextBlock x:Name="AlternativeText" MaxWidth="160" TextWrapping="Wrap" /></ToggleButton>
                <TextBlock Grid.Column="2" Text="{x:Bind Model.Incoming, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
