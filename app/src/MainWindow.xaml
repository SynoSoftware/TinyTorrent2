<Window x:Class="Syno.TinyTorrent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syno.TinyTorrent"
    xmlns:icons="using:Syno"
    xmlns:table="using:Syno.TableView">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" Loaded="OnLoaded" AllowDrop="True" Background="{ThemeResource TinyTorrentChromeBrush}" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="{ThemeResource TinyTorrentCaptionHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Caption" Background="Transparent" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftInset" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightInset" Width="0" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="1" Width="{ThemeResource TinyTorrentCaptionHeight}" Margin="8,0"
                Height="{ThemeResource TinyTorrentCaptionHeight}" AutomationProperties.AccessibilityView="Raw">
                <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/tinyTorrent.svg" /></Image.Source>
            </Image>
            <Button x:Name="HomeButton" Grid.Column="2" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Width="Auto" Padding="8,0" Click="OnTorrents">
            <TextBlock x:Name="CaptionText" Margin="8,0" VerticalAlignment="Center"
                FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
            <ToggleButton x:Name="FilterButton" Grid.Column="3" MinWidth="46" Height="32" Padding="8,0" CornerRadius="0"
                Background="Transparent" BorderThickness="0" IsChecked="{x:Bind Model.IsFilterOpen, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Funnel}" FontSize="16" /><TextBlock x:Name="FilterCaption" Text="{x:Bind Model.FilterLabel, Mode=OneWay}" VerticalAlignment="Center" /></StackPanel>
            </ToggleButton>
            <Grid x:Name="SearchArea" Grid.Column="4" Margin="16,0" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="Search" MaxWidth="320" MinWidth="160" HorizontalAlignment="Stretch" Text="{x:Bind Model.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    QueryIcon="Find" TextMemberPath="Label" TextChanged="OnSearchChanged" QuerySubmitted="OnSearchSubmitted" GotFocus="OnSearchFocus">
                    <AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="local:Suggestion"><StackPanel Spacing="2" Margin="0,4"><TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></DataTemplate></AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Grid>
            <StackPanel x:Name="CaptionActions" Grid.Column="5" Orientation="Horizontal">
                <TextBlock x:Name="PageCaption" Text="{x:Bind Model.PageTitle, Mode=OneWay}" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="Collapsed" />
                <Button x:Name="AddButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Add}" />
                <Button x:Name="MagnetButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.AddMagnet}" />
                <Button x:Name="PauseButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Pause}" />
                <Button x:Name="ResumeButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Resume}" />
                <Button x:Name="OverflowButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" IsEnabled="{x:Bind Model.HasSelection, Mode=OneWay}" Click="OnOverflow" />
                <Button x:Name="LanguageButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.SwitchLanguage}" />
                <Button x:Name="ThemeButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.SwitchTheme}" />
                <Button x:Name="ExitButton" Style="{StaticResource TinyTorrentCaptionButtonStyle}" Command="{x:Bind Model.Exit}" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsPaneOpen="False" OpenPaneLength="200" AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed" IsTitleBarAutoPaddingEnabled="False" IsSettingsVisible="False"
            Background="Transparent" SelectionChanged="OnNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="TorrentsPage">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.List}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsPage">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Settings}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutPage">
                    <NavigationViewItem.Icon><FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Info}" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
        <SplitView x:Name="Workspace" DisplayMode="Inline" OpenPaneLength="196" IsPaneOpen="{x:Bind Model.IsFilterOpen, Mode=TwoWay}" PaneBackground="Transparent" Background="Transparent">
            <SplitView.Pane>
                <Grid RowSpacing="8" Padding="8,8,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="FiltersTitle" Margin="8,0" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" /><Button x:Name="FiltersClose" Grid.Column="1" Click="OnFiltersClose" /></Grid>
                    <ListView x:Name="Filters" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnFilterChanged">
                        <ListView.ItemTemplate><DataTemplate x:DataType="local:FilterChoice"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label, Mode=OneWay}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{x:Bind Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </SplitView.Pane>
            <Grid x:Name="TorrentWorkspace" Background="Transparent">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="110" /><RowDefinition Height="Auto" /><RowDefinition x:Name="InspectorRow" Height="0" /></Grid.RowDefinitions>
        <table:Table x:Name="Torrents" Background="Transparent" ShowsFitButton="True" ItemsSource="{x:Bind Model.VisibleTorrents}" CanReorder="{x:Bind Model.CanReorder, Mode=OneWay}">
            <table:Table.EmptyContent>
                <Grid x:Name="EmptyState" Visibility="{x:Bind Model.IsEmptyVisible, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24" Spacing="12">
                        <TextBlock x:Name="EmptyTitle" Text="{x:Bind Model.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                        <TextBlock x:Name="EmptyInstruction" Text="{x:Bind Model.EmptyInstruction, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="EmptyAdd" Content="{x:Bind Model.EmptyActionText, Mode=OneWay}" HorizontalAlignment="Center" Command="{x:Bind Model.EmptyAction, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </table:Table.EmptyContent>
            <table:Table.Columns>
                <table:Column x:Name="QueueColumn" Id="queue" Width="48" CellAlignment="Right" DefinesRowOrder="True">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind QueueText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="NameColumn" Id="name" Width="280" MinWidth="160" CanHide="False">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center" AutomationProperties.HelpText="{x:Bind ErrorText, Mode=OneWay}" TextTrimming="CharacterEllipsis" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="SizeColumn" Id="size" Width="110" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="ProgressColumn" Id="progress" Width="148" CellAlignment="Stretch">
                    <table:Column.CellTemplate>
                        <DataTemplate x:DataType="local:Torrent">
                            <Grid VerticalAlignment="Center" RowSpacing="4">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ProgressBar Minimum="0" Maximum="1" Height="4" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind IsProgressNormal, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                <ProgressBar Minimum="0" Maximum="1" Height="4" Value="{x:Bind Progress, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind IsPaused, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                <ProgressBar Minimum="0" Maximum="1" Height="4" Value="{x:Bind Progress, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind IsError, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Row="1" Text="{x:Bind ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="StatusColumn" Id="status" Width="160">
                    <table:Column.CellTemplate>
                        <DataTemplate x:DataType="local:Torrent">
                            <Grid VerticalAlignment="Center" ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="DownColumn" Id="down" Width="130" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind DownloadText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="UpColumn" Id="up" Width="130" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind UploadText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="EtaColumn" Id="eta" Width="90" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind EtaText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="RatioColumn" Id="ratio" Width="80" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind RatioText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="PeersColumn" Id="peers" Width="100" CellAlignment="Right">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind PeersText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
                <table:Column x:Name="AddedColumn" Id="added" Width="160">
                    <table:Column.CellTemplate><DataTemplate x:DataType="local:Torrent"><TextBlock Text="{x:Bind AddedText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate>
                </table:Column>
            </table:Table.Columns>
        </table:Table>
        <local:InspectorSplit x:Name="Split" Grid.Row="1" Visibility="{x:Bind Model.HasInspector, Mode=OneWay}" />
        <Grid Grid.Row="2" Visibility="{x:Bind Model.HasInspector, Mode=OneWay}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12" Padding="16,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Model.Inspector.Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="InspectorClose" Grid.Column="1" Click="OnInspectorClose" />
            </Grid>
            <ContentControl x:Name="InspectorContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
            </Grid>
        </SplitView>
        <ContentControl x:Name="PreferencesContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
        <ScrollViewer x:Name="AboutContent" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32" Spacing="8">
                <Image Width="64" Height="64" Margin="0,0,0,8" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw">
                    <Image.Source><SvgImageSource UriSource="ms-appx:///Assets/tinyTorrent.svg" /></Image.Source>
                </Image>
                <TextBlock Text="{x:Bind Model.AboutTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Model.AboutDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Model.VersionText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>
        </ScrollViewer>
            </Grid>
        </NavigationView>
        <StackPanel Grid.Row="2" Margin="16,8,16,12" Spacing="4">
            <InfoBar x:Name="Feedback" IsClosable="False" Severity="{x:Bind Model.Severity, Mode=OneWay}" Message="{x:Bind Model.Message, Mode=OneWay}" IsOpen="{x:Bind Model.HasFeedback, Mode=OneWay}" Visibility="{x:Bind Model.HasFeedback, Mode=OneWay}">
                <InfoBar.ActionButton><Button AutomationProperties.AutomationId="Restart" Content="{x:Bind Model.RestartText, Mode=OneWay}" Command="{x:Bind Model.Restart}" Visibility="{x:Bind Model.CanRestart, Mode=OneWay}" /></InfoBar.ActionButton>
            </InfoBar>
            <TextBlock x:Name="TorrentError" TextWrapping="Wrap" Text="{x:Bind Model.TorrentError, Mode=OneWay}" Visibility="{x:Bind Model.HasTorrentError, Mode=OneWay}" />
            <Button Content="{x:Bind Model.UpdateText, Mode=OneWay}" Command="{x:Bind Model.OpenUpdate}" Visibility="{x:Bind Model.HasUpdate, Mode=OneWay}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Rates" Text="{x:Bind Model.Rates, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleButton x:Name="Alternative" Grid.Column="1" IsChecked="{x:Bind Model.AlternativeLimits, Mode=TwoWay}" IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"><TextBlock x:Name="AlternativeText" MaxWidth="160" TextWrapping="Wrap" /></ToggleButton>
                <ToggleButton Grid.Column="2" Margin="12,0,0,0" Content="{x:Bind Model.ErrorCount, Mode=OneWay}" IsChecked="{x:Bind Model.ErrorsOnly, Mode=TwoWay}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Model.Incoming, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
