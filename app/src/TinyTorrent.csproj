<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>$(WindowTargetName)</AssemblyName>
    <!-- Windows shows these in Task Manager and in Explorer's file details;
         otherwise each repeats the file name. -->
    <AssemblyTitle>TinyTorrent</AssemblyTitle>
    <Product>TinyTorrent</Product>
    <RootNamespace>Syno.TinyTorrent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\resources\TinyTorrent.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier
      Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != '' and '$(Platform)' != 'AnyCPU'"
      >win-$([System.String]::Copy('$(Platform)').ToLowerInvariant())</RuntimeIdentifier>
    <!-- The OS, not the build process, so a 32-bit MSBuild still builds x64. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
      >win-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- The solution's build dependency on the engine looks like a reference to
         a project on a newer Windows SDK. The engine is a separate native
         process that the window only copies beside itself. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3851</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <!-- A local build embeds the application credentials from
       secrets/keys.json, which git ignores, so a plain Visual Studio build
       reaches TMDB, OMDb, MDBList, OpenSubtitles, SubDL and SubSource. A
       property given on the command line wins. A missing file or key leaves
       TMDB, OMDb, MDBList and OpenSubtitles unavailable, and SubDL and
       SubSource needing the person's own key, which the Library and subtitle
       Settings show. The patterns
       read tmdb.readAccessToken and the apiKey of omdb, mdblist,
       opensubtitles, subdl and subsource; \x22 is a double quote, which
       MSBuild would otherwise read as an argument delimiter. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\secrets\keys.json')">
    <SecretsJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\secrets\keys.json'))</SecretsJson>
    <TmdbToken Condition="'$(TmdbToken)' == ''"
      >$([System.Text.RegularExpressions.Regex]::Replace('$(SecretsJson)', '(?s)^(?:.*\x22tmdb\x22\s*:\s*\{[^}]*\x22readAccessToken\x22\s*:\s*\x22([^\x22]*)\x22.*|.*)$', '$1'))</TmdbToken>
    <OmdbKey Condition="'$(OmdbKey)' == ''"
      >$([System.Text.RegularExpressions.Regex]::Replace('$(SecretsJson)', '(?s)^(?:.*\x22omdb\x22\s*:\s*\{[^}]*\x22apiKey\x22\s*:\s*\x22([^\x22]*)\x22.*|.*)$', '$1'))</OmdbKey>
    <MdbListKey Condition="'$(MdbListKey)' == ''"
      >$([System.Text.RegularExpressions.Regex]::Replace('$(SecretsJson)', '(?s)^(?:.*\x22mdblist\x22\s*:\s*\{[^}]*\x22apiKey\x22\s*:\s*\x22([^\x22]*)\x22.*|.*)$', '$1'))</MdbListKey>
    <SubDLKey Condition="'$(SubDLKey)' == ''"
      >$([System.Text.RegularExpressions.Regex]::Replace('$(SecretsJson)', '(?s)^(?:.*\x22subdl\x22\s*:\s*\{[^}]*\x22apiKey\x22\s*:\s*\x22([^\x22]*)\x22.*|.*)$', '$1'))</SubDLKey>
    <SubSourceKey Condition="'$(SubSourceKey)' == ''"
      >$([System.Text.RegularExpressions.Regex]::Replace('$(SecretsJson)', '(?s)^(?:.*\x22subsource\x22\s*:\s*\{[^}]*\x22apiKey\x22\s*:\s*\x22([^\x22]*)\x22.*|.*)$', '$1'))</SubSourceKey>
    <OpenSubtitlesKey Condition="'$(OpenSubtitlesKey)' == ''"
      >$([System.Text.RegularExpressions.Regex]::Replace('$(SecretsJson)', '(?s)^(?:.*\x22opensubtitles\x22\s*:\s*\{[^}]*\x22apiKey\x22\s*:\s*\x22([^\x22]*)\x22.*|.*)$', '$1'))</OpenSubtitlesKey>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableCapture)' == 'true'">
    <DefineConstants>$(DefineConstants);CAPTURE</DefineConstants>
    <ArtifactsPivots>$(Configuration.ToLowerInvariant())_$(RuntimeIdentifier.ToLowerInvariant())_capture</ArtifactsPivots>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableCapture)' != 'true'">
    <Compile Remove="Shell\MainWindow\Capture*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="MaxMind.Db" Version="5.2.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <ProjectReference Include="..\..\lib\TableView\src\TableView.csproj" />
    <EmbeddedResource Include="Resources\*.json" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\world.bin" LogicalName="world.bin" />
    <Content Include="Assets\tmdb.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content
      Include="Assets\*.jpg;Assets\Settings\*.svg;Assets\Settings\*.png;Assets\Settings\LICENSE"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\resources\TinyTorrent.ico"
      Link="Assets\TinyTorrent.ico"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="..\..\resources\tinyTorrent.svg"
      Link="Assets\tinyTorrent.svg"
      CopyToOutputDirectory="PreserveNewest"
    />
    <!-- The window and the engine each start only the other executable beside
         them, so the window's output holds the engine from the same configuration.
         TinyTorrent.slnx builds the engine first. -->
    <None
      Include="$(ArtifactsPath)\bin\Engine\$(Configuration)\$(EngineTargetName).exe"
      Link="$(EngineTargetName).exe"
      CopyToOutputDirectory="Never"
      CopyToPublishDirectory="PreserveNewest"
      Visible="false"
    />
    <UpToDateCheckInput Include="$(ArtifactsPath)\bin\Engine\$(Configuration)\$(EngineTargetName).exe" />
    <UpToDateCheckInput Include="..\CopyEngine.ps1" />
    <UpToDateCheckInput Include="..\CountryData.ps1" />
    <UpToDateCheckOutput Include="$(TargetDir)$(EngineTargetName).exe" />
    <UpToDateCheckOutput Include="$(TargetDir)Assets\dbip-country-lite.mmdb" />
    <AssemblyMetadata Include="EngineFile" Value="$(EngineTargetName).exe" />
    <AssemblyMetadata Include="TmdbToken" Value="$(TmdbToken)" Condition="'$(TmdbToken)' != ''" />
    <AssemblyMetadata Include="OmdbKey" Value="$(OmdbKey)" Condition="'$(OmdbKey)' != ''" />
    <AssemblyMetadata
      Include="MdbListKey"
      Value="$(MdbListKey)"
      Condition="'$(MdbListKey)' != ''"
    />
    <AssemblyMetadata Include="SubDLKey" Value="$(SubDLKey)" Condition="'$(SubDLKey)' != ''" />
    <AssemblyMetadata
      Include="SubSourceKey"
      Value="$(SubSourceKey)"
      Condition="'$(SubSourceKey)' != ''"
    />
    <AssemblyMetadata
      Include="OpenSubtitlesKey"
      Value="$(OpenSubtitlesKey)"
      Condition="'$(OpenSubtitlesKey)' != ''"
    />
  </ItemGroup>
  <Target
    Name="CopyEngine"
    BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;CopyFilesToOutputDirectory"
  >
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\CopyEngine.ps1&quot; -Source &quot;$(ArtifactsPath)\bin\Engine\$(Configuration)\$(EngineTargetName).exe&quot; -Destination &quot;$(TargetDir)$(EngineTargetName).exe&quot;" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)$(EngineTargetName).exe" />
    </ItemGroup>
  </Target>
  <!-- Peer countries resolve from DB-IP's country data, which the build fetches
       once a month, so a release ships the current month's file. -->
  <Target
    Name="CountryData"
    BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;CopyFilesToOutputDirectory"
  >
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\CountryData.ps1&quot; -Cache &quot;$(ArtifactsPath)\data&quot; -Destination &quot;$(TargetDir)Assets\dbip-country-lite.mmdb&quot;" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)Assets\dbip-country-lite.mmdb" />
    </ItemGroup>
  </Target>
  <!-- .NET Publish does not collect all the resources WinUI adds to build output. -->
  <Target
    Name="PublishXamlResources"
    AfterTargets="ComputeFilesToPublish"
    DependsOnTargets="_GenerateProjectPriFile;CustomOutputGroupForPackaging"
  >
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)Lucide\Fonts\lucide.ttf">
        <RelativePath>Lucide\Fonts\lucide.ttf</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)Lucide\Fonts\twemoji.ttf">
        <RelativePath>Lucide\Fonts\twemoji.ttf</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)Assets\dbip-country-lite.mmdb">
        <RelativePath>Assets\dbip-country-lite.mmdb</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish
        Include="@(CustomOutputGroupForPackagingOutput)"
        Condition="'$(DisableEmbeddedXbf)' == 'true'"
      >
        <RelativePath>%(CustomOutputGroupForPackagingOutput.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
