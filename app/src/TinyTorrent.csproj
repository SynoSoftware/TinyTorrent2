<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>$(WindowTargetName)</AssemblyName>
    <!-- Windows shows these in Task Manager and in Explorer's file details;
         otherwise each repeats the file name. -->
    <AssemblyTitle>TinyTorrent</AssemblyTitle>
    <Product>TinyTorrent</Product>
    <Company>TinyTorrent</Company>
    <RootNamespace>Syno.TinyTorrent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\resources\TinyTorrent.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">win-$([System.String]::Copy('$(Platform)').ToLowerInvariant())</RuntimeIdentifier>
    <!-- The OS, not the build process, so a 32-bit MSBuild still builds x64. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The solution's build dependency on the engine looks like a reference to
         a project on a newer Windows SDK. The engine is a separate native
         process that the window only copies beside itself. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3851</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableCapture)' == 'true'">
    <DefineConstants>$(DefineConstants);CAPTURE</DefineConstants>
    <ArtifactsPivots>$(Configuration.ToLowerInvariant())_$(RuntimeIdentifier.ToLowerInvariant())_capture</ArtifactsPivots>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableCapture)' != 'true'">
    <Compile Remove="MainWindow\Capture*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <ProjectReference Include="..\..\lib\TableView\src\TableView.csproj" />
    <EmbeddedResource Include="Resources\*.json" LogicalName="%(Filename)%(Extension)" />
    <Content Include="..\..\resources\TinyTorrent.ico" Link="Assets\TinyTorrent.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resources\tinyTorrent.svg" Link="Assets\tinyTorrent.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window and the engine each start only the other executable beside
         them, so the window's output holds the engine from the same configuration.
         TinyTorrent.slnx builds the engine first. -->
    <None Include="$(ArtifactsPath)\bin\Engine\$(Configuration)\$(EngineTargetName).exe" Link="$(EngineTargetName).exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <AssemblyMetadata Include="EngineFile" Value="$(EngineTargetName).exe" />
  </ItemGroup>
</Project>
