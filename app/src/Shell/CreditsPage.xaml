<UserControl
  x:Class="Syno.TinyTorrent.Shell.CreditsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <UserControl.Resources>
    <Style x:Key="AttributionStyle" TargetType="Border">
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="LicenceDividerStyle" TargetType="Border">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="0,16,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Margin="24,12,24,24" MaxWidth="900" Spacing="12">
      <BreadcrumbBar
        x:Name="Hierarchy"
        ItemClicked="OnHierarchy"
        FontSize="{StaticResource TitleTextBlockFontSize}"
      />
      <TextBlock
        x:Name="Introduction"
        TextWrapping="Wrap"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      />
    </StackPanel>
    <ScrollViewer
      Grid.Row="1"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      HorizontalContentAlignment="Stretch"
    >
      <Grid Margin="24,8,24,32">
        <StackPanel x:Name="Groups" MaxWidth="900" Spacing="8" />
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
