<UserControl
  x:Class="Syno.TinyTorrent.Shell.InspectorPane"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Shell"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:torrents="using:Syno.TinyTorrent.Torrents"
  xmlns:table="using:Syno.TableView"
  xmlns:icons="using:Syno"
>
  <controls:Pane
    x:Name="Surface"
    x:FieldModifier="internal"
    SizeChanged="OnHeaderSize"
    Dock="Bottom"
    CanClose="True"
    CanMaximize="True"
    Padding="0,0,4,4"
    AutomationProperties.AutomationId="Inspector"
  >
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="TransferStates">
        <VisualState x:Name="Transferring" />
        <VisualState x:Name="Error">
          <VisualState.Setters>
            <Setter
              Target="Summary.Foreground"
              Value="{ThemeResource SystemFillColorCriticalBrush}"
            />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <controls:Pane.Header>
      <!-- Left-aligned, so the size follows a short name and a long name trims before it. -->
      <Grid HorizontalAlignment="Left" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon
          x:Name="HeadingGlyph"
          Style="{StaticResource TinyTorrentSurfaceIconStyle}"
          FontFamily="{x:Bind icons:Lucide.Font}"
          Glyph="{x:Bind Model.Target.StatusGlyph, Mode=OneWay, FallbackValue=''}"
        />
        <TextBlock
          x:Name="HeadingName"
          Grid.Column="1"
          Text="{x:Bind Model.Name, Mode=OneWay}"
          Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
          ToolTipService.ToolTip="{x:Bind Model.Name, Mode=OneWay}"
          AutomationProperties.HeadingLevel="Level1"
        />
        <TextBlock
          x:Name="HeadingSize"
          Grid.Column="2"
          Text="{x:Bind Model.SizeText, Mode=OneWay}"
          Style="{StaticResource TinyTorrentTitleDetailTextStyle}"
        />
      </Grid>
    </controls:Pane.Header>
    <controls:Pane.Navigation>
      <Grid>
        <SelectorBar
          x:Name="Sections"
          Padding="0"
          SelectionChanged="OnSection"
          AutomationProperties.AutomationId="InspectorSections"
        >
          <SelectorBarItem
            x:Name="GeneralSection"
            AutomationProperties.AutomationId="InspectorGeneral"
          >
            <SelectorBarItem.Icon>
              <FontIcon
                Style="{StaticResource TinyTorrentStatusIconStyle}"
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.Info}"
              />
            </SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem
            x:Name="FilesSection"
            AutomationProperties.AutomationId="InspectorFiles"
          >
            <SelectorBarItem.Icon>
              <FontIcon
                Style="{StaticResource TinyTorrentStatusIconStyle}"
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.Files}"
              />
            </SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem
            x:Name="PeersSection"
            AutomationProperties.AutomationId="InspectorPeers"
          >
            <SelectorBarItem.Icon>
              <FontIcon
                Style="{StaticResource TinyTorrentStatusIconStyle}"
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.Users}"
              />
            </SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem
            x:Name="TrackersSection"
            AutomationProperties.AutomationId="InspectorTrackers"
          >
            <SelectorBarItem.Icon>
              <FontIcon
                Style="{StaticResource TinyTorrentStatusIconStyle}"
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.RadioTower}"
              />
            </SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem
            x:Name="SpeedSection"
            AutomationProperties.AutomationId="InspectorSpeed"
          >
            <SelectorBarItem.Icon>
              <FontIcon
                Style="{StaticResource TinyTorrentStatusIconStyle}"
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.Activity}"
              />
            </SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem
            x:Name="PiecesSection"
            AutomationProperties.AutomationId="InspectorPieces"
          >
            <SelectorBarItem.Icon>
              <FontIcon
                Style="{StaticResource TinyTorrentStatusIconStyle}"
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.Grid3x3}"
              />
            </SelectorBarItem.Icon>
          </SelectorBarItem>
        </SelectorBar>
        <SelectorBar
          x:Name="LibrarySections"
          Padding="0"
          Visibility="Collapsed"
          SelectionChanged="OnSection"
          AutomationProperties.AutomationId="LibrarySections"
        >
          <SelectorBarItem
            x:Name="LibraryInformation"
            AutomationProperties.AutomationId="LibraryInformation"
          >
            <SelectorBarItem.Icon>
              <FontIcon
                Style="{StaticResource TinyTorrentStatusIconStyle}"
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.Info}"
              />
            </SelectorBarItem.Icon>
          </SelectorBarItem>
          <SelectorBarItem x:Name="LibraryFile" AutomationProperties.AutomationId="LibraryFile">
            <SelectorBarItem.Icon>
              <FontIcon
                Style="{StaticResource TinyTorrentStatusIconStyle}"
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.File}"
              />
            </SelectorBarItem.Icon>
          </SelectorBarItem>
        </SelectorBar>
      </Grid>
    </controls:Pane.Navigation>
    <controls:Pane.Actions>
      <StackPanel
        x:Name="TabActions"
        Orientation="Horizontal"
        Spacing="4"
        VerticalAlignment="Center"
        Visibility="Collapsed"
      >
        <StackPanel
          x:Name="PrimaryActions"
          Orientation="Horizontal"
          Spacing="4"
          Visibility="Collapsed"
        />
        <Border x:Name="MoreAction" />
      </StackPanel>
    </controls:Pane.Actions>
    <Grid x:Name="SectionContent">
      <Grid x:Name="SectionViews">
        <ScrollViewer
          x:Name="General"
          x:Load="False"
          Margin="16,12"
          Visibility="Collapsed"
          HorizontalScrollMode="Disabled"
          HorizontalScrollBarVisibility="Disabled"
        >
          <StackPanel x:Name="GeneralContent" Spacing="16">
            <controls:Section
              Header="{x:Bind Model.Text.Get('inspector', 'transfer')}"
              Glyph="{x:Bind icons:Lucide.ArrowDownUp}"
            >
              <StackPanel>
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Text="{x:Bind Model.Target.Status, Mode=OneWay}"
                    Style="{StaticResource TinyTorrentSurfaceTitleTextStyle}"
                    IsTextSelectionEnabled="True"
                    ToolTipService.ToolTip="{x:Bind Model.Target.Status, Mode=OneWay}"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Model.ProgressText, Mode=OneWay}"
                    Style="{StaticResource TinyTorrentSurfaceTitleTextStyle}"
                  />
                </Grid>
                <ProgressBar
                  x:Name="Progress"
                  Style="{StaticResource TinyTorrentProgressStyle}"
                  Margin="0,8,0,8"
                  Value="{x:Bind Model.Target.Progress, Mode=OneWay}"
                  IsIndeterminate="{x:Bind Model.IsIndeterminate, Mode=OneWay}"
                  ShowError="{x:Bind Model.Target.IsError, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind Model.Text.Get('columns', 'progress')}"
                />
                <Grid ColumnSpacing="24">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="112" />
                    <ColumnDefinition Width="Auto" MinWidth="112" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    x:Name="Summary"
                    Text="{x:Bind Model.Summary, Mode=OneWay}"
                    Style="{StaticResource InspectorValueStyle}"
                    ToolTipService.ToolTip="{x:Bind Model.Summary, Mode=OneWay}"
                  />
                  <StackPanel
                    x:Name="DownloadRate"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('columns', 'down')}"
                  >
                    <FontIcon
                      Style="{StaticResource TinyTorrentStatusIconStyle}"
                      FontFamily="{x:Bind icons:Lucide.Font}"
                      Glyph="{x:Bind icons:Lucide.ArrowDown}"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      AutomationProperties.AccessibilityView="Raw"
                    />
                    <TextBlock
                      Text="{x:Bind Model.Target.DownloadText, Mode=OneWay}"
                      Style="{StaticResource InspectorValueStyle}"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      AutomationProperties.Name="{x:Bind Model.Target.DownloadName, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind Model.Target.DownloadText, Mode=OneWay}"
                    />
                  </StackPanel>
                  <StackPanel
                    x:Name="UploadRate"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('columns', 'up')}"
                  >
                    <FontIcon
                      Style="{StaticResource TinyTorrentStatusIconStyle}"
                      FontFamily="{x:Bind icons:Lucide.Font}"
                      Glyph="{x:Bind icons:Lucide.ArrowUp}"
                      Foreground="{ThemeResource TinyTorrentUploadBrush}"
                      AutomationProperties.AccessibilityView="Raw"
                    />
                    <TextBlock
                      Text="{x:Bind Model.Target.UploadText, Mode=OneWay}"
                      Style="{StaticResource InspectorValueStyle}"
                      Foreground="{ThemeResource TinyTorrentUploadBrush}"
                      AutomationProperties.Name="{x:Bind Model.Target.UploadName, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind Model.Target.UploadText, Mode=OneWay}"
                    />
                  </StackPanel>
                </Grid>
                <controls:Strip Margin="0,16,0,0" ColumnSpacing="32" RowSpacing="12">
                  <controls:Field
                    Style="{StaticResource TinyTorrentStatisticStyle}"
                    Glyph="{x:Bind icons:Lucide.Download}"
                    Label="{x:Bind Model.Text.Get('inspector', 'downloaded')}"
                  >
                    <TextBlock
                      Text="{x:Bind Model.Target.DownloadedText, Mode=OneWay}"
                      Style="{StaticResource TinyTorrentStatisticValueStyle}"
                    />
                  </controls:Field>
                  <controls:Field
                    Style="{StaticResource TinyTorrentStatisticStyle}"
                    Glyph="{x:Bind icons:Lucide.Upload}"
                    Label="{x:Bind Model.Text.Get('peers', 'uploaded')}"
                  >
                    <TextBlock
                      Text="{x:Bind Model.Target.UploadedText, Mode=OneWay}"
                      Style="{StaticResource TinyTorrentStatisticValueStyle}"
                    />
                  </controls:Field>
                  <controls:Field
                    x:Name="Ratio"
                    Style="{StaticResource TinyTorrentStatisticStyle}"
                    Glyph="{x:Bind icons:Lucide.Scale}"
                    Label="{x:Bind Model.Text.Get('columns', 'ratio')}"
                  >
                    <TextBlock
                      Text="{x:Bind Model.Target.RatioText, Mode=OneWay}"
                      Style="{StaticResource TinyTorrentStatisticValueStyle}"
                    />
                  </controls:Field>
                  <controls:Field
                    x:Name="SeedCount"
                    Style="{StaticResource TinyTorrentStatisticStyle}"
                    Glyph="{x:Bind icons:Lucide.Sprout}"
                    Label="{x:Bind Model.Text.Get('columns', 'seeds')}"
                  >
                    <TextBlock
                      Text="{x:Bind Model.Target.SeedsText, Mode=OneWay}"
                      Style="{StaticResource TinyTorrentStatisticValueStyle}"
                      ToolTipService.ToolTip="{x:Bind Model.Target.SeedsName, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Model.Target.SeedsName, Mode=OneWay}"
                    />
                  </controls:Field>
                  <controls:Field
                    x:Name="PeerCount"
                    Style="{StaticResource TinyTorrentStatisticStyle}"
                    Glyph="{x:Bind icons:Lucide.Users}"
                    Label="{x:Bind Model.Text.Get('columns', 'peers')}"
                  >
                    <TextBlock
                      Text="{x:Bind Model.Target.PeersText, Mode=OneWay}"
                      Style="{StaticResource TinyTorrentStatisticValueStyle}"
                      ToolTipService.ToolTip="{x:Bind Model.Target.PeersName, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Model.Target.PeersName, Mode=OneWay}"
                    />
                  </controls:Field>
                  <controls:Field
                    x:Name="Limit"
                    Style="{StaticResource TinyTorrentStatisticStyle}"
                    Glyph="{x:Bind icons:Lucide.Gauge}"
                    Label="{x:Bind Model.Text.Get('columns', 'limit')}"
                  >
                    <TextBlock
                      Text="{x:Bind Model.LimitText, Mode=OneWay}"
                      Style="{StaticResource TinyTorrentStatisticValueStyle}"
                      AutomationProperties.Name="{x:Bind Model.LimitName, Mode=OneWay}"
                    />
                  </controls:Field>
                </controls:Strip>
              </StackPanel>
            </controls:Section>
            <Border Style="{StaticResource InspectorDividerStyle}" />
            <controls:Section
              Header="{x:Bind Model.Text.Get('inspector', 'properties')}"
              Glyph="{x:Bind icons:Lucide.Info}"
            >
              <controls:FieldColumns>
                <controls:FieldColumns.Primary>
                  <StackPanel>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.Folder}"
                      Label="{x:Bind Model.Text.Get('inspector', 'folder')}"
                    >
                      <controls:Field.Action>
                        <Button
                          Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                          Command="{x:Bind Model.OpenFolder}"
                          AutomationProperties.Name="{x:Bind Model.Text.Get('commands', 'open_folder')}"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('commands', 'open_folder')}"
                        >
                          <FontIcon
                            FontSize="{StaticResource TinyTorrentButtonIconSize}"
                            FontFamily="{x:Bind icons:Lucide.Font}"
                            Glyph="{x:Bind icons:Lucide.FolderOpen}"
                          />
                        </Button>
                      </controls:Field.Action>
                      <TextBlock
                        x:Name="FolderPath"
                        Text="{x:Bind Model.Folder, Mode=OneWay}"
                        Style="{StaticResource InspectorValueStyle}"
                        FlowDirection="LeftToRight"
                        ToolTipService.ToolTip="{x:Bind Model.Folder, Mode=OneWay}"
                      />
                    </controls:Field>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.Hash}"
                      Label="{x:Bind Model.HashV1Label, Mode=OneWay}"
                      Visibility="{x:Bind controls:Visibilities.HasText(Model.HashV1), Mode=OneWay}"
                    >
                      <controls:Field.Action>
                        <Button
                          Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                          Command="{x:Bind Model.CopyV1}"
                          AutomationProperties.Name="{x:Bind Model.Text.Get('commands', 'copy_hash')}"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('commands', 'copy_hash')}"
                        >
                          <FontIcon
                            FontSize="{StaticResource TinyTorrentButtonIconSize}"
                            FontFamily="{x:Bind icons:Lucide.Font}"
                            Glyph="{x:Bind icons:Lucide.Copy}"
                          />
                        </Button>
                      </controls:Field.Action>
                      <TextBlock
                        Text="{x:Bind Model.HashV1, Mode=OneWay}"
                        Style="{StaticResource InspectorIdentifierStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.HashV1, Mode=OneWay}"
                      />
                    </controls:Field>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.Hash}"
                      Label="{x:Bind Model.HashV2Label, Mode=OneWay}"
                      Visibility="{x:Bind controls:Visibilities.HasText(Model.HashV2), Mode=OneWay}"
                    >
                      <controls:Field.Action>
                        <Button
                          Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                          Command="{x:Bind Model.CopyV2}"
                          AutomationProperties.Name="{x:Bind Model.Text.Get('commands', 'copy_hash')}"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('commands', 'copy_hash')}"
                        >
                          <FontIcon
                            FontSize="{StaticResource TinyTorrentButtonIconSize}"
                            FontFamily="{x:Bind icons:Lucide.Font}"
                            Glyph="{x:Bind icons:Lucide.Copy}"
                          />
                        </Button>
                      </controls:Field.Action>
                      <TextBlock
                        Text="{x:Bind Model.HashV2, Mode=OneWay}"
                        Style="{StaticResource InspectorIdentifierStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.HashV2, Mode=OneWay}"
                      />
                    </controls:Field>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.Magnet}"
                      Label="{x:Bind Model.Text.Get('add', 'magnet')}"
                    >
                      <controls:Field.Action>
                        <Button
                          Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                          Command="{x:Bind Model.CopyMagnet}"
                          AutomationProperties.Name="{x:Bind Model.Text.Get('commands', 'copy_magnet')}"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('commands', 'copy_magnet')}"
                        >
                          <FontIcon
                            FontSize="{StaticResource TinyTorrentButtonIconSize}"
                            FontFamily="{x:Bind icons:Lucide.Font}"
                            Glyph="{x:Bind icons:Lucide.Copy}"
                          />
                        </Button>
                      </controls:Field.Action>
                      <TextBlock
                        Text="{x:Bind Model.Magnet, Mode=OneWay}"
                        Style="{StaticResource InspectorIdentifierStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.Magnet, Mode=OneWay}"
                      />
                    </controls:Field>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.MessageSquare}"
                      Label="{x:Bind Model.Text.Get('inspector', 'comment')}"
                    >
                      <TextBlock
                        Text="{x:Bind Model.CommentText, Mode=OneWay}"
                        Style="{StaticResource InspectorValueStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.CommentText, Mode=OneWay}"
                      />
                    </controls:Field>
                  </StackPanel>
                </controls:FieldColumns.Primary>
                <controls:FieldColumns.Secondary>
                  <StackPanel>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.Clock}"
                      Label="{x:Bind Model.Text.Get('columns', 'added')}"
                    >
                      <TextBlock
                        Text="{x:Bind Model.Target.AddedTip, Mode=OneWay, TargetNullValue='—'}"
                        Style="{StaticResource InspectorValueStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.Target.AddedText, Mode=OneWay}"
                      />
                    </controls:Field>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.Grid3x3}"
                      Label="{x:Bind Model.Text.Get('inspector', 'pieces')}"
                    >
                      <TextBlock
                        Text="{x:Bind Model.PiecesText, Mode=OneWay}"
                        Style="{StaticResource InspectorValueStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.PiecesText, Mode=OneWay}"
                      />
                    </controls:Field>
                    <controls:Field
                      Glyph="{x:Bind Model.PrivacyGlyph, Mode=OneWay}"
                      Label="{x:Bind Model.Text.Get('inspector', 'privacy')}"
                    >
                      <TextBlock
                        Text="{x:Bind Model.PrivacyText, Mode=OneWay}"
                        Style="{StaticResource InspectorValueStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.PrivacyText, Mode=OneWay}"
                      />
                    </controls:Field>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.Calendar}"
                      Label="{x:Bind Model.Text.Get('inspector', 'created')}"
                    >
                      <TextBlock
                        Text="{x:Bind Model.CreatedText, Mode=OneWay}"
                        Style="{StaticResource InspectorValueStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.CreatedText, Mode=OneWay}"
                      />
                    </controls:Field>
                    <controls:Field
                      Glyph="{x:Bind icons:Lucide.Wrench}"
                      Label="{x:Bind Model.Text.Get('inspector', 'creator')}"
                    >
                      <TextBlock
                        Text="{x:Bind Model.CreatorText, Mode=OneWay}"
                        Style="{StaticResource InspectorValueStyle}"
                        ToolTipService.ToolTip="{x:Bind Model.CreatorText, Mode=OneWay}"
                      />
                    </controls:Field>
                  </StackPanel>
                </controls:FieldColumns.Secondary>
              </controls:FieldColumns>
            </controls:Section>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="Files" x:Load="False" Visibility="Collapsed">
          <ContentPresenter
            x:Name="FileContent"
            Visibility="{x:Bind Model.HasFiles, Mode=OneWay}"
          />
          <TextBlock
            x:Name="WaitingMetadata"
            Text="{x:Bind Model.Text.Get('pieces', 'metadata')}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind controls:Visibilities.Unless(Model.HasFiles), Mode=OneWay}"
          />
        </Grid>
        <Grid
          x:Name="PeerContent"
          x:Load="False"
          Visibility="Collapsed"
          Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
          SizeChanged="OnPeerSize"
        >
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
          </Grid.ColumnDefinitions>
          <Grid x:Name="PeerSurface" Visibility="Collapsed">
            <ContentControl
              x:Name="PeerDrawing"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
            />
            <controls:Field
              x:Name="PeerRates"
              Style="{StaticResource TinyTorrentStatisticStyle}"
              Margin="16"
              HorizontalAlignment="Left"
              VerticalAlignment="Bottom"
              FlowDirection="LeftToRight"
              Glyph="{x:Bind icons:Lucide.Activity}"
              Label="{x:Bind Model.Text.Get('inspector', 'speed')}"
            >
              <controls:TransferPair x:Name="PeerTransfer" />
            </controls:Field>
            <Border
              Margin="0,8,0,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
              CornerRadius="0,0,0,4"
            >
              <Button
                x:Name="MapClose"
                Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                Click="CloseMap"
              >
                <FontIcon
                  FontFamily="{x:Bind icons:Lucide.Font}"
                  Glyph="{x:Bind icons:Lucide.X}"
                  FontSize="{StaticResource TinyTorrentButtonIconSize}"
                />
              </Button>
            </Border>
          </Grid>
          <controls:Splitter x:Name="PeerSplit" Visibility="Collapsed" />
          <table:Table
            x:Name="Peers"
            Margin="0,8,0,0"
            ItemsSource="{x:Bind Model.ShownPeers, Mode=OneWay}"
          >
            <table:Table.EmptyContent>
              <TextBlock
                x:Name="NoPeers"
                Text="{x:Bind Model.Text.Get('peers', 'empty')}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
              />
            </table:Table.EmptyContent>
            <table:Table.Columns>
              <table:Column
                x:Name="EndpointColumn"
                Id="endpoint"
                Width="220"
                MinWidth="160"
                CanHide="False"
              >
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind Endpoint}"
                      VerticalAlignment="Center"
                      FlowDirection="LeftToRight"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column
                x:Name="PeerDownColumn"
                Id="down"
                Width="120"
                MinWidth="96"
                CellAlignment="Right"
              >
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind DownloadText, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind DownloadHint, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind DownloadHint, Mode=OneWay}"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column
                x:Name="PeerUpColumn"
                Id="up"
                Width="120"
                MinWidth="96"
                CellAlignment="Right"
              >
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind UploadText, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind UploadHint, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind UploadHint, Mode=OneWay}"
                      Foreground="{ThemeResource TinyTorrentUploadBrush}"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column
                x:Name="PeerProgressColumn"
                Id="progress"
                Width="100"
                MinWidth="80"
                CellAlignment="Right"
              >
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind ProgressText, Mode=OneWay}"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="PeerStateColumn" Id="state" Width="120" MinWidth="112">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <Grid
                      ColumnSpacing="6"
                      Background="Transparent"
                      ToolTipService.ToolTip="{x:Bind StateHint, Mode=OneWay}"
                    >
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <FontIcon
                        FontFamily="{StaticResource LucideFont}"
                        Glyph="{x:Bind StateGlyph, Mode=OneWay}"
                        Style="{StaticResource TinyTorrentStatusIconStyle}"
                        AutomationProperties.AccessibilityView="Raw"
                      />
                      <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind StateText, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind StateHint, Mode=OneWay}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                      />
                    </Grid>
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="ClientColumn" Id="client" Width="180" MinWidth="96">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind ClientText, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ClientHint, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind ClientHint, Mode=OneWay}"
                      VerticalAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <!-- Keep the saved location column's identity for Country. -->
              <table:Column x:Name="CountryColumn" Id="location" Width="180" MinWidth="140">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <Grid
                      ColumnSpacing="6"
                      Background="Transparent"
                      ToolTipService.ToolTip="{x:Bind CountryText, Mode=OneWay}"
                    >
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        Text="{x:Bind icons:Flags.Glyph(CountryCode), Mode=OneWay}"
                        FontFamily="{StaticResource FlagsFont}"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind controls:Visibilities.HasText(CountryCode), Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw"
                      />
                      <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind CountryText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                      />
                    </Grid>
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="CityColumn" Id="city" Width="160" MinWidth="112">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind CityText, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind CityText, Mode=OneWay}"
                      VerticalAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="ConnectionColumn" Id="connection" Width="220" MinWidth="120">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind ConnectionText, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind ConnectionHint, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind ConnectionHint, Mode=OneWay}"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column
                x:Name="PeerDownloadedColumn"
                Id="downloaded"
                Width="120"
                MinWidth="96"
                CellAlignment="Right"
              >
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind DownloadedText, Mode=OneWay}"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column
                x:Name="PeerUploadedColumn"
                Id="uploaded"
                Width="120"
                MinWidth="96"
                CellAlignment="Right"
              >
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Peer">
                    <TextBlock
                      Text="{x:Bind UploadedText, Mode=OneWay}"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
            </table:Table.Columns>
          </table:Table>
          <Border
            x:Name="TableCloseSurface"
            Margin="0,8,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            CornerRadius="0,0,0,4"
          >
            <Button
              x:Name="TableClose"
              Style="{StaticResource TinyTorrentSubtleButtonStyle}"
              Click="CloseTable"
            >
              <FontIcon
                FontFamily="{x:Bind icons:Lucide.Font}"
                Glyph="{x:Bind icons:Lucide.X}"
                FontSize="{StaticResource TinyTorrentButtonIconSize}"
              />
            </Button>
          </Border>
        </Grid>
        <Grid x:Name="Trackers" x:Load="False" Visibility="Collapsed" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="12"
            Margin="16,12,16,0"
            Visibility="{x:Bind controls:Visibilities.Unless(Model.IsEditingTrackers), Mode=OneWay}"
          >
            <controls:ActionButton
              Glyph="{x:Bind icons:Lucide.Pencil}"
              ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'edit_tip')}"
              x:Name="EditTrackers"
              Text="{x:Bind Model.Text.Get('trackers', 'edit')}"
              Command="{x:Bind Model.EditTrackers}"
            />
            <controls:ActionButton
              Glyph="{x:Bind icons:Lucide.RadioTower}"
              ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'reannounce_tip')}"
              x:Name="Reannounce"
              Text="{x:Bind Model.Text.Get('trackers', 'reannounce')}"
              Command="{x:Bind Model.Reannounce}"
            />
          </StackPanel>
          <table:Table
            x:Name="TrackerTable"
            Grid.Row="1"
            ItemsSource="{x:Bind Model.Trackers, Mode=OneWay}"
            Visibility="{x:Bind controls:Visibilities.Unless(Model.IsEditingTrackers), Mode=OneWay}"
          >
            <table:Table.EmptyContent>
              <TextBlock
                x:Name="NoTrackers"
                Text="{x:Bind Model.Text.Get('trackers', 'empty')}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
              />
            </table:Table.EmptyContent>
            <table:Table.Columns>
              <table:Column x:Name="UrlColumn" Id="url" Width="320" CanHide="False">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Tracker">
                    <TextBlock
                      Text="{x:Bind Url}"
                      VerticalAlignment="Center"
                      FlowDirection="LeftToRight"
                      TextTrimming="CharacterEllipsis"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="TierColumn" Id="tier" Width="64" CellAlignment="Right">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Tracker">
                    <TextBlock Text="{x:Bind TierText, Mode=OneWay}" VerticalAlignment="Center" />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="TrackerStatusColumn" Id="status" Width="120">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Tracker">
                    <Grid
                      ColumnSpacing="6"
                      Background="Transparent"
                      ToolTipService.ToolTip="{x:Bind StatusHint, Mode=OneWay}"
                    >
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <FontIcon
                        FontFamily="{StaticResource LucideFont}"
                        Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                        Style="{StaticResource TinyTorrentStatusIconStyle}"
                        AutomationProperties.AccessibilityView="Raw"
                      />
                      <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.HelpText="{x:Bind StatusHint, Mode=OneWay}"
                        Visibility="{x:Bind controls:Visibilities.Unless(IsError), Mode=OneWay}"
                      />
                      <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.HelpText="{x:Bind StatusHint, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind IsError, Mode=OneWay}"
                      />
                    </Grid>
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="SeedsColumn" Id="seeds" Width="90" CellAlignment="Right">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Tracker">
                    <TextBlock Text="{x:Bind SeedsText, Mode=OneWay}" VerticalAlignment="Center" />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="LeechersColumn" Id="leechers" Width="90" CellAlignment="Right">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Tracker">
                    <TextBlock
                      Text="{x:Bind LeechersText, Mode=OneWay}"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column
                x:Name="DownloadsColumn"
                Id="downloads"
                Width="100"
                CellAlignment="Right"
              >
                <table:Column.Header>
                  <TextBlock
                    Text="{x:Bind Model.Text.Get('trackers', 'downloads')}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'downloads_hint')}"
                    AutomationProperties.HelpText="{x:Bind Model.Text.Get('trackers', 'downloads_hint')}"
                  />
                </table:Column.Header>
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Tracker">
                    <TextBlock
                      Text="{x:Bind DownloadsText, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind DownloadsHint, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind DownloadsHint, Mode=OneWay}"
                      VerticalAlignment="Center"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="NextColumn" Id="next" Width="140">
                <table:Column.Header>
                  <TextBlock
                    Text="{x:Bind Model.Text.Get('trackers', 'next')}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'next_hint')}"
                    AutomationProperties.HelpText="{x:Bind Model.Text.Get('trackers', 'next_hint')}"
                  />
                </table:Column.Header>
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Tracker">
                    <TextBlock
                      Text="{x:Bind NextText, Mode=OneWay}"
                      VerticalAlignment="Center"
                      ToolTipService.ToolTip="{x:Bind NextHint, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind NextHint, Mode=OneWay}"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
              <table:Column x:Name="MessageColumn" Id="message" Width="280">
                <table:Column.CellTemplate>
                  <DataTemplate x:DataType="torrents:Tracker">
                    <TextBlock
                      Text="{x:Bind Message, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind StatusHint, Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind StatusHint, Mode=OneWay}"
                      VerticalAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                    />
                  </DataTemplate>
                </table:Column.CellTemplate>
              </table:Column>
            </table:Table.Columns>
          </table:Table>
          <Grid
            x:Name="TrackerEditor"
            Margin="16,12"
            Grid.RowSpan="2"
            RowSpacing="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{x:Bind Model.IsEditingTrackers, Mode=OneWay}"
          >
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox
              x:Name="TrackerInput"
              Grid.Row="1"
              Text="{x:Bind Model.TrackerInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              AcceptsReturn="True"
              TextWrapping="NoWrap"
              FlowDirection="LeftToRight"
              ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'hint')}"
              AutomationProperties.HelpText="{x:Bind Model.Text.Get('trackers', 'hint')}"
            />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:ActionButton
                Glyph="{x:Bind icons:Lucide.Save}"
                ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'save_tip')}"
                x:Name="SaveTrackers"
                Text="{x:Bind Model.Text.Get('trackers', 'save')}"
                IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
              />
              <controls:ActionButton
                Glyph="{x:Bind icons:Lucide.X}"
                x:Name="CancelTrackers"
                Text="{x:Bind Model.Text.Get('add', 'cancel')}"
                Command="{x:Bind Model.CancelTrackers}"
              />
            </StackPanel>
          </Grid>
        </Grid>
        <torrents:SpeedGraph
          x:Name="Speed"
          x:Load="False"
          Margin="16,12"
          Visibility="Collapsed"
          Samples="{x:Bind Model.History, Mode=OneWay}"
        />
        <torrents:PiecesMap x:Name="Map" x:Load="False" Margin="16,12" Visibility="Collapsed" />
        <StackPanel
          x:Name="EmptyState"
          Margin="16,12"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="12"
          Visibility="Collapsed"
        >
          <FontIcon
            FontFamily="{x:Bind icons:Lucide.Font}"
            Glyph="{x:Bind icons:Lucide.SquareDashedMousePointer}"
            FontSize="{StaticResource TinyTorrentLargeIconSize}"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            AutomationProperties.AccessibilityView="Raw"
          />
          <TextBlock
            x:Name="EmptyText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
          />
        </StackPanel>
      </Grid>
      <InfoBar
        x:Name="FailureBar"
        Margin="16,12"
        VerticalAlignment="Bottom"
        IsClosable="False"
        Severity="Error"
        IsOpen="{x:Bind Model.HasError, Mode=OneWay}"
        Message="{x:Bind Model.Message, Mode=OneWay}"
      >
        <InfoBar.ActionButton>
          <controls:ActionButton
            Glyph="{x:Bind icons:Lucide.RotateCw}"
            ToolTipService.ToolTip="{x:Bind Model.RetryToolTip, Mode=OneWay}"
            x:Name="Retry"
            Text="{x:Bind Model.Text.Get('inspector', 'retry')}"
            Command="{x:Bind Model.Retry}"
          />
        </InfoBar.ActionButton>
      </InfoBar>
    </Grid>
  </controls:Pane>
</UserControl>
