<UserControl x:Class="Syno.TinyTorrent.FileBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syno.TinyTorrent">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Model.Summary, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <TextBox x:Name="Search" Grid.Column="1" Text="{x:Bind Model.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Name="All" Grid.Column="2" Click="OnAll" />
            <Button x:Name="None" Grid.Column="3" Click="OnNone" />
        </Grid>
        <TreeView Grid.Row="1" ItemsSource="{x:Bind Model.Roots, Mode=OneWay}" SelectionMode="None" CanDragItems="False" CanReorderItems="False">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="local:FileNode">
                    <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="True" HorizontalContentAlignment="Stretch">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="84" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind Wanted, Mode=TwoWay}" AutomationProperties.HelpText="{x:Bind Path}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" />
                            <ComboBox Grid.Column="2" SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                                <ComboBoxItem Content="{x:Bind Unchanged, Mode=OneWay}" Visibility="{x:Bind IsFolder}" />
                                <ComboBoxItem Content="{x:Bind Skip, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Low, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind Normal, Mode=OneWay}" />
                                <ComboBoxItem Content="{x:Bind High, Mode=OneWay}" />
                            </ComboBox>
                        </Grid>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
