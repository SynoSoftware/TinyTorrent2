                        </controls:SettingsRow>
                        <controls:SettingsRow
                          Header="{x:Bind Model.ActiveChecking.Label, Mode=OneWay}"
                          Error="{x:Bind Model.ActiveChecking.Message, Mode=OneWay}"
                          Description="{x:Bind Model.Text.Get('settings', 'active_checking_hint'), Mode=OneWay}"
                        >
                          <TextBox
                            InputScope="Number"
                            Width="160"
                            Tag="{x:Bind Model.ActiveChecking}"
                            Text="{x:Bind Model.ActiveChecking.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind Model.ActiveChecking.CanEdit, Mode=OneWay}"
                            Loaded="OnTextLoaded"
                            PreviewKeyDown="OnFieldKey"
                            LostFocus="OnFieldDeparture"
                            AutomationProperties.Name="{x:Bind Model.ActiveChecking.Label, Mode=OneWay}"
                            AutomationProperties.AutomationId="ActiveChecking"
                          />
                        </controls:SettingsRow>
                        <controls:SettingsRow
                          IsAdvanced="True"
                          Header="{x:Bind Model.RecheckFinished.Label, Mode=OneWay}"
                          Error="{x:Bind Model.RecheckFinished.Message, Mode=OneWay}"
                          Description="{x:Bind Model.Text.Get('settings', 'recheck_finished_hint'), Mode=OneWay}"
                          StateText="{x:Bind controls:SettingsRow.State(Model.RecheckFinished.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                        >
                          <ToggleSwitch
                            Tag="{x:Bind Model.RecheckFinished}"
                            IsOn="{x:Bind Model.RecheckFinished.IsOn, Mode=OneWay}"
                            IsEnabled="{x:Bind Model.RecheckFinished.CanEdit, Mode=OneWay}"
                            Toggled="OnToggle"
                            AutomationProperties.Name="{x:Bind Model.RecheckFinished.Label, Mode=OneWay}"
                            AutomationProperties.AutomationId="RecheckFinished"
                          />
                        </controls:SettingsRow>
                      </StackPanel>
                    </controls:SettingsSection>
                    <controls:SettingsSection
                      Header="{x:Bind Model.Text.Get('settings', 'speed_history'), Mode=OneWay}"
                      Summary="{x:Bind Model.HistorySummary, Mode=OneWay}"
                      Glyph="{x:Bind icons:Lucide.ChartLine}"
                    >
                      <StackPanel>
                        <controls:SettingsRow
                          Header="{x:Bind Model.RecentInterval.Label, Mode=OneWay}"
                          Description="{x:Bind Model.Text.Get('settings', 'recent_interval_hint'), Mode=OneWay}"
                          Error="{x:Bind Model.RecentInterval.Message, Mode=OneWay}"
                          Unit="{x:Bind Model.Text.Get('settings', 'seconds_unit'), Mode=OneWay}"
                        >
                          <ComboBox
                            Width="160"
                            Tag="{x:Bind Model.RecentInterval}"
                            SelectedValuePath="Tag"
                            SelectedValue="{x:Bind Model.RecentInterval.SelectedValue, Mode=OneWay}"
                            SelectionChanged="OnSelection"
                            IsEnabled="{x:Bind Model.RecentInterval.CanEdit, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Model.RecentInterval.Label, Mode=OneWay}"
                            AutomationProperties.AutomationId="RecentInterval"
                          >
                            <ComboBoxItem Tag="1" Content="1" />
                            <ComboBoxItem Tag="5" Content="5" />
                            <ComboBoxItem Tag="10" Content="10" />
                          </ComboBox>
                        </controls:SettingsRow>
                        <controls:SettingsRow
                          Header="{x:Bind Model.HistoryInterval.Label, Mode=OneWay}"
                          Description="{x:Bind Model.Text.Get('settings', 'history_interval_hint'), Mode=OneWay}"
                          Error="{x:Bind Model.HistoryInterval.Message, Mode=OneWay}"
                          Unit="{x:Bind Model.Text.Get('settings', 'seconds_unit'), Mode=OneWay}"
                        >
                          <ComboBox
                            Width="160"
                            Tag="{x:Bind Model.HistoryInterval}"
                            SelectedValuePath="Tag"
                            SelectedValue="{x:Bind Model.HistoryInterval.SelectedValue, Mode=OneWay}"
                            SelectionChanged="OnSelection"
                            IsEnabled="{x:Bind Model.HistoryInterval.CanEdit, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Model.HistoryInterval.Label, Mode=OneWay}"
                            AutomationProperties.AutomationId="HistoryInterval"
                          >
                            <ComboBoxItem Tag="10" Content="10" />
                            <ComboBoxItem Tag="30" Content="30" />
                            <ComboBoxItem Tag="60" Content="60" />
                            <ComboBoxItem Tag="300" Content="300" />
                          </ComboBox>
                        </controls:SettingsRow>
                      </StackPanel>
                    </controls:SettingsSection>
                  </StackPanel>
                  <StackPanel x:Name="Appearance" x:Load="False" Spacing="8" Visibility="Collapsed">
                    <controls:SettingsSection
                      Header="{x:Bind Model.Text.Get('settings', 'personalization'), Mode=OneWay}"
                      Style="{StaticResource TinyTorrentSettingsGroupStyle}"
                      Glyph="{x:Bind icons:Lucide.Palette}"
                    >
                      <StackPanel>
                        <controls:SettingsRow
                          Header="{x:Bind Model.Text.Get('settings', 'theme'), Mode=OneWay}"
                          Error="{x:Bind Model.Theme.Message, Mode=OneWay}"
                        >
                          <controls:SettingsRow.Detail>
                            <ContentControl
                              x:Name="ThemeContent"
                              IsTabStop="False"
                              HorizontalContentAlignment="Stretch"
                            />
                          </controls:SettingsRow.Detail>
                        </controls:SettingsRow>
                        <controls:SettingsRow
                          Header="{x:Bind Model.Text.Get('settings', 'language'), Mode=OneWay}"
                          Error="{x:Bind Model.Language.Message, Mode=OneWay}"
                        >
                          <ComboBox
                            x:Name="Languages"
                            Width="260"
                            ItemsSource="{x:Bind LanguageItems}"
                            SelectedValuePath="Tag"
                            SelectedValue="{x:Bind Model.ChosenLanguage, Mode=OneWay}"
                            SelectionChanged="OnLanguage"
                            IsEnabled="{x:Bind Model.CanSelectLanguage, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'language'), Mode=OneWay}"
                            AutomationProperties.AutomationId="Language"
                          />
                        </controls:SettingsRow>
                      </StackPanel>
                    </controls:SettingsSection>
                    <Border Style="{StaticResource TinyTorrentSettingsCardStyle}">
                      <controls:SettingsRow
                        Header="{x:Bind Model.ShowFreeSpace.Label, Mode=OneWay}"
                        Description="{x:Bind Model.Text.Get('settings', 'free_space_hint'), Mode=OneWay}"
                        BorderThickness="0"
                        Error="{x:Bind Model.ShowFreeSpace.Message, Mode=OneWay}"
                        StateText="{x:Bind controls:SettingsRow.State(Model.ShowFreeSpace.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                      >
                        <ToggleSwitch
                          Tag="{x:Bind Model.ShowFreeSpace}"
                          IsOn="{x:Bind Model.ShowFreeSpace.IsOn, Mode=OneWay}"
                          IsEnabled="{x:Bind Model.ShowFreeSpace.CanEdit, Mode=OneWay}"
                          Toggled="OnToggle"
                          AutomationProperties.Name="{x:Bind Model.ShowFreeSpace.Label, Mode=OneWay}"
                          AutomationProperties.AutomationId="ShowFreeSpace"
                        />
                      </controls:SettingsRow>
                    </Border>
                    <Border
                      Style="{StaticResource TinyTorrentSettingsCardStyle}"
                      Visibility="{x:Bind ExternalIp.Visibility, Mode=OneWay}"
                    >
                      <controls:SettingsRow
                        x:Name="ExternalIp"
                        IsAdvanced="True"
                        Header="{x:Bind Model.ShowExternalIp.Label, Mode=OneWay}"
                        BorderThickness="0"
                        Error="{x:Bind Model.ShowExternalIp.Message, Mode=OneWay}"
                        Description="{x:Bind Model.Text.Get('settings', 'external_ip_hint'), Mode=OneWay}"
                        StateText="{x:Bind controls:SettingsRow.State(Model.ShowExternalIp.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                      >
                        <ToggleSwitch
                          Tag="{x:Bind Model.ShowExternalIp}"
                          IsOn="{x:Bind Model.ShowExternalIp.IsOn, Mode=OneWay}"
                          IsEnabled="{x:Bind Model.ShowExternalIp.CanEdit, Mode=OneWay}"
                          Toggled="OnToggle"
                          AutomationProperties.Name="{x:Bind Model.ShowExternalIp.Label, Mode=OneWay}"
                          AutomationProperties.AutomationId="ShowExternalIp"
                        />
                      </controls:SettingsRow>
                    </Border>
                    <Border
                      Style="{StaticResource TinyTorrentSettingsCardStyle}"
                      Visibility="{x:Bind MemoryUsage.Visibility, Mode=OneWay}"
                    >
                      <controls:SettingsRow
                        x:Name="MemoryUsage"
                        IsAdvanced="True"
                        Header="{x:Bind Model.ShowMemory.Label, Mode=OneWay}"
                        BorderThickness="0"
                        Error="{x:Bind Model.ShowMemory.Message, Mode=OneWay}"
                        Description="{x:Bind Model.Text.Get('settings', 'memory_usage_hint'), Mode=OneWay}"
                        StateText="{x:Bind controls:SettingsRow.State(Model.ShowMemory.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                      >
                        <ToggleSwitch
                          Tag="{x:Bind Model.ShowMemory}"
                          IsOn="{x:Bind Model.ShowMemory.IsOn, Mode=OneWay}"
                          IsEnabled="{x:Bind Model.ShowMemory.CanEdit, Mode=OneWay}"
                          Toggled="OnToggle"
                          AutomationProperties.Name="{x:Bind Model.ShowMemory.Label, Mode=OneWay}"
                          AutomationProperties.AutomationId="ShowMemory"
                        />
                      </controls:SettingsRow>
                    </Border>
                    <Border Style="{StaticResource TinyTorrentSettingsCardStyle}">
                      <controls:SettingsRow
                        Header="{x:Bind Model.ShowTitleSpeeds.Label, Mode=OneWay}"
                        Description="{x:Bind Model.Text.Get('settings', 'title_speeds_hint'), Mode=OneWay}"
                        BorderThickness="0"
                        Error="{x:Bind Model.ShowTitleSpeeds.Message, Mode=OneWay}"
                        StateText="{x:Bind controls:SettingsRow.State(Model.ShowTitleSpeeds.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                      >
                        <ToggleSwitch
                          Tag="{x:Bind Model.ShowTitleSpeeds}"
                          IsOn="{x:Bind Model.ShowTitleSpeeds.IsOn, Mode=OneWay}"
                          IsEnabled="{x:Bind Model.ShowTitleSpeeds.CanEdit, Mode=OneWay}"
                          Toggled="OnToggle"
                          AutomationProperties.Name="{x:Bind Model.ShowTitleSpeeds.Label, Mode=OneWay}"
                          AutomationProperties.AutomationId="ShowTitleSpeeds"
                        />
                      </controls:SettingsRow>
                    </Border>
                  </StackPanel>
                </Grid>
                <Canvas IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                  <Border
                    x:Name="DestinationOutline"
                    Visibility="Collapsed"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                  />
                </Canvas>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Grid>
        <ContentControl
          x:Name="ChildContent"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          Visibility="Collapsed"
        />
      </Grid>
    </NavigationView>
  </Grid>
</UserControl>
