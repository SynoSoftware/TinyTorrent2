<UserControl
  x:Class="Syno.TinyTorrent.Settings.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shared="using:Syno.TinyTorrent.Shared"
  xmlns:icons="using:Syno"
  xmlns:local="using:Syno.TinyTorrent.Settings"
  xmlns:app="using:Syno.TinyTorrent"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <x:Double x:Key="SettingsMarkOpacity">0.04</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <x:Double x:Key="SettingsMarkOpacity">0.03</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <x:Double x:Key="SettingsMarkOpacity">0</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="SettingsMarkStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="320" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorSecondaryBrush}" />
        <Setter Property="Opacity" Value="{ThemeResource SettingsMarkOpacity}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>
      <Style
        x:Key="SettingsHomeLinkStyle"
        TargetType="Button"
        BasedOn="{StaticResource TinyTorrentSettingsLinkStyle}"
      >
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style
        x:Key="SettingsHomeGroupStyle"
        TargetType="controls:SettingsSection"
        BasedOn="{StaticResource TinyTorrentSettingsGroupStyle}"
      >
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:SettingsSection">
              <Border
                x:Name="Card"
                Style="{StaticResource TinyTorrentSettingsCardStyle}"
                Padding="0"
              >
                <StackPanel>
                  <Border
                    Padding="16"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                  >
                    <TextBlock
                      Text="{TemplateBinding Header}"
                      Style="{StaticResource SubtitleTextBlockStyle}"
                      TextTrimming="CharacterEllipsis"
                      ToolTipService.ToolTip="{TemplateBinding Header}"
                      AutomationProperties.HeadingLevel="Level2"
                    />
                  </Border>
                  <ContentPresenter
                    Content="{TemplateBinding Content}"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="Stretch"
                  />
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="Root">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="HeaderHome">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsHome(Model.Overview.Category), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.HeadingLevel" Value="Level1" />
            <Setter Target="PageHeader.Artwork">
              <Setter.Value>
                <SvgImageSource UriSource="ms-appx:///Assets/tinyTorrent.svg" />
              </Setter.Value>
            </Setter>
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.Clock}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.History}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="HeaderGeneral">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsCategory(Model.Overview.Category, app:SettingsCategory.General), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.Artwork" Value="ms-appx:///Assets/Settings/general.png" />
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.File}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.Power}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="HeaderTransfers">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsCategory(Model.Overview.Category, app:SettingsCategory.Transfers), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.Artwork" Value="ms-appx:///Assets/Settings/transfers.png" />
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.ListOrdered}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.Upload}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="HeaderLimits">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsCategory(Model.Overview.Category, app:SettingsCategory.Limits), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.Artwork" Value="ms-appx:///Assets/Settings/speed.png" />
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.Gauge}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.Gauge}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="HeaderSchedule">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsCategory(Model.Overview.Category, app:SettingsCategory.Schedule), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.Artwork" Value="ms-appx:///Assets/Settings/schedule.png" />
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.SlidersHorizontal}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.CalendarClock}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="HeaderAppearance">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsCategory(Model.Overview.Category, app:SettingsCategory.Appearance), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.Artwork" Value="ms-appx:///Assets/Settings/appearance.png" />
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.Palette}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.Languages}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="HeaderNetwork">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsCategory(Model.Overview.Category, app:SettingsCategory.Network), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.Artwork" Value="ms-appx:///Assets/Settings/network.png" />
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.Globe}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.Shield}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="HeaderPlugins">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsCategory(Model.Overview.Category, app:SettingsCategory.Plugins), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.Artwork" Value="ms-appx:///Assets/Settings/plugins.png" />
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.Film}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.Captions}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="HeaderAdvanced">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:SettingsPage.IsCategory(Model.Overview.Category, app:SettingsCategory.Advanced), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageHeader.Artwork" Value="ms-appx:///Assets/Settings/advanced.png" />
            <Setter Target="FirstFact.Glyph" Value="{x:Bind icons:Lucide.Check}" />
            <Setter Target="SecondFact.Glyph" Value="{x:Bind icons:Lucide.History}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <!-- Owner ruling: the page shows the window's acrylic and keeps the two
             gear marks. See Settings in docs/contracts/ui.md. -->
    <FontIcon
      Style="{StaticResource SettingsMarkStyle}"
      FontFamily="{x:Bind icons:Lucide.Font}"
      Glyph="{x:Bind icons:Lucide.Cog}"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Margin="-120,-100,0,0"
    />
    <FontIcon
      Style="{StaticResource SettingsMarkStyle}"
      FontFamily="{x:Bind icons:Lucide.Font}"
      Glyph="{x:Bind icons:Lucide.Cog}"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Margin="0,0,-160,-140"
    />
    <NavigationView
      x:Name="Categories"
      PaneDisplayMode="Auto"
      OpenPaneLength="264"
      CompactPaneLength="64"
      CompactModeThresholdWidth="0"
      ExpandedModeThresholdWidth="1100"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="False"
      IsSettingsVisible="False"
      IsPaneOpen="True"
      SelectionChanged="OnCategory"
      AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'categories'), Mode=OneWay}"
      AutomationProperties.AutomationId="SettingsCategories"
    >
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <StaticResource
          x:Key="NavigationViewItemOnLeftIconBoxHeight"
          ResourceKey="TinyTorrentSurfaceIconSize"
        />
      </NavigationView.Resources>
      <NavigationView.PaneHeader>
        <Button
          x:Name="Brand"
          Command="{x:Bind Main.ReturnWorkspace, Mode=OneWay}"
          Style="{StaticResource DefaultButtonStyle}"
          Margin="8,16,8,24"
          Padding="0"
          MinWidth="0"
          HorizontalAlignment="Stretch"
          Background="{ThemeResource SubtleFillColorTransparentBrush}"
          BorderThickness="0"
          HorizontalContentAlignment="Left"
          AutomationProperties.AutomationId="SettingsBrand"
          AutomationProperties.Name="{x:Bind Main.ReturnText, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Main.ReturnText, Mode=OneWay}"
        >
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Image x:Name="Logo" Source="ms-appx:///Assets/tinyTorrent.svg" Width="40" Height="40" />
            <TextBlock
              Text="TinyTorrent"
              Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
              VerticalAlignment="Center"
              Visibility="{x:Bind Categories.IsPaneOpen, Mode=OneWay}"
            />
          </StackPanel>
        </Button>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem
          x:Name="HomeCategory"
          Tag="Home"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'home'), Mode=OneWay}"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'home'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="GeneralCategory"
          Tag="General"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'general'), Mode=OneWay}"
          AutomationProperties.AutomationId="GeneralCategory"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'general'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="TransfersCategory"
          Tag="Transfers"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'transfers'), Mode=OneWay}"
          AutomationProperties.AutomationId="TransfersCategory"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'transfers'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="LimitsCategory"
          Tag="Limits"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'limits'), Mode=OneWay}"
          AutomationProperties.AutomationId="LimitsCategory"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'limits'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="ScheduleCategory"
          Tag="Schedule"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'schedule'), Mode=OneWay}"
          AutomationProperties.AutomationId="ScheduleCategory"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'schedule'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="AppearanceCategory"
          Tag="Appearance"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'appearance'), Mode=OneWay}"
          AutomationProperties.AutomationId="AppearanceCategory"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'appearance'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="NetworkCategory"
          Tag="Network"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'network'), Mode=OneWay}"
          AutomationProperties.AutomationId="NetworkCategory"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'network'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="PluginsCategory"
          Tag="Plugins"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'plugins'), Mode=OneWay}"
          AutomationProperties.AutomationId="PluginsCategory"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'plugins'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="AdvancedCategory"
          Tag="Advanced"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'advanced'), Mode=OneWay}"
          AutomationProperties.AutomationId="AdvancedCategory"
        >
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'advanced'), Mode=OneWay}" Style="{StaticResource TinyTorrentNavigationTextStyle}" />
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem
          x:Name="AdvancedMode"
          SelectsOnInvoked="False"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'show_advanced'), Mode=OneWay}"
          AutomationProperties.AutomationId="AdvancedMode"
        >
          <NavigationViewItem.Content>
            <TextBlock
              Text="{x:Bind Model.Text.Get('settings', 'show_advanced'), Mode=OneWay}"
              Style="{StaticResource TinyTorrentNavigationTextStyle}"
            />
          </NavigationViewItem.Content>
          <NavigationViewItem.Icon>
            <FontIcon
              x:Name="AdvancedModeIcon"
              FontFamily="{x:Bind icons:Lucide.Font}"
              FontSize="{StaticResource NavigationViewItemOnLeftIconBoxHeight}"
            />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem
          x:Name="ReturnWorkspace"
          SelectsOnInvoked="False"
          AutomationProperties.Name="{x:Bind Main.ReturnText, Mode=OneWay}"
          AutomationProperties.AutomationId="ReturnWorkspace"
        >
          <NavigationViewItem.Content>
            <TextBlock
              Text="{x:Bind Main.ReturnText, Mode=OneWay}"
              Style="{StaticResource TinyTorrentNavigationTextStyle}"
            />
          </NavigationViewItem.Content>
          <NavigationViewItem.Icon>
            <FontIcon
              FontFamily="{x:Bind icons:Lucide.Font}"
              Glyph="{x:Bind icons:Lucide.ArrowLeft}"
              FontSize="{StaticResource NavigationViewItemOnLeftIconBoxHeight}"
            />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid x:Name="PageHost">
        <Grid x:Name="PageContent" Margin="0,16,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <local:Header
            x:Name="PageHeader"
            Margin="24,0,24,24"
            MaxWidth="{StaticResource TinyTorrentSettingsWidth}"
            PageTitle="{x:Bind Model.Overview.PageTitle, Mode=OneWay}"
            Title="{x:Bind Model.Overview.Title, Mode=OneWay}"
            Subtitle="{x:Bind Model.Overview.Subtitle, Mode=OneWay}"
          >
            <local:Header.First>
              <local:Fact
                x:Name="FirstFact"
                Label="{x:Bind Model.Overview.FirstLabel, Mode=OneWay}"
                Value="{x:Bind Model.Overview.FirstValue, Mode=OneWay}"
                ShowsTransfers="{x:Bind Model.Overview.ShowsFirstTransfers, Mode=OneWay}"
                Download="{x:Bind Model.Overview.FirstDownload, Mode=OneWay}"
                Upload="{x:Bind Model.Overview.FirstUpload, Mode=OneWay}"
                Total="{x:Bind Model.Overview.FirstTotal, Mode=OneWay}"
                Text="{x:Bind Model.Text}"
              />
            </local:Header.First>
            <local:Header.Second>
              <local:Fact
                x:Name="SecondFact"
                Label="{x:Bind Model.Overview.SecondLabel, Mode=OneWay}"
                Value="{x:Bind Model.Overview.SecondValue, Mode=OneWay}"
                ShowsTransfers="{x:Bind Model.Overview.ShowsSecondTransfers, Mode=OneWay}"
                Download="{x:Bind Model.Overview.SecondDownload, Mode=OneWay}"
                Upload="{x:Bind Model.Overview.SecondUpload, Mode=OneWay}"
                Text="{x:Bind Model.Text}"
              />
            </local:Header.Second>
          </local:Header>
          <ScrollViewer
            x:Name="Body"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
          >
            <Grid Margin="24,8,24,32">
              <Grid x:Name="BodyContent" MaxWidth="{StaticResource TinyTorrentSettingsWidth}">
                <StackPanel x:Name="IndexContent" x:Load="False" Spacing="24">
                  <Grid x:Name="HomeGrid" ColumnSpacing="8" RowSpacing="8" SizeChanged="OnHomeSize">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                      <controls:SettingsSection
                        Header="{x:Bind Model.Text.Get('settings', 'home_downloads'), Mode=OneWay}"
                        Style="{StaticResource SettingsHomeGroupStyle}"
                      >
                        <StackPanel x:Name="HomeDownloads" />
                      </controls:SettingsSection>
                      <controls:SettingsSection
                        Header="{x:Bind Model.Text.Get('settings', 'appearance'), Mode=OneWay}"
                        Style="{StaticResource SettingsHomeGroupStyle}"
                      >
                        <StackPanel>
                          <StackPanel Spacing="8" Margin="16">
                            <TextBlock Text="{x:Bind Model.Text.Get('settings', 'theme'), Mode=OneWay}" />
                            <ContentControl
                              x:Name="HomeThemeContent"
                              HorizontalContentAlignment="Stretch"
                              IsTabStop="False"
                            />
                          </StackPanel>
                          <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                          >
                            <StackPanel x:Name="HomeAppearance" />
                          </Border>
                        </StackPanel>
                      </controls:SettingsSection>
                      <ContentControl
                        x:Name="HomeIntegrationContent"
                        HorizontalContentAlignment="Stretch"
                        IsTabStop="False"
                      />
                    </StackPanel>
                    <StackPanel x:Name="HomeRight" Grid.Column="1" Spacing="8">
                      <controls:SettingsSection
                        Header="{x:Bind Model.Text.Get('settings', 'plugins'), Mode=OneWay}"
                        Style="{StaticResource SettingsHomeGroupStyle}"
                      >
                        <StackPanel x:Name="HomeLibrary" />
                      </controls:SettingsSection>
                      <controls:SettingsSection
                        Header="{x:Bind Model.Text.Get('settings', 'network'), Mode=OneWay}"
                        Style="{StaticResource SettingsHomeGroupStyle}"
                      >
                        <StackPanel x:Name="HomeNetwork" />
                      </controls:SettingsSection>
                      <controls:SettingsSection
                        Header="{x:Bind Model.Text.Get('settings', 'schedule'), Mode=OneWay}"
                        Style="{StaticResource SettingsHomeGroupStyle}"
                      >
                        <StackPanel x:Name="HomeSchedule" />
                      </controls:SettingsSection>
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <Grid x:Name="CategoryContent">
                  <StackPanel x:Name="Plugins" x:Load="False" Spacing="24" Visibility="Collapsed">
                    <controls:SettingsSection
                      Header="{x:Bind Model.Text.Get('settings', 'video_information'), Mode=OneWay}"
                      Glyph="{x:Bind icons:Lucide.Film}"
                      Style="{StaticResource TinyTorrentSettingsGroupStyle}"
                    >
                      <StackPanel>
                        <controls:SettingsRow
                          x:Name="InformationRow"
                          Header="{x:Bind Model.Text.Get('library', 'provider'), Mode=OneWay}"
                        >
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                              x:Name="ProviderInformation"
                              Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                              Click="OnProviderInformation"
                              IsEnabled="{x:Bind Main.Library.HasProvider, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Model.Text.Get('library', 'provider_information'), Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind Model.Text.Get('library', 'provider_information'), Mode=OneWay}"
                            >
                              <FontIcon
                                FontFamily="{x:Bind icons:Lucide.Font}"
                                Glyph="{x:Bind icons:Lucide.Info}"
                                FontSize="{StaticResource TinyTorrentButtonIconSize}"
                              />
                            </Button>
                            <Button
                              x:Name="ProviderKey"
                              Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                              Click="OnProviderKey"
                              Visibility="{x:Bind Main.Library.UsesKey, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Model.Text.Get('library', 'key_tip'), Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind Model.Text.Get('account', 'api_key'), Mode=OneWay}"
                              AutomationProperties.AutomationId="ProviderKey"
                            >
                              <FontIcon
                                FontFamily="{x:Bind icons:Lucide.Font}"
                                Glyph="{x:Bind icons:Lucide.KeyRound}"
                                FontSize="{StaticResource TinyTorrentButtonIconSize}"
                              />
                            </Button>
                            <ComboBox
                              x:Name="ProviderChoice"
                              Width="260"
                              ItemsSource="{x:Bind Main.Library.ProviderNames, Mode=OneWay}"
                              SelectedIndex="{x:Bind Main.Library.ProviderIndex, Mode=OneWay}"
                              SelectionChanged="OnProvider"
                              IsEnabled="{x:Bind Main.Library.IsAvailable, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Model.Text.Get('library', 'information_tip'), Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind Model.Text.Get('library', 'provider'), Mode=OneWay}"
                              AutomationProperties.AutomationId="VideoProvider"
                            />
                          </StackPanel>
                        </controls:SettingsRow>
                        <controls:SettingsRow
                          Header="{x:Bind Model.Text.Get('plugins', 'automatic_download'), Mode=OneWay}"
                          Description="{x:Bind Model.Text.Get('plugins', 'automatic_download_hint'), Mode=OneWay}"
                          StateText="{x:Bind controls:SettingsRow.State(AutomaticDownload.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                        >
                          <ToggleSwitch
                            x:Name="AutomaticDownload"
                            IsOn="{x:Bind Main.Library.AutomaticDownload, Mode=OneWay}"
                            IsEnabled="{x:Bind Main.Library.IsAvailable, Mode=OneWay}"
                            Toggled="OnAutomaticDownload"
                            AutomationProperties.Name="{x:Bind Main.Library.DownloadLabel, Mode=OneWay}"
                            AutomationProperties.AutomationId="VideoAutomaticDownload"
                          />
                        </controls:SettingsRow>
                        <shared:DatasetRow x:Name="ImdbRow" />
                        <controls:SettingsRow
                          Header="{x:Bind Model.Text.Get('plugins', 'movies_with_information'), Mode=OneWay}"
                          BorderThickness="0"
                        >
                          <TextBlock
                            x:Name="VideoCoverage"
                            Text="{x:Bind Model.VideoCoverage, Mode=OneWay}"
                            Style="{StaticResource TinyTorrentTitleDetailTextStyle}"
                          />
                        </controls:SettingsRow>
                      </StackPanel>
                    </controls:SettingsSection>
                    <ContentControl
                      x:Name="SubtitlesContent"
                      HorizontalContentAlignment="Stretch"
                    />
                    <controls:SettingsSection
                      Header="{x:Bind Model.Text.Get('request_protection', 'title'), Mode=OneWay}"
                      Style="{StaticResource TinyTorrentSettingsGroupStyle}"
                    >
                      <StackPanel>
                        <controls:SettingsRow
                          x:Name="LookupsRow"
                          Error="{x:Bind Model.LookupLimit.Message, Mode=OneWay}"
                          Header="{x:Bind Model.Text.Get('plugins', 'lookups'), Mode=OneWay}"
                          Description="{x:Bind Model.Text.Get('plugins', 'lookups_hint'), Mode=OneWay}"
                          Unit="{x:Bind Model.Text.Get('plugins', 'lookup_scope'), Mode=OneWay}"
                        >
                          <TextBox
                            x:Name="LookupLimit"
                            InputScope="Number"
                            Width="160"
                            Tag="{x:Bind Model.LookupLimit}"
                            Text="{x:Bind Model.LookupLimit.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind Model.LookupLimit.CanEdit, Mode=OneWay}"
                            Loaded="OnTextLoaded"
                            PreviewKeyDown="OnFieldKey"
                            LostFocus="OnFieldDeparture"
                            ToolTipService.ToolTip="{x:Bind Model.Text.Get('plugins', 'lookups_hint'), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind Model.Text.Get('plugins', 'lookups'), Mode=OneWay}"
                            AutomationProperties.AutomationId="LookupLimit"
                          />
                        </controls:SettingsRow>
                        <controls:SettingsRow
                          BorderThickness="0"
                          Header="{x:Bind Model.Text.Get('request_protection', 'reset'), Mode=OneWay}"
