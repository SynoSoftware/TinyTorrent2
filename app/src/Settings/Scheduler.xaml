<UserControl
  x:Class="Syno.TinyTorrent.Settings.Scheduler"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Controls"
  xmlns:icons="using:Syno"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <Style x:Key="SchedulerSwatchStyle" TargetType="Border">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel Spacing="24">
    <Border
      x:Name="WeekCard"
      Style="{StaticResource TinyTorrentSettingsCardStyle}"
      Padding="16"
      SizeChanged="OnMapSize"
    >
      <StackPanel Spacing="16">
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Text="{x:Bind Model.Text.Get('settings', 'weekly_schedule'), Mode=OneWay}"
            Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'weekly_schedule'), Mode=OneWay}"
          />
          <ContentControl x:Name="Mode" Grid.Column="1" IsTabStop="False" />
        </Grid>
        <ContentControl
          x:Name="Timeline"
          HorizontalContentAlignment="Stretch"
          IsTabStop="False"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'weekly_schedule'), Mode=OneWay}"
        />
        <Grid
          ColumnSpacing="24"
          MaxWidth="640"
          HorizontalAlignment="Left"
          Visibility="{x:Bind Model.FollowsSchedule, Mode=OneWay}"
        >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid ColumnSpacing="8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
              Style="{StaticResource SchedulerSwatchStyle}"
              Background="{ThemeResource ControlFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            />
            <TextBlock
              Grid.Column="1"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'speed'), Mode=OneWay}"
              Text="{x:Bind Model.Text.Get('settings', 'speed'), Mode=OneWay}"
              Style="{StaticResource TinyTorrentStatusTextStyle}"
            />
          </Grid>
          <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
              Style="{StaticResource SchedulerSwatchStyle}"
              Background="{ThemeResource TinyTorrentAlternativeBrush}"
              BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            />
            <TextBlock
              Grid.Column="1"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'alternative'), Mode=OneWay}"
              Text="{x:Bind Model.Text.Get('settings', 'alternative'), Mode=OneWay}"
              Style="{StaticResource TinyTorrentStatusTextStyle}"
            />
          </Grid>
          <Grid Grid.Column="2" ColumnSpacing="8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
              Style="{StaticResource SchedulerSwatchStyle}"
              Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
              BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            />
            <TextBlock
              Grid.Column="1"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'paused'), Mode=OneWay}"
              Text="{x:Bind Model.Text.Get('settings', 'paused'), Mode=OneWay}"
              Style="{StaticResource TinyTorrentStatusTextStyle}"
            />
          </Grid>
          <TextBlock
            x:Name="Now"
            Grid.Column="3"
            VerticalAlignment="Center"
            Style="{StaticResource TinyTorrentStatusTextStyle}"
            TextTrimming="CharacterEllipsis"
          />
        </Grid>
        <TextBlock
          Text="{x:Bind Model.TimelineHint, Mode=OneWay}"
          Style="{StaticResource TinyTorrentTitleDetailTextStyle}"
          TextTrimming="CharacterEllipsis"
          ToolTipService.ToolTip="{x:Bind Model.TimelineHint, Mode=OneWay}"
        />
      </StackPanel>
    </Border>
    <StackPanel Spacing="8" Visibility="{x:Bind Model.FollowsSchedule, Mode=OneWay}">
      <local:SettingsRow
        x:Name="PeriodsRow"
        Header="{x:Bind Model.Text.Get('settings', 'periods'), Mode=OneWay}"
        Error="{x:Bind Model.PeriodsMessage, Mode=OneWay}"
        BorderThickness="0"
      >
        <StackPanel Orientation="Horizontal" Spacing="12">
          <local:ActionButton
            x:Name="AddPeriod"
            Glyph="{x:Bind icons:Lucide.Plus}"
            IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
            Text="{x:Bind Model.Text.Get('settings', 'add_period'), Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'add_period_tip'), Mode=OneWay}"
            Click="OnAdd"
            AutomationProperties.AutomationId="AddPeriod"
          />
        </StackPanel>
      </local:SettingsRow>
      <TextBlock
        Text="{x:Bind Model.Text.Get('settings', 'schedule_hint'), Mode=OneWay}"
        Style="{StaticResource TinyTorrentTitleDetailTextStyle}"
        TextTrimming="CharacterEllipsis"
        ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'schedule_hint'), Mode=OneWay}"
      />
      <StackPanel x:Name="Periods" Spacing="8" />
    </StackPanel>
  </StackPanel>
</UserControl>
