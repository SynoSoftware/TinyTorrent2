<UserControl
  x:Class="Syno.TinyTorrent.Settings.Header"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Settings"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  HorizontalContentAlignment="Stretch"
  IsTabStop="False"
>
  <StackPanel Spacing="16">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="InlineFacts" />
        <VisualState x:Name="FactsBelow">
          <VisualState.Setters>
            <Setter Target="Layout.RowSpacing" Value="16" />
            <Setter Target="Subject.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="Facts.(Grid.Column)" Value="0" />
            <Setter Target="Facts.(Grid.Row)" Value="1" />
            <Setter Target="Facts.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="FirstColumn.Width" Value="*" />
            <Setter Target="SecondColumn.Width" Value="*" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="StackedFacts">
          <VisualState.Setters>
            <Setter Target="Layout.RowSpacing" Value="16" />
            <Setter Target="Subject.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="Facts.(Grid.Column)" Value="0" />
            <Setter Target="Facts.(Grid.Row)" Value="1" />
            <Setter Target="Facts.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="Facts.RowSpacing" Value="16" />
            <Setter Target="FirstColumn.Width" Value="*" />
            <Setter Target="SecondColumn.Width" Value="0" />
            <Setter Target="FirstPresenter.(Grid.ColumnSpan)" Value="2" />
            <Setter Target="SecondPresenter.(Grid.Column)" Value="0" />
            <Setter Target="SecondPresenter.(Grid.Row)" Value="1" />
            <Setter Target="SecondPresenter.(Grid.ColumnSpan)" Value="2" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup>
        <VisualState x:Name="SurfaceHeading" />
        <VisualState x:Name="PageHeading">
          <VisualState.StateTriggers>
            <StateTrigger IsActive="{x:Bind local:Header.IsPageHeading(HeadingLevel), Mode=OneWay}" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="TitleText.Style" Value="{StaticResource TinyTorrentPageTitleTextStyle}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <TextBlock
      x:Name="PageTitleText"
      Text="{x:Bind PageTitle, Mode=OneWay}"
      Style="{StaticResource TinyTorrentPageTitleTextStyle}"
      IsTextSelectionEnabled="True"
      Visibility="{x:Bind controls:Visibilities.HasText(PageTitle), Mode=OneWay}"
      ToolTipService.ToolTip="{x:Bind PageTitle, Mode=OneWay}"
      AutomationProperties.HeadingLevel="Level1"
    />
    <Grid x:Name="Layout" ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="Subject" ColumnSpacing="16" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image
          x:Name="ArtworkImage"
          Source="{x:Bind Artwork, Mode=OneWay}"
          Width="96"
          Height="96"
          Stretch="Uniform"
          IsHitTestVisible="False"
          AutomationProperties.AccessibilityView="Raw"
        />
        <StackPanel
          Grid.Column="1"
          Spacing="{StaticResource TinyTorrentTitleDetailSpacing}"
          VerticalAlignment="Center"
        >
          <TextBlock
            x:Name="TitleText"
            Text="{x:Bind Title, Mode=OneWay}"
            Style="{StaticResource TinyTorrentSurfaceTitleTextStyle}"
            IsTextSelectionEnabled="True"
            Visibility="{x:Bind controls:Visibilities.HasText(Title), Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
            AutomationProperties.HeadingLevel="{x:Bind HeadingLevel, Mode=OneWay}"
          />
          <TextBlock
            Text="{x:Bind Subtitle, Mode=OneWay}"
            Style="{StaticResource TinyTorrentTitleDetailTextStyle}"
            TextTrimming="CharacterEllipsis"
            Visibility="{x:Bind controls:Visibilities.HasText(Subtitle), Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Subtitle, Mode=OneWay}"
          />
        </StackPanel>
      </Grid>
      <Grid x:Name="Facts" Grid.Column="1" ColumnSpacing="24" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="FirstColumn" Width="Auto" />
          <ColumnDefinition x:Name="SecondColumn" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentPresenter
          x:Name="FirstPresenter"
          Content="{x:Bind First, Mode=OneWay}"
          HorizontalContentAlignment="Stretch"
        />
        <ContentPresenter
          x:Name="SecondPresenter"
          Grid.Column="1"
          Content="{x:Bind Second, Mode=OneWay}"
          HorizontalContentAlignment="Stretch"
        />
      </Grid>
    </Grid>
  </StackPanel>
</UserControl>
