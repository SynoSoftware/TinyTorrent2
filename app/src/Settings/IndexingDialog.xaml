<UserControl
  x:Class="Syno.TinyTorrent.Settings.IndexingDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:icons="using:Syno"
  xmlns:local="using:Syno.TinyTorrent.Settings"
  xmlns:table="using:Syno.TableView"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MinWidth="320" MaxWidth="800">
      <StackPanel x:Name="SettingsContent" Spacing="16">
        <controls:SettingsRow
          Setting="{x:Bind Model.Settings.Indexing}"
          Description="{x:Bind Model.Text.Get('catalogue', 'description'), Mode=OneWay}"
          StateText="{x:Bind controls:SettingsRow.State(Model.Settings.Indexing.IsOn, Model.Settings.OnText, Model.Settings.OffText), Mode=OneWay}"
        >
          <ToggleSwitch IsOn="{x:Bind Model.Settings.Indexing.IsOn, Mode=OneWay}" AutomationProperties.AutomationId="IndexingEnabled" />
        </controls:SettingsRow>
        <controls:SettingsRow
          Header="{x:Bind Model.Text.Get('catalogue', 'budget'), Mode=OneWay}"
          Error="{x:Bind Model.Settings.IndexBudget.Message, Mode=OneWay}"
        >
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="Budget" MinWidth="100" LostFocus="OnBudgetDeparture" KeyDown="OnBudgetKey" AutomationProperties.AutomationId="IndexBudget" />
            <ComboBox x:Name="BudgetUnit" SelectedIndex="0" SelectionChanged="OnBudgetUnit" AutomationProperties.AutomationId="IndexBudgetUnit" />
          </StackPanel>
        </controls:SettingsRow>
        <TextBlock x:Name="Usage" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=Usage}" AutomationProperties.HelpText="{Binding Text, ElementName=Usage}" Style="{StaticResource TinyTorrentTitleDetailTextStyle}" />
        <controls:SettingsRow
          Header="{x:Bind Model.Text.Get('catalogue', 'stale'), Mode=OneWay}"
          Error="{x:Bind Model.Settings.IndexStale.Message, Mode=OneWay}"
        >
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="Stale" MinWidth="100" LostFocus="OnStaleDeparture" KeyDown="OnStaleKey" AutomationProperties.AutomationId="IndexStale" />
            <ComboBox x:Name="StaleUnit" SelectedIndex="0" SelectionChanged="OnStaleUnit" AutomationProperties.AutomationId="IndexStaleUnit" />
          </StackPanel>
        </controls:SettingsRow>
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind Model.Text.Get('catalogue', 'rules'), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
          <controls:ActionButton Grid.Column="1" Text="{x:Bind Model.Text.Get('catalogue', 'add'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.Plus}" Click="OnAdd" AutomationProperties.AutomationId="AddIndexRule" />
        </Grid>
        <TextBlock x:Name="Excluded" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=Excluded}" AutomationProperties.HelpText="{Binding Text, ElementName=Excluded}" />
        <StackPanel x:Name="RulesContent" Spacing="8" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:ActionButton Text="{x:Bind Model.Text.Get('catalogue', 'review'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.ListFilter}" Click="OnReview" AutomationProperties.AutomationId="ReviewIndexRules" />
          <controls:ActionButton Text="{x:Bind Model.Text.Get('catalogue', 'rebuild'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.RefreshCw}" Click="OnRebuild" AutomationProperties.AutomationId="RebuildIndex" />
          <controls:ActionButton Text="{x:Bind Model.Text.Get('catalogue', 'clear'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.Trash2}" Click="OnClear" AutomationProperties.AutomationId="ClearIndex" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="EditorContent" Spacing="16" Visibility="Collapsed">
        <TextBlock Text="{x:Bind Model.Text.Get('catalogue', 'rule_intro'), Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind Model.Text.Get('catalogue', 'torrent'), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <StackPanel x:Name="TorrentConditions" Spacing="12" />
        <TextBlock Text="{x:Bind Model.Text.Get('catalogue', 'files'), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <ComboBox x:Name="Quantifier" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RuleQuantifier" />
        <StackPanel x:Name="FileConditions" Spacing="12" />
      </StackPanel>
      <StackPanel x:Name="PreviewContent" Spacing="16" Visibility="Collapsed">
        <TextBlock x:Name="PreviewDescription" TextWrapping="Wrap" />
        <StackPanel x:Name="PreviewFacts" Spacing="12" />
        <table:Table x:Name="RemovalEntries" Height="260" Visibility="Collapsed" AutomationProperties.AutomationId="IndexRemovalEntries">
          <table:Table.Columns>
            <table:Column x:Name="TorrentColumn" Id="torrent" CanHide="False" Width="320">
              <table:Column.CellTemplate>
                <DataTemplate x:DataType="local:RemovalRow"><TextBlock Text="{x:Bind Name}" Style="{StaticResource TinyTorrentIdentityTextStyle}" /></DataTemplate>
              </table:Column.CellTemplate>
            </table:Column>
            <table:Column x:Name="ReasonColumn" Id="reason" Width="360">
              <table:Column.CellTemplate>
                <DataTemplate x:DataType="local:RemovalRow"><TextBlock Text="{x:Bind Reason}" ToolTipService.ToolTip="{x:Bind Reason}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
              </table:Column.CellTemplate>
            </table:Column>
          </table:Table.Columns>
        </table:Table>
        <TextBlock x:Name="PreviewCoverage" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=PreviewCoverage}" AutomationProperties.HelpText="{Binding Text, ElementName=PreviewCoverage}" Visibility="Collapsed" />
      </StackPanel>
      <TextBlock x:Name="Feedback" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=Feedback}" AutomationProperties.HelpText="{Binding Text, ElementName=Feedback}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
