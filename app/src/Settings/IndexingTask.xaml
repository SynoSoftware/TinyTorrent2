<UserControl
  x:Class="Syno.TinyTorrent.Settings.IndexingTask"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:local="using:Syno.TinyTorrent.Settings"
  xmlns:icons="using:Syno"
>
  <ScrollViewer x:Name="Viewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MinWidth="320" MaxWidth="800">
      <StackPanel x:Name="EditorContent" Spacing="16" Visibility="Collapsed">
        <TextBlock Text="{x:Bind Model.Text.Get('catalogue', 'rule_intro'), Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind Model.Text.Get('catalogue', 'torrent'), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <StackPanel x:Name="TorrentConditions" Spacing="8" />
        <Grid ColumnSpacing="12" Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind Model.Text.Get('catalogue', 'files'), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
          <ComboBox x:Name="Quantifier" Grid.Column="1" AutomationProperties.AutomationId="RuleQuantifier" />
        </Grid>
        <StackPanel x:Name="FileConditions" Spacing="8" />
        <TextBlock x:Name="Validation" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <StackPanel x:Name="PreviewContent" Spacing="12" Visibility="Collapsed">
        <StackPanel x:Name="PolicyChanges" Spacing="8" />
        <TextBlock x:Name="PreviewDescription" TextWrapping="Wrap" />
        <StackPanel x:Name="PreviewFacts" Spacing="12" />
        <ScrollViewer x:Name="RemovalList" MaxHeight="224" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <ItemsControl x:Name="RemovalEntries" IsTabStop="False" AutomationProperties.AutomationId="IndexRemovalEntries">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:RemovalRow">
                <Grid ColumnSpacing="12" MinHeight="24">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.File}" Style="{StaticResource TinyTorrentStatusIconStyle}" AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock Grid.Column="1" Grid.ColumnSpan="{x:Bind NameSpan}" Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" Style="{StaticResource TinyTorrentIdentityTextStyle}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Reason}" ToolTipService.ToolTip="{x:Bind Reason}" Style="{StaticResource TinyTorrentBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Grid x:Name="Paging" ColumnSpacing="8" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="PageRange" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=PageRange}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <controls:ActionButton x:Name="Previous" Grid.Column="1" Text="{x:Bind Model.Text.Get('catalogue', 'previous'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.ArrowLeft}" Click="OnPrevious" />
          <controls:ActionButton x:Name="Next" Grid.Column="2" Text="{x:Bind Model.Text.Get('catalogue', 'next'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.ArrowRight}" Click="OnNext" />
        </Grid>
      </StackPanel>
      <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
