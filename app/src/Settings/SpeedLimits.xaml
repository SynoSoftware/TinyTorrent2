<UserControl
  x:Class="Syno.TinyTorrent.Settings.SpeedLimits"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:icons="using:Syno"
>
  <StackPanel Spacing="8">
    <Border x:Name="ModeCard" Style="{StaticResource TinyTorrentSettingsCardStyle}">
      <Grid ColumnSpacing="24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
          FontFamily="{x:Bind icons:Segoe.Font}"
          Glyph="{x:Bind icons:Segoe.SlidersHorizontal}"
          FontSize="{StaticResource TinyTorrentHeaderIconSize}"
          VerticalAlignment="Center"
        />
        <controls:SettingsRow
          x:Name="ModeRow"
          Grid.Column="1"
          Header="{x:Bind Main.Text.Get('transfer_limits', 'control'), Mode=OneWay}"
          Description="{x:Bind Main.LimitsSummary, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Main.LimitsNow, Mode=OneWay}"
          BorderThickness="0"
        />
      </Grid>
    </Border>
    <controls:FieldColumns
      x:Name="Profiles"
      Margin="0,16,0,0"
      MinimumWidth="640"
      Spacing="8"
      StackSpacing="8"
    >
      <controls:FieldColumns.Primary>
        <StackPanel Spacing="8">
          <TextBlock
            Text="{x:Bind Model.Text.Get('settings', 'standard_caps'), Mode=OneWay}"
            Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
            TextTrimming="CharacterEllipsis"
            controls:Trimming.ShowsToolTip="True"
          />
          <Border x:Name="StandardCard" Style="{StaticResource TinyTorrentSettingsCardStyle}">
            <StackPanel x:Name="StandardRows" />
          </Border>
        </StackPanel>
      </controls:FieldColumns.Primary>
      <controls:FieldColumns.Secondary>
        <StackPanel Spacing="8">
          <TextBlock
            Text="{x:Bind Model.Text.Get('settings', 'alternative_caps'), Mode=OneWay}"
            Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
            TextTrimming="CharacterEllipsis"
            controls:Trimming.ShowsToolTip="True"
          />
          <Border x:Name="AlternativeCard" Style="{StaticResource TinyTorrentSettingsCardStyle}">
            <StackPanel x:Name="AlternativeRows" />
          </Border>
        </StackPanel>
      </controls:FieldColumns.Secondary>
    </controls:FieldColumns>
    <controls:SettingsLink x:Name="Connection" Click="OnConnection" />
  </StackPanel>
</UserControl>
