<UserControl x:Class="Syno.TinyTorrent.Views.AddForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Syno"
    xmlns:local="using:Syno.TinyTorrent.Views">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressRing Width="20" Height="20" IsActive="{x:Bind Model.Draft.GettingMetadata, Mode=OneWay}" Visibility="{x:Bind Model.Draft.GettingMetadata, Mode=OneWay}" />
            <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.HardDriveDownload}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Visibility="{x:Bind local:AddForm.Hidden(Model.Draft.GettingMetadata), Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="{x:Bind Model.Draft.Preview, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <DropDownButton x:Name="More" Grid.Column="2">
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Name="Files" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" Click="OnFiles">
                            <MenuFlyoutItem.Icon><FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.FilePlus}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="Magnet" Command="{x:Bind Model.AddMagnet}">
                            <MenuFlyoutItem.Icon><FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Link}" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="220" MaxWidth="300" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.HardDrive}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="DestinationLabel" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="Destination" Text="{x:Bind Model.Draft.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}"
                                    AutomationProperties.LabeledBy="{x:Bind DestinationLabel}" ToolTipService.ToolTip="{x:Bind Model.Draft.Destination, Mode=OneWay}" />
                                <Button x:Name="Browse" Grid.Column="1" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" Click="OnDestination" />
                            </Grid>
                            <TextBlock Text="{x:Bind Model.Draft.Space, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Model.Draft.Shared, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.SlidersHorizontal}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="OptionsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <CheckBox x:Name="Paused" IsChecked="{x:Bind Model.Draft.Paused, Mode=TwoWay}" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <CheckBox x:Name="NeverShow" Grid.Row="1" IsChecked="{x:Bind Model.Draft.NeverShow, Mode=TwoWay}" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" />
            </Grid>
            <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind Model.Draft.EditingMagnet, Mode=OneWay}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="MagnetInput" Text="{x:Bind Model.Draft.Magnet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" />
                        <Button x:Name="Paste" Grid.Column="1" VerticalAlignment="Bottom" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" Click="OnPaste" />
                        <Button x:Name="Preview" Grid.Column="2" VerticalAlignment="Bottom" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" Click="OnPreview" />
                        <InfoBar Grid.Row="1" Grid.ColumnSpan="3" IsClosable="False" Severity="Error" IsOpen="{x:Bind Model.Draft.HasMagnetError, Mode=OneWay}" Visibility="{x:Bind Model.Draft.HasMagnetError, Mode=OneWay}" Message="{x:Bind Model.Draft.MagnetMessage, Mode=OneWay}" />
                    </Grid>
                    <Grid Grid.Row="1" Visibility="{x:Bind Model.Draft.HasSources, Mode=OneWay}">
                        <ListView ItemsSource="{x:Bind Model.Draft.Sources}" SelectionMode="None" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" Visibility="{x:Bind local:AddForm.Hidden(Model.Draft.HasFiles), Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AddSource">
                                    <StackPanel Spacing="4" Padding="0,4">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <CheckBox Content="{x:Bind MergeLabel, Mode=OneWay}" IsChecked="{x:Bind Merge, Mode=TwoWay}" Visibility="{x:Bind MergeAvailable, Mode=OneWay}" />
                                        <Button Content="{x:Bind AllLabel, Mode=OneWay}" Command="{x:Bind SelectAll}" Visibility="{x:Bind NeedsFiles, Mode=OneWay}" />
                                        <Button Content="{x:Bind RemoveLabel, Mode=OneWay}" Command="{x:Bind Remove}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ContentControl x:Name="FileHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{x:Bind Model.Draft.HasFiles, Mode=OneWay}" IsEnabled="{x:Bind Model.Draft.CanEdit, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <InfoBar Grid.Row="2" IsClosable="False" IsOpen="{x:Bind Model.Draft.HasError, Mode=OneWay}" Message="{x:Bind Model.Draft.Message, Mode=OneWay}" Severity="{x:Bind Model.Draft.Severity, Mode=OneWay}">
            <InfoBar.ActionButton><Button AutomationProperties.AutomationId="Restart" Content="{x:Bind Model.RestartText, Mode=OneWay}" Command="{x:Bind Model.Restart}" Visibility="{x:Bind Model.CanRestart, Mode=OneWay}" /></InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</UserControl>
