<UserControl
  x:Class="Syno.TinyTorrent.Views.ConnectionPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="using:Syno.TinyTorrent.Views"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:icons="using:Syno"
>
  <UserControl.Resources>
    <DataTemplate x:Key="ChangeRow" x:DataType="views:ConnectionChange">
      <Grid
        MinHeight="32"
        ColumnSpacing="12"
        BorderThickness="0,0,0,1"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
      >
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Text="{x:Bind Label}"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis"
          ToolTipService.ToolTip="{x:Bind Label}"
        />
        <TextBlock
          Grid.Column="1"
          Text="{x:Bind Current}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis"
          ToolTipService.ToolTip="{x:Bind Current}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        />
        <TextBlock
          Grid.Column="2"
          Text="{x:Bind Proposed}"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis"
          ToolTipService.ToolTip="{x:Bind Proposed}"
          FontWeight="{x:Bind views:ConnectionPage.Weight(IsChanged)}"
        />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowSpacing="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid
      ColumnSpacing="16"
      Margin="24,16,24,0"
      MaxWidth="{StaticResource TinyTorrentSettingsWidth}"
    >
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <BreadcrumbBar
        x:Name="Hierarchy"
        ItemClicked="OnHierarchy"
        VerticalAlignment="Center"
        IsTabStop="True"
        AutomationProperties.HeadingLevel="Level1"
        AutomationProperties.Name="{x:Bind Model.Text.Get('connection_setup', 'title'), Mode=OneWay}"
      >
        <BreadcrumbBar.Resources>
          <Thickness x:Key="BreadcrumbBarChevronPadding">8,0</Thickness>
          <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
        </BreadcrumbBar.Resources>
        <BreadcrumbBar.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Style="{StaticResource TinyTorrentPageTitleTextStyle}" />
          </DataTemplate>
        </BreadcrumbBar.ItemTemplate>
      </BreadcrumbBar>
      <Image
        Grid.Column="1"
        Source="ms-appx:///Assets/Settings/setup.png"
        Width="96"
        Height="96"
        Stretch="Uniform"
        IsHitTestVisible="False"
        AutomationProperties.AccessibilityView="Raw"
      />
    </Grid>
    <ScrollViewer
      Grid.Row="1"
      HorizontalScrollMode="Disabled"
      HorizontalScrollBarVisibility="Disabled"
      HorizontalContentAlignment="Stretch"
    >
      <Grid Margin="24,0">
        <StackPanel Spacing="24" MaxWidth="{StaticResource TinyTorrentSettingsWidth}">
          <Border Style="{StaticResource TinyTorrentSettingsCardStyle}" Padding="16">
            <StackPanel Spacing="12">
              <Grid x:Name="TestToolbar" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Text="{x:Bind Model.Text.Get('connection_setup', 'speed_test'), Mode=OneWay}"
                    Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
                    TextTrimming="CharacterEllipsis"
                  />
                  <Button
                    Grid.Column="1"
                    Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind Model.Text.Get('connection_setup', 'about_test'), Mode=OneWay}"
                    AutomationProperties.AutomationId="ConnectionTestInfo"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'about_test'), Mode=OneWay}"
                  >
                    <FontIcon
                      FontFamily="{x:Bind icons:Lucide.Font}"
                      Glyph="{x:Bind icons:Lucide.Info}"
                      FontSize="{StaticResource TinyTorrentButtonIconSize}"
                    />
                    <Button.Flyout>
                      <Flyout Placement="Bottom">
                        <StackPanel MaxWidth="560" Spacing="12">
                          <TextBlock
                            Text="{x:Bind Model.Text.Get('connection_setup', 'about_test'), Mode=OneWay}"
                            Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'about_test'), Mode=OneWay}"
                          />
                          <TextBlock
                            Text="{x:Bind Model.Text.Get('connection_setup', 'test_data'), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'test_data'), Mode=OneWay}"
                          />
                          <TextBlock
                            Text="{x:Bind Model.TestAllowance, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Model.TestAllowance, Mode=OneWay}"
                          />
                          <TextBlock
                            Text="{x:Bind Model.Text.Get('connection_setup', 'test_rule'), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'test_rule'), Mode=OneWay}"
                          />
                          <TextBlock
                            Text="{x:Bind Model.Text.Get('connection_setup', 'test_data_use'), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'test_data_use'), Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          />
                          <TextBlock
                            Text="{x:Bind Model.Text.Get('connection_setup', 'test_method'), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'test_method'), Mode=OneWay}"
                          />
                          <HyperlinkButton
                            Content="{x:Bind Model.Text.Get('connection_setup', 'test_privacy'), Mode=OneWay}"
                            NavigateUri="https://www.cloudflare.com/privacypolicy/"
                            HorizontalAlignment="Left"
                            Padding="0"
                          />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
                <StackPanel x:Name="TestOptions" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                  <RadioButton GroupName="ConnectionTestSize" IsChecked="{x:Bind Model.QuickTest, Mode=OneWay}"
                    IsEnabled="{x:Bind Model.CanTest, Mode=OneWay}"
                    Checked="OnQuick" ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'quick_allowance'), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Model.Text.Get('connection_setup', 'quick'), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </RadioButton>
                  <RadioButton GroupName="ConnectionTestSize" IsChecked="{x:Bind Model.LongerTest, Mode=OneWay}"
                    IsEnabled="{x:Bind Model.CanTest, Mode=OneWay}"
                    Checked="OnLonger" ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'longer_allowance'), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Model.Text.Get('connection_setup', 'longer'), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                  </RadioButton>
                </StackPanel>
                <Grid x:Name="TestActions" Grid.Column="2" VerticalAlignment="Center">
                  <controls:ActionButton
                    Text="{x:Bind Model.TestLabel, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Glyph="{x:Bind icons:Lucide.Gauge}"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'test_hint'), Mode=OneWay}"
                    Visibility="{x:Bind views:ConnectionPage.Hidden(Model.IsTesting), Mode=OneWay}"
                    IsEnabled="{x:Bind Model.CanTest, Mode=OneWay}"
                    Click="OnTest"
                    AutomationProperties.AutomationId="ConnectionTest"
                  />
                  <controls:ActionButton
                    Text="{x:Bind Model.Text.Get('connection_setup', 'cancel_test'), Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    Glyph="{x:Bind icons:Lucide.X}"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'cancel_test_hint'), Mode=OneWay}"
                    Visibility="{x:Bind Model.IsTesting, Mode=OneWay}"
                    IsEnabled="{x:Bind Model.CanCancelTest, Mode=OneWay}"
                    Click="OnCancelTest"
                    AutomationProperties.AutomationId="ConnectionCancelTest"
                  />
                </Grid>
              </Grid>
              <Grid x:Name="MeasurementBody" ColumnSpacing="24" RowSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition x:Name="StatusColumn" Width="240" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,12,8,8">
                  <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="DownloadMeter" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                    <ContentControl x:Name="UploadMeter" Grid.Column="1" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                  </Grid>
                </Border>
                <StackPanel x:Name="StatusArea" Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Model.TestStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                      ToolTipService.ToolTip="{x:Bind Model.TestStatus, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Model.ProgressText, Mode=OneWay}" />
                  </Grid>
                  <ProgressBar Height="4" Value="{x:Bind Model.TestProgress, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Model.TestStatus, Mode=OneWay}" />
                  <TextBlock Text="{x:Bind Model.TestDetail, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Model.TestDetail, Mode=OneWay}" />
                  <Grid MinHeight="40" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Model.TestHint, Mode=OneWay}"
                      VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                      ToolTipService.ToolTip="{x:Bind Model.TestHint, Mode=OneWay}" />
                    <controls:ActionButton Grid.Column="1" Text="{x:Bind Model.Text.Get('connection_setup', 'resume'), Mode=OneWay}"
                      Visibility="{x:Bind Model.IsHolding, Mode=OneWay}" IsEnabled="{x:Bind Model.CanLeave, Mode=OneWay}"
                      Glyph="{x:Bind icons:Lucide.Play}" Click="OnResume"
                      ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'resume_hint'), Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Grid x:Name="Body" ColumnSpacing="24" RowSpacing="24" SizeChanged="OnBodySize">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="InputColumn" Width="320" />
              <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="Inputs" Spacing="24">
              <StackPanel Spacing="8">
                <TextBlock
                  Text="{x:Bind Model.Text.Get('connection_setup', 'capacity'), Mode=OneWay}"
                  Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
                  TextTrimming="CharacterEllipsis"
                  ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'capacity'), Mode=OneWay}"
                />
                <Border Style="{StaticResource TinyTorrentSettingsCardStyle}" Padding="16">
                  <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                      x:Name="Download"
                      Text="{x:Bind Model.Download, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="{x:Bind Model.Text.Get('connection_setup', 'enter'), Mode=OneWay}"
                      InputScope="Number"
                      IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Model.Text.Get('connection_setup', 'download'), Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind Model.DownloadError, Mode=OneWay}"
                      AutomationProperties.AutomationId="ConnectionDownload"
                    >
                      <TextBox.Header>
                        <controls:FieldHeader
                          Label="{x:Bind Model.Text.Get('connection_setup', 'download'), Mode=OneWay}"
                          Error="{x:Bind Model.DownloadError, Mode=OneWay}"
                        />
                      </TextBox.Header>
                    </TextBox>
                    <TextBox
                      x:Name="Upload"
                      Grid.Column="1"
                      Text="{x:Bind Model.Upload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="{x:Bind Model.Text.Get('connection_setup', 'enter'), Mode=OneWay}"
                      InputScope="Number"
                      IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Model.Text.Get('connection_setup', 'upload'), Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind Model.UploadError, Mode=OneWay}"
                      AutomationProperties.AutomationId="ConnectionUpload"
                    >
                      <TextBox.Header>
                        <controls:FieldHeader
                          Label="{x:Bind Model.Text.Get('connection_setup', 'upload'), Mode=OneWay}"
                          Error="{x:Bind Model.UploadError, Mode=OneWay}"
                        />
                      </TextBox.Header>
                    </TextBox>
                  </Grid>
                </Border>
              </StackPanel>
              <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Text="{x:Bind Model.Text.Get('settings', 'standard_caps'), Mode=OneWay}"
                    Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'standard_caps'), Mode=OneWay}"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Model.StandardText, Mode=OneWay}"
                    FontWeight="SemiBold"
                  />
                </Grid>
                <Border
                  Style="{StaticResource TinyTorrentSettingsCardStyle}"
                  Padding="16"
                  ToolTipService.ToolTip="{x:Bind Model.StandardHint, Mode=OneWay}"
                >
                  <StackPanel>
                    <Slider
                      Minimum="5"
                      Maximum="100"
                      StepFrequency="5"
                      SmallChange="5"
                      SnapsTo="StepValues"
                      IsThumbToolTipEnabled="False"
                      Value="{x:Bind Model.StandardShare, Mode=TwoWay}"
                      IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'standard_caps'), Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind Model.StandardRates, Mode=OneWay}"
                      AutomationProperties.AutomationId="ConnectionStandard"
                    />
                    <TextBlock
                      Text="{x:Bind Model.StandardRates, Mode=OneWay}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextTrimming="CharacterEllipsis"
                      ToolTipService.ToolTip="{x:Bind Model.StandardRates, Mode=OneWay}"
                    />
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Text="{x:Bind Model.Text.Get('settings', 'alternative_caps'), Mode=OneWay}"
                    Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'alternative_caps'), Mode=OneWay}"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Model.AlternativeText, Mode=OneWay}"
                    FontWeight="SemiBold"
                  />
                </Grid>
                <Border
                  Style="{StaticResource TinyTorrentSettingsCardStyle}"
                  Padding="16"
                  ToolTipService.ToolTip="{x:Bind Model.AlternativeHint, Mode=OneWay}"
                >
                  <StackPanel>
                    <Slider
                      Minimum="5"
                      Maximum="100"
                      StepFrequency="5"
                      SmallChange="5"
                      SnapsTo="StepValues"
                      IsThumbToolTipEnabled="False"
                      Value="{x:Bind Model.AlternativeShare, Mode=TwoWay}"
                      IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'alternative_caps'), Mode=OneWay}"
                      AutomationProperties.HelpText="{x:Bind Model.AlternativeRates, Mode=OneWay}"
                      AutomationProperties.AutomationId="ConnectionAlternative"
                    />
                    <TextBlock
                      Text="{x:Bind Model.AlternativeRates, Mode=OneWay}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextTrimming="CharacterEllipsis"
                      ToolTipService.ToolTip="{x:Bind Model.AlternativeRates, Mode=OneWay}"
                    />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
            <Border x:Name="Preview" Grid.Column="1" Style="{StaticResource TinyTorrentSettingsCardStyle}" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock
                  Text="{x:Bind Model.Text.Get('connection_setup', 'preview'), Mode=OneWay}"
                  Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
                  MinHeight="32"
                />
                <Grid ColumnSpacing="12" MinHeight="32">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    Text="{x:Bind Model.Text.Get('connection_setup', 'setting'), Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  />
                  <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Text="{x:Bind Model.Text.Get('connection_setup', 'current'), Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  />
                  <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Text="{x:Bind Model.Text.Get('connection_setup', 'proposed'), Mode=OneWay}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  />
                </Grid>
                <ItemsControl
                  ItemsSource="{x:Bind Model.ModeRows, Mode=OneWay}"
                  ItemTemplate="{StaticResource ChangeRow}"
                />
                <Grid MinHeight="32" Padding="0,8,0,0" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.Gauge}"
                    FontSize="{StaticResource TinyTorrentInlineIconSize}"
                    AutomationProperties.AccessibilityView="Raw"
                  />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                  >
                    <Run
                      Text="{x:Bind Model.Text.Get('settings', 'standard_caps'), Mode=OneWay}"
                      FontWeight="SemiBold"
                    />
                    <Run
                      Text="{x:Bind Model.StandardUse, Mode=OneWay}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    />
                  </TextBlock>
                </Grid>
                <ItemsControl
                  ItemsSource="{x:Bind Model.StandardRows, Mode=OneWay}"
                  ItemTemplate="{StaticResource ChangeRow}"
                />
                <Grid MinHeight="32" Padding="0,8,0,0" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.ArrowLeftRight}"
                    FontSize="{StaticResource TinyTorrentInlineIconSize}"
                    AutomationProperties.AccessibilityView="Raw"
                  />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                  >
                    <Run
                      Text="{x:Bind Model.Text.Get('settings', 'alternative_caps'), Mode=OneWay}"
                      FontWeight="SemiBold"
                    />
                    <Run
                      Text="{x:Bind Model.AlternativeUse, Mode=OneWay}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    />
                  </TextBlock>
                </Grid>
                <ItemsControl
                  ItemsSource="{x:Bind Model.AlternativeRows, Mode=OneWay}"
                  ItemTemplate="{StaticResource ChangeRow}"
                />
                <Grid MinHeight="32" Padding="0,8,0,0" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.ListOrdered}"
                    FontSize="{StaticResource TinyTorrentInlineIconSize}"
                    AutomationProperties.AccessibilityView="Raw"
                  />
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Text="{x:Bind Model.Text.Get('settings', 'queue'), Mode=OneWay}"
                    FontWeight="SemiBold"
                  />
                </Grid>
                <ItemsControl
                  ItemsSource="{x:Bind Model.QueueRows, Mode=OneWay}"
                  ItemTemplate="{StaticResource ChangeRow}"
                />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid
      Grid.Row="2"
      Margin="24,0,24,16"
      MaxWidth="{StaticResource TinyTorrentSettingsWidth}"
      ColumnSpacing="24"
      Padding="0,20,0,0"
      BorderThickness="0,1,0,0"
      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
    >
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        Text="{x:Bind Model.Message, Mode=OneWay}"
        TextTrimming="CharacterEllipsis"
        ToolTipService.ToolTip="{x:Bind Model.Message, Mode=OneWay}"
        VerticalAlignment="Center"
        MinHeight="40"
      />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <controls:ActionButton
          Text="{x:Bind Model.Text.Get('connection_setup', 'apply'), Mode=OneWay}"
          Glyph="{x:Bind icons:Lucide.Check}"
          Style="{StaticResource AccentButtonStyle}"
          IsEnabled="{x:Bind Model.CanApply, Mode=OneWay}"
          Click="OnApply"
          AutomationProperties.AutomationId="ConnectionApply"
          ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'apply_hint'), Mode=OneWay}"
        />
        <controls:ActionButton
          Text="{x:Bind Model.Text.Get('dialog', 'cancel'), Mode=OneWay}"
          Glyph="{x:Bind icons:Lucide.X}"
          ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection_setup', 'cancel_hint'), Mode=OneWay}"
          IsEnabled="{x:Bind Model.CanLeave, Mode=OneWay}"
          Click="OnCancel"
        />
      </StackPanel>
      <InfoBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0"
        IsOpen="{x:Bind Model.HasLinkWarning, Mode=OneWay}" IsClosable="False" Severity="Warning">
        <InfoBar.Content>
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Model.LinkTitle, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind Model.LinkTitle, Mode=OneWay}" />
            <TextBlock Text="{x:Bind Model.LinkDetail, Mode=OneWay}" TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind Model.LinkDetail, Mode=OneWay}" />
          </StackPanel>
        </InfoBar.Content>
      </InfoBar>
    </Grid>
  </Grid>
</UserControl>
