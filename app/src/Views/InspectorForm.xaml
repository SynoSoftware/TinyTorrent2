<UserControl x:Class="Syno.TinyTorrent.Views.InspectorForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Syno.TinyTorrent.Views"
    xmlns:controls="using:Syno.TinyTorrent.Controls"
    xmlns:models="using:Syno.TinyTorrent.Models"
    xmlns:table="using:Syno.TableView"
    xmlns:icons="using:Syno">
    <UserControl.Resources>
        <Style x:Key="InspectorFormValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TinyTorrentStatusTextStyle}">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="InspectorFormIdentifierStyle" TargetType="TextBlock" BasedOn="{StaticResource InspectorFormValueStyle}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style x:Key="InspectorFormStatisticValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeTextBlockStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
        <Style x:Key="InspectorFormIconStyle" TargetType="FontIcon" BasedOn="{StaticResource TinyTorrentStatusIconStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        </Style>
        <!-- A property: icon, label and value on one row. The value and its action
             sit in a left-aligned Grid, so its star column fits the value and the
             action follows it, while a long value still trims before the action. -->
        <Style TargetType="controls:Field">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:Field">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{TemplateBinding Glyph}" Style="{StaticResource InspectorFormIconStyle}" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Label}" Style="{StaticResource TinyTorrentStatusTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{TemplateBinding Label}" />
                            <Grid Grid.Column="2" HorizontalAlignment="Left" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding Content}" />
                                <!-- A second ContentPresenter here fails layout with E_INVALIDARG
                                     when the General view opens; a ContentControl does not. -->
                                <ContentControl Grid.Column="1" Content="{TemplateBinding Action}" IsTabStop="False" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A statistic: its icon beside the caption, with the value below the caption.
             The transparent background makes the whole statistic a double-click target. -->
        <Style x:Key="InspectorFormStatisticStyle" TargetType="controls:Field">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:Field">
                        <StackPanel Orientation="Horizontal" Spacing="12" Background="Transparent">
                            <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{TemplateBinding Glyph}" Style="{StaticResource InspectorFormIconStyle}" FontSize="20" />
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" />
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </StackPanel>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TransferStates">
                <VisualState x:Name="Transferring" />
                <VisualState x:Name="Paused">
                    <VisualState.Setters><Setter Target="Progress.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters><Setter Target="Summary.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="Details.ColumnSpacing" Value="0" />
                        <Setter Target="MetadataColumn.Width" Value="0" />
                        <Setter Target="Metadata.(Grid.Column)" Value="0" />
                        <Setter Target="Metadata.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <!-- The empty star column balances the name's, so the sections sit
             centred while Close keeps its width when the inspector is narrow. -->
        <Grid ColumnSpacing="12" Padding="16,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <!-- Left-aligned, so the size follows a short name and a long name trims before it. -->
            <Grid HorizontalAlignment="Left" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon Style="{StaticResource GroupIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind Model.Target.StatusGlyph, Mode=OneWay, FallbackValue=''}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Model.Name, Mode=OneWay}" Style="{StaticResource GroupTitleTextStyle}"
                    ToolTipService.ToolTip="{x:Bind Model.Name, Mode=OneWay}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Grid.Column="2" Text="{x:Bind Model.Target.SizeText, Mode=OneWay, FallbackValue=''}" Style="{StaticResource TitleDetailTextStyle}" />
            </Grid>
            <SelectorBar x:Name="Sections" Grid.Column="1" Padding="0" SelectionChanged="OnSection" AutomationProperties.AutomationId="InspectorSections">
                <SelectorBarItem x:Name="GeneralSection" AutomationProperties.AutomationId="InspectorGeneral" />
                <SelectorBarItem x:Name="FilesSection" AutomationProperties.AutomationId="InspectorFiles" />
                <SelectorBarItem x:Name="PeersSection" AutomationProperties.AutomationId="InspectorPeers" />
                <SelectorBarItem x:Name="TrackersSection" AutomationProperties.AutomationId="InspectorTrackers" />
                <SelectorBarItem x:Name="SpeedSection" AutomationProperties.AutomationId="InspectorSpeed" />
                <SelectorBarItem x:Name="PiecesSection" AutomationProperties.AutomationId="InspectorPieces" />
            </SelectorBar>
            <Button x:Name="Close" x:FieldModifier="internal" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center">
                <FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.X}" />
            </Button>
        </Grid>
        <Grid Grid.Row="1" Padding="16,8,16,12">
            <Grid>
                <ScrollViewer x:Name="General" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="GeneralContent" Spacing="16" Margin="0,4,0,0" SizeChanged="OnGeneralSize">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                <FontIcon Style="{StaticResource GroupIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.ArrowDownUp}" />
                                <TextBlock Text="{x:Bind Model.Text.Get('inspector', 'transfer'), Mode=OneWay}" Style="{StaticResource GroupTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Model.Target.Status, Mode=OneWay}" Style="{StaticResource SurfaceTitleTextStyle}" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Model.Target.Status, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Model.ProgressText, Mode=OneWay}" Style="{StaticResource SurfaceTitleTextStyle}" />
                            </Grid>
                            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Margin="0,8,0,8"
                                Value="{x:Bind Model.Target.Progress, Mode=OneWay}" IsIndeterminate="{x:Bind Model.IsIndeterminate, Mode=OneWay}"
                                ShowError="{x:Bind Model.Target.IsError, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind Model.Text.Get('columns', 'progress'), Mode=OneWay}" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="112" /><ColumnDefinition Width="Auto" MinWidth="112" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="Summary" Text="{x:Bind Model.Summary, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" ToolTipService.ToolTip="{x:Bind Model.Summary, Mode=OneWay}" />
                                <StackPanel x:Name="DownloadRate" Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" Background="Transparent" ToolTipService.ToolTip="{x:Bind Model.Text.Get('columns', 'down'), Mode=OneWay}">
                                    <FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.ArrowDown}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{x:Bind Model.Target.DownloadText, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" AutomationProperties.Name="{x:Bind Model.Target.DownloadName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Target.DownloadText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel x:Name="UploadRate" Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" Background="Transparent" ToolTipService.ToolTip="{x:Bind Model.Text.Get('columns', 'up'), Mode=OneWay}">
                                    <FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.ArrowUp}" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{x:Bind Model.Target.UploadText, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" AutomationProperties.Name="{x:Bind Model.Target.UploadName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Target.UploadText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                            <controls:Strip Margin="0,16,0,0" ColumnSpacing="32" RowSpacing="12">
                                <controls:Field Style="{StaticResource InspectorFormStatisticStyle}" Glyph="{x:Bind icons:Lucide.Download}" Label="{x:Bind Model.Text.Get('inspector', 'downloaded'), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Model.Target.DownloadedText, Mode=OneWay}" Style="{StaticResource InspectorFormStatisticValueStyle}" />
                                </controls:Field>
                                <controls:Field Style="{StaticResource InspectorFormStatisticStyle}" Glyph="{x:Bind icons:Lucide.Upload}" Label="{x:Bind Model.Text.Get('peers', 'uploaded'), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Model.Target.UploadedText, Mode=OneWay}" Style="{StaticResource InspectorFormStatisticValueStyle}" />
                                </controls:Field>
                                <controls:Field x:Name="Ratio" Style="{StaticResource InspectorFormStatisticStyle}" Glyph="{x:Bind icons:Lucide.Scale}" Label="{x:Bind Model.Text.Get('columns', 'ratio'), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Model.Target.RatioText, Mode=OneWay}" Style="{StaticResource InspectorFormStatisticValueStyle}" />
                                </controls:Field>
                                <controls:Field x:Name="SeedCount" Style="{StaticResource InspectorFormStatisticStyle}" Glyph="{x:Bind icons:Lucide.Sprout}" Label="{x:Bind Model.Text.Get('columns', 'seeds'), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Model.Target.SeedsText, Mode=OneWay}" Style="{StaticResource InspectorFormStatisticValueStyle}" ToolTipService.ToolTip="{x:Bind Model.Target.SeedsName, Mode=OneWay}" AutomationProperties.Name="{x:Bind Model.Target.SeedsName, Mode=OneWay}" />
                                </controls:Field>
                                <controls:Field x:Name="PeerCount" Style="{StaticResource InspectorFormStatisticStyle}" Glyph="{x:Bind icons:Lucide.Users}" Label="{x:Bind Model.Text.Get('columns', 'peers'), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Model.Target.PeersText, Mode=OneWay}" Style="{StaticResource InspectorFormStatisticValueStyle}" ToolTipService.ToolTip="{x:Bind Model.Target.PeersName, Mode=OneWay}" AutomationProperties.Name="{x:Bind Model.Target.PeersName, Mode=OneWay}" />
                                </controls:Field>
                                <controls:Field x:Name="Limit" Style="{StaticResource InspectorFormStatisticStyle}" Glyph="{x:Bind icons:Lucide.Gauge}" Label="{x:Bind Model.Text.Get('columns', 'limit'), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Model.LimitText, Mode=OneWay}" Style="{StaticResource InspectorFormStatisticValueStyle}" AutomationProperties.Name="{x:Bind Model.LimitName, Mode=OneWay}" />
                                </controls:Field>
                            </controls:Strip>
                        </StackPanel>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                <FontIcon Style="{StaticResource GroupIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Info}" />
                                <TextBlock Text="{x:Bind Model.Text.Get('inspector', 'properties'), Mode=OneWay}" Style="{StaticResource GroupTitleTextStyle}" AutomationProperties.HeadingLevel="Level2" />
                            </StackPanel>
                            <Grid x:Name="Details" ColumnSpacing="48">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition x:Name="MetadataColumn" Width="2*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <controls:Field Glyph="{x:Bind icons:Lucide.Folder}" Label="{x:Bind Model.Text.Get('inspector', 'folder'), Mode=OneWay}">
                                        <controls:Field.Action>
                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Model.OpenFolder}" AutomationProperties.Name="{x:Bind Model.Text.Get('commands', 'open_folder'), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Text.Get('commands', 'open_folder'), Mode=OneWay}">
                                                <FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.FolderOpen}" />
                                            </Button>
                                        </controls:Field.Action>
                                        <TextBlock x:Name="FolderPath" Text="{x:Bind Model.Folder, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" FlowDirection="LeftToRight" ToolTipService.ToolTip="{x:Bind Model.Folder, Mode=OneWay}" />
                                    </controls:Field>
                                    <controls:Field Glyph="{x:Bind icons:Lucide.Hash}" Label="{x:Bind Model.HashV1Label, Mode=OneWay}" Visibility="{x:Bind local:InspectorForm.Shown(Model.HashV1), Mode=OneWay}">
                                        <controls:Field.Action>
                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Model.CopyV1}" AutomationProperties.Name="{x:Bind Model.Text.Get('commands', 'copy_hash'), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Text.Get('commands', 'copy_hash'), Mode=OneWay}">
                                                <FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Copy}" />
                                            </Button>
                                        </controls:Field.Action>
                                        <TextBlock Text="{x:Bind Model.HashV1, Mode=OneWay}" Style="{StaticResource InspectorFormIdentifierStyle}" ToolTipService.ToolTip="{x:Bind Model.HashV1, Mode=OneWay}" />
                                    </controls:Field>
                                    <controls:Field Glyph="{x:Bind icons:Lucide.Hash}" Label="{x:Bind Model.HashV2Label, Mode=OneWay}" Visibility="{x:Bind local:InspectorForm.Shown(Model.HashV2), Mode=OneWay}">
                                        <controls:Field.Action>
                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Model.CopyV2}" AutomationProperties.Name="{x:Bind Model.Text.Get('commands', 'copy_hash'), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Text.Get('commands', 'copy_hash'), Mode=OneWay}">
                                                <FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Copy}" />
                                            </Button>
                                        </controls:Field.Action>
                                        <TextBlock Text="{x:Bind Model.HashV2, Mode=OneWay}" Style="{StaticResource InspectorFormIdentifierStyle}" ToolTipService.ToolTip="{x:Bind Model.HashV2, Mode=OneWay}" />
                                    </controls:Field>
                                    <controls:Field Glyph="{x:Bind icons:Lucide.Magnet}" Label="{x:Bind Model.Text.Get('add', 'magnet'), Mode=OneWay}">
                                        <controls:Field.Action>
                                            <Button Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Model.CopyMagnet}" AutomationProperties.Name="{x:Bind Model.Text.Get('commands', 'copy_magnet'), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Text.Get('commands', 'copy_magnet'), Mode=OneWay}">
                                                <FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Copy}" />
                                            </Button>
                                        </controls:Field.Action>
                                        <TextBlock Text="{x:Bind Model.Magnet, Mode=OneWay}" Style="{StaticResource InspectorFormIdentifierStyle}" ToolTipService.ToolTip="{x:Bind Model.Magnet, Mode=OneWay}" />
                                    </controls:Field>
                                    <controls:Field Glyph="{x:Bind icons:Lucide.MessageSquare}" Label="{x:Bind Model.Text.Get('inspector', 'comment'), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Model.CommentText, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" ToolTipService.ToolTip="{x:Bind Model.CommentText, Mode=OneWay}" />
                                    </controls:Field>
                                </StackPanel>
                                <StackPanel x:Name="Metadata" Grid.Column="1">
                                    <controls:Field Glyph="{x:Bind icons:Lucide.Clock}" Label="{x:Bind Model.Text.Get('columns', 'added'), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Model.Target.AddedTip, Mode=OneWay, TargetNullValue='—'}" Style="{StaticResource InspectorFormValueStyle}" ToolTipService.ToolTip="{x:Bind Model.Target.AddedText, Mode=OneWay}" />
                                    </controls:Field>
                                    <controls:Field Glyph="{x:Bind icons:Lucide.Grid3x3}" Label="{x:Bind Model.Text.Get('inspector', 'pieces'), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Model.PiecesText, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" ToolTipService.ToolTip="{x:Bind Model.PiecesText, Mode=OneWay}" />
                                    </controls:Field>
                                    <controls:Field Glyph="{x:Bind Model.PrivacyGlyph, Mode=OneWay}" Label="{x:Bind Model.Text.Get('inspector', 'privacy'), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Model.PrivacyText, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" ToolTipService.ToolTip="{x:Bind Model.PrivacyText, Mode=OneWay}" />
                                    </controls:Field>
                                    <controls:Field Glyph="{x:Bind icons:Lucide.Calendar}" Label="{x:Bind Model.Text.Get('inspector', 'created'), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Model.CreatedText, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" ToolTipService.ToolTip="{x:Bind Model.CreatedText, Mode=OneWay}" />
                                    </controls:Field>
                                    <controls:Field Glyph="{x:Bind icons:Lucide.Wrench}" Label="{x:Bind Model.Text.Get('inspector', 'creator'), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind Model.CreatorText, Mode=OneWay}" Style="{StaticResource InspectorFormValueStyle}" ToolTipService.ToolTip="{x:Bind Model.CreatorText, Mode=OneWay}" />
                                    </controls:Field>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="Files" Visibility="Collapsed">
                    <ContentPresenter x:Name="FileContent" Visibility="{x:Bind Model.HasFiles, Mode=OneWay}" />
                    <TextBlock x:Name="WaitingMetadata" Text="{x:Bind Model.Text.Get('pieces', 'metadata'), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind local:InspectorForm.Hidden(Model.HasFiles), Mode=OneWay}" />
                </Grid>
                <table:Table x:Name="Peers" Visibility="Collapsed" ShowsFitButton="True" ItemsSource="{x:Bind Model.Peers, Mode=OneWay}">
                    <table:Table.EmptyContent><TextBlock x:Name="NoPeers" Text="{x:Bind Model.Text.Get('peers', 'empty'), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" /></table:Table.EmptyContent>
                    <table:Table.Columns>
                        <table:Column x:Name="EndpointColumn" Id="endpoint" Width="220" CanHide="False"><table:Column.CellTemplate><DataTemplate x:DataType="models:Peer"><TextBlock Text="{x:Bind Endpoint}" VerticalAlignment="Center" FlowDirection="LeftToRight" /></DataTemplate></table:Column.CellTemplate></table:Column>
                        <table:Column x:Name="ClientColumn" Id="client" Width="180"><table:Column.CellTemplate><DataTemplate x:DataType="models:Peer"><TextBlock Text="{x:Bind Client, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DataTemplate></table:Column.CellTemplate></table:Column>
                        <table:Column x:Name="ConnectionColumn" Id="connection" Width="220"><table:Column.CellTemplate><DataTemplate x:DataType="models:Peer"><TextBlock Text="{x:Bind ConnectionText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                        <table:Column x:Name="PeerProgressColumn" Id="progress" Width="100" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Peer"><TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                        <table:Column x:Name="PeerDownColumn" Id="down" Width="120" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Peer"><TextBlock Text="{x:Bind DownloadText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                        <table:Column x:Name="PeerUpColumn" Id="up" Width="120" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Peer"><TextBlock Text="{x:Bind UploadText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                        <table:Column x:Name="PeerDownloadedColumn" Id="downloaded" Width="120" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Peer"><TextBlock Text="{x:Bind DownloadedText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                        <table:Column x:Name="PeerUploadedColumn" Id="uploaded" Width="120" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Peer"><TextBlock Text="{x:Bind UploadedText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                    </table:Table.Columns>
                </table:Table>
                <Grid x:Name="Trackers" Visibility="Collapsed" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:InspectorForm.Hidden(Model.IsEditingTrackers), Mode=OneWay}"><controls:ActionButton Glyph="{x:Bind icons:Lucide.Pencil}" ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'edit_tip'), Mode=OneWay}" x:Name="EditTrackers" Text="{x:Bind Model.Text.Get('trackers', 'edit'), Mode=OneWay}" Command="{x:Bind Model.EditTrackers}" /><controls:ActionButton Glyph="{x:Bind icons:Lucide.RadioTower}" ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'reannounce_tip'), Mode=OneWay}" x:Name="Reannounce" Text="{x:Bind Model.Text.Get('trackers', 'reannounce'), Mode=OneWay}" Command="{x:Bind Model.Reannounce}" /></StackPanel>
                    <table:Table x:Name="TrackerTable" Grid.Row="1" ShowsFitButton="True" ItemsSource="{x:Bind Model.Trackers, Mode=OneWay}" Visibility="{x:Bind local:InspectorForm.Hidden(Model.IsEditingTrackers), Mode=OneWay}">
                        <table:Table.EmptyContent><TextBlock x:Name="NoTrackers" Text="{x:Bind Model.Text.Get('trackers', 'empty'), Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" /></table:Table.EmptyContent>
                        <table:Table.Columns>
                            <table:Column x:Name="UrlColumn" Id="url" Width="320" CanHide="False"><table:Column.CellTemplate><DataTemplate x:DataType="models:Tracker"><TextBlock Text="{x:Bind Url}" VerticalAlignment="Center" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" /></DataTemplate></table:Column.CellTemplate></table:Column>
                            <table:Column x:Name="TierColumn" Id="tier" Width="64" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Tracker"><TextBlock Text="{x:Bind TierText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                            <table:Column x:Name="TrackerStatusColumn" Id="status" Width="120"><table:Column.CellTemplate><DataTemplate x:DataType="models:Tracker"><TextBlock Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                            <table:Column x:Name="SeedsColumn" Id="seeds" Width="90" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Tracker"><TextBlock Text="{x:Bind SeedsText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                            <table:Column x:Name="LeechersColumn" Id="leechers" Width="90" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Tracker"><TextBlock Text="{x:Bind LeechersText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                            <table:Column x:Name="CompletedColumn" Id="completed" Width="100" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="models:Tracker"><TextBlock Text="{x:Bind DownloadedText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                            <table:Column x:Name="NextColumn" Id="next" Width="140"><table:Column.CellTemplate><DataTemplate x:DataType="models:Tracker"><TextBlock Text="{x:Bind NextText, Mode=OneWay}" VerticalAlignment="Center" /></DataTemplate></table:Column.CellTemplate></table:Column>
                            <table:Column x:Name="MessageColumn" Id="message" Width="280"><table:Column.CellTemplate><DataTemplate x:DataType="models:Tracker"><TextBlock Text="{x:Bind Message, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DataTemplate></table:Column.CellTemplate></table:Column>
                        </table:Table.Columns>
                    </table:Table>
                    <Grid x:Name="TrackerEditor" Grid.RowSpan="2" RowSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}" Visibility="{x:Bind Model.IsEditingTrackers, Mode=OneWay}">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBox x:Name="TrackerInput" Text="{x:Bind Model.TrackerInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" IsEnabled="{x:Bind local:InspectorForm.Not(Model.IsPending), Mode=OneWay}" FlowDirection="LeftToRight"
                            ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'hint'), Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Model.Text.Get('trackers', 'hint'), Mode=OneWay}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><controls:ActionButton Glyph="{x:Bind icons:Lucide.Save}" ToolTipService.ToolTip="{x:Bind Model.Text.Get('trackers', 'save_tip'), Mode=OneWay}" x:Name="SaveTrackers" Text="{x:Bind Model.Text.Get('trackers', 'save'), Mode=OneWay}" IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}" /><controls:ActionButton Glyph="{x:Bind icons:Lucide.X}" x:Name="CancelTrackers" Text="{x:Bind Model.Text.Get('add', 'cancel'), Mode=OneWay}" Command="{x:Bind Model.CancelTrackers}" /></StackPanel>
                    </Grid>
                </Grid>
                <controls:SpeedGraph x:Name="Speed" Visibility="Collapsed" Samples="{x:Bind Model.History, Mode=OneWay}" />
                <controls:PiecesMap x:Name="Map" Visibility="Collapsed" />
            </Grid>
            <InfoBar VerticalAlignment="Bottom" IsClosable="False" Severity="Error" IsOpen="{x:Bind Model.HasError, Mode=OneWay}" Message="{x:Bind Model.Message, Mode=OneWay}">
                <InfoBar.ActionButton><controls:ActionButton Glyph="{x:Bind icons:Lucide.RotateCw}" ToolTipService.ToolTip="{x:Bind Model.RetryToolTip, Mode=OneWay}" x:Name="Retry" Text="{x:Bind Model.Text.Get('inspector', 'retry'), Mode=OneWay}" Command="{x:Bind Model.Retry}" /></InfoBar.ActionButton>
            </InfoBar>
        </Grid>
    </Grid>
</UserControl>
