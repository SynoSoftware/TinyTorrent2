                      Unit="{x:Bind Model.Text.Get('units', 'mebibytes'), Mode=OneWay}"
                      Header="{x:Bind Model.DiskBuffer.Label, Mode=OneWay}"
                      Error="{x:Bind Model.DiskBuffer.Message, Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('settings', 'disk_buffer_hint'), Mode=OneWay}"
                    >
                      <TextBox
                        InputScope="Number"
