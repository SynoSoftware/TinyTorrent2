                        Tag="{x:Bind Model.RefreshInterval}"
                        Text="{x:Bind Model.RefreshInterval.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind Model.RefreshInterval.CanEdit, Mode=OneWay}"
