                    </controls:SettingsRow>
                    <controls:SettingsRow
                      IsAdvanced="True"
                      Header="{x:Bind Model.Pex.Label, Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('settings', 'pex_hint'), Mode=OneWay}"
                      Error="{x:Bind Model.Pex.Message, Mode=OneWay}"
