                    >
                      <ToggleSwitch
                        Tag="{x:Bind Model.Lsd}"
                        IsOn="{x:Bind Model.Lsd.IsOn, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.Lsd.CanEdit, Mode=OneWay}"
                        Toggled="OnToggle"
                        AutomationProperties.Name="{x:Bind Model.Lsd.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="Lsd"
                      />
                    </controls:SettingsRow>
                  </StackPanel>
                </controls:SettingsSection>
                <controls:SettingsSection x:Name="IncomingSection"
                  Summary="{x:Bind Model.IncomingSummary, Mode=OneWay}"
                  Header="{x:Bind Model.Text.Get('settings', 'incoming_connections'), Mode=OneWay}"
                  Glyph="{x:Bind icons:Lucide.Network}" IsAdvanced="True">
                  <StackPanel>
                    <controls:SettingsRow
                      x:Name="PortRow"
                      IsAdvanced="True"
                      Header="{x:Bind Model.Port.Label, Mode=OneWay}"
                      Error="{x:Bind Model.Port.Message, Mode=OneWay}"
                      Description="{x:Bind Model.PortHint, Mode=OneWay}"
                    >
                      <TextBox
                        InputScope="Number"
                        Width="160"
                        Tag="{x:Bind Model.Port}"
                        Text="{x:Bind Model.Port.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind Model.Port.CanEdit, Mode=OneWay}"
                        Loaded="OnTextLoaded"
                        PreviewKeyDown="OnFieldKey"
                        LostFocus="OnFieldDeparture"
                        AutomationProperties.Name="{x:Bind Model.Port.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="ListenPort"
                      />
                    </controls:SettingsRow>
                    <controls:SettingsRow
                      x:Name="MappingRow"
                      IsAdvanced="True"
                      Header="{x:Bind Model.PortMapping.Label, Mode=OneWay}"
                      Error="{x:Bind Model.PortMapping.Message, Mode=OneWay}"
                      Description="{x:Bind Model.MappingHint, Mode=OneWay}"
