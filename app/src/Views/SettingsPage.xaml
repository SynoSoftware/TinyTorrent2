                      Header="{x:Bind Model.RefreshInterval.Label, Mode=OneWay}"
                      Error="{x:Bind Model.RefreshInterval.Message, Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('settings', 'refresh_interval_hint'), Mode=OneWay}"
                      Unit="{x:Bind Model.Text.Get('units', 'milliseconds'), Mode=OneWay}"
                    >
                      <TextBox
                        InputScope="Number"
