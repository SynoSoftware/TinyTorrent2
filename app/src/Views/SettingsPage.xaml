<UserControl
  x:Class="Syno.TinyTorrent.Views.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="using:Syno"
  xmlns:local="using:Syno.TinyTorrent.Views"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <x:Double x:Key="SettingsMarkOpacity">0.04</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <x:Double x:Key="SettingsMarkOpacity">0.03</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <x:Double x:Key="SettingsMarkOpacity">0</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="SettingsMarkStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="320" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorSecondaryBrush}" />
        <Setter Property="Opacity" Value="{ThemeResource SettingsMarkOpacity}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>
      <Style x:Key="SettingsIndexCardStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="MinHeight" Value="130" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="Root">
    <!-- Owner ruling: the page shows the window's acrylic and keeps the two
             gear marks. See Settings in docs/interface.md. -->
    <FontIcon
      Style="{StaticResource SettingsMarkStyle}"
      FontFamily="{x:Bind icons:Lucide.Font}"
      Glyph="{x:Bind icons:Lucide.Cog}"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Margin="-120,-100,0,0"
    />
    <FontIcon
      Style="{StaticResource SettingsMarkStyle}"
      FontFamily="{x:Bind icons:Lucide.Font}"
      Glyph="{x:Bind icons:Lucide.Cog}"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Margin="0,0,-160,-140"
    />
      <Grid x:Name="PageContent" Margin="16,16,16,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <Grid ColumnSpacing="16" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="PageTitle"
              Style="{StaticResource TinyTorrentPageTitleTextStyle}"
              AutomationProperties.HeadingLevel="Level1"
            />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock x:Name="AdvancedLabel" Style="{StaticResource TinyTorrentBodyTextStyle}" />
              <ToggleSwitch
                x:Name="AdvancedSwitch"
                Toggled="OnAdvanced"
                OnContent="{x:Bind Model.OnText, Mode=OneWay}"
                OffContent="{x:Bind Model.OffText, Mode=OneWay}"
              />
            </StackPanel>
          </Grid>
            <SelectorBar
              x:Name="Categories"
              Visibility="Collapsed"
              Margin="0,0,0,8"
              SelectionChanged="OnCategory"
              AutomationProperties.AutomationId="SettingsCategories"
            >
              <SelectorBarItem
                x:Name="GeneralCategory"
                Tag="General"
                AutomationProperties.AutomationId="GeneralCategory"
              >
                <SelectorBarItem.Icon>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.Settings}"
                    FontSize="16"
                  />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
              <SelectorBarItem
                x:Name="TransfersCategory"
                Tag="Transfers"
                AutomationProperties.AutomationId="TransfersCategory"
              >
                <SelectorBarItem.Icon>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.ArrowDownUp}"
                    FontSize="16"
                  />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
              <SelectorBarItem
                x:Name="LimitsCategory"
                Tag="Limits"
                AutomationProperties.AutomationId="LimitsCategory"
              >
                <SelectorBarItem.Icon>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.Gauge}"
                    FontSize="16"
                  />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
              <SelectorBarItem
                x:Name="AppearanceCategory"
                Tag="Appearance"
                AutomationProperties.AutomationId="AppearanceCategory"
              >
                <SelectorBarItem.Icon>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.Palette}"
                    FontSize="16"
                  />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
              <SelectorBarItem
                x:Name="NetworkCategory"
                Tag="Network"
                AutomationProperties.AutomationId="NetworkCategory"
              >
                <SelectorBarItem.Icon>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.Network}"
                    FontSize="16"
                  />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
              <SelectorBarItem
                x:Name="ScheduleCategory"
                Tag="Schedule"
                AutomationProperties.AutomationId="ScheduleCategory"
              >
                <SelectorBarItem.Icon>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.CalendarClock}"
                    FontSize="16"
                  />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
              <SelectorBarItem x:Name="SubtitlesCategory" Tag="SubtitlesContent"
                AutomationProperties.AutomationId="SubtitlesCategory">
                <SelectorBarItem.Icon>
                  <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Captions}" FontSize="16" />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
              <SelectorBarItem
                x:Name="AdvancedCategory"
                Tag="Advanced"
                AutomationProperties.AutomationId="AdvancedCategory"
              >
                <SelectorBarItem.Icon>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.Wrench}"
                    FontSize="16"
                  />
                </SelectorBarItem.Icon>
              </SelectorBarItem>
            </SelectorBar>
        </StackPanel>
        <ScrollViewer
          x:Name="Body"
          Grid.Row="1"
          HorizontalScrollMode="Disabled"
          HorizontalScrollBarVisibility="Disabled"
        >
          <Grid Margin="0,8,0,32">
            <Grid x:Name="BodyContent">
              <StackPanel x:Name="IndexContent">
                <StackPanel.ChildrenTransitions>
                  <TransitionCollection>
                    <AddDeleteThemeTransition />
                  </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <Grid x:Name="SubtitleHelp" Margin="0,0,0,16">
                  <Button x:Name="SubtitleSetup" Style="{StaticResource SettingsIndexCardStyle}" Click="OnSubtitleSetup">
                    <Grid ColumnSpacing="12" RowSpacing="8" Margin="0,0,32,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Captions}"
                        Style="{StaticResource TinyTorrentGroupIconStyle}" />
                      <TextBlock x:Name="SubtitleTitle" Grid.Column="1"
                        Style="{StaticResource TinyTorrentGroupTitleTextStyle}" />
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                        <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.ArrowRight}"
                          Style="{StaticResource TinyTorrentGroupIconStyle}" />
                        <TextBlock x:Name="SubtitleCue" Style="{StaticResource TinyTorrentBodyTextStyle}"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button x:Name="SubtitleDismiss" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="8" Style="{StaticResource TinyTorrentSubtleButtonStyle}" Click="OnSubtitleDismiss">
                    <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.X}" />
                  </Button>
                </Grid>
                <Grid x:Name="CategoryIndex" ColumnSpacing="14" RowSpacing="14" Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                </Grid>
              </StackPanel>
          <Grid x:Name="CategoryContent">
            <ContentControl x:Name="SubtitlesContent" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />
            <StackPanel x:Name="General" Spacing="16" Visibility="Collapsed">

              <controls:SettingsSection
                x:Name="IntegrationSection"
                Glyph="{x:Bind icons:Lucide.AppWindow}"
              >
                <StackPanel>
                  <controls:SettingsRow
                    x:Name="HandlersRow"
                    Caution="{x:Bind Model.HandlersCaution, Mode=OneWay}"
                    Error="{x:Bind Model.HandlersMessage, Mode=OneWay}"
                    Description="{x:Bind Model.DefaultsMessage, Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.HandlersRegistered, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      x:Name="Handlers"
                      IsOn="{x:Bind Model.HandlersRegistered, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.CanRegister, Mode=OneWay}"
                      Toggled="OnHandlers"
                      AutomationProperties.AutomationId="Handlers"
                    />
                    <controls:SettingsRow.Detail>
                      <controls:SettingsRow
                        Header="{x:Bind Model.Text.Get('settings', 'defaults_settings'), Mode=OneWay}"
                        Description="{x:Bind Model.DefaultsMessage, Mode=OneWay}"
                      >
                        <controls:ActionButton
                          x:Name="OpenDefaults"
                          Text="{x:Bind Model.DefaultsText, Mode=OneWay}"
                          Glyph="{x:Bind Model.DefaultsGlyph, Mode=OneWay}"
                          Command="{x:Bind Model.OpenDefaults}"
                          IsEnabled="{x:Bind Model.NeedsDefaults, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Model.DefaultsAction, Mode=OneWay}"
                          AutomationProperties.AutomationId="OpenDefaults"
                        />
                      </controls:SettingsRow>
                    </controls:SettingsRow.Detail>
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    x:Name="SignInRow"
                    Caution="{x:Bind Model.StartupOtherMessage, Mode=OneWay}"
                    Error="{x:Bind Model.StartupMessage, Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.Startup, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      x:Name="Startup"
                      IsOn="{x:Bind Model.Startup, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.CanRegister, Mode=OneWay}"
                      Toggled="OnStartup"
                      AutomationProperties.AutomationId="Startup"
                    />
                    <controls:SettingsRow.Detail>
                      <controls:SettingsRow x:Name="StartupActionRow" Header="{x:Bind Model.StartupAction, Mode=OneWay}"
                        Description="{x:Bind Model.StartupTip, Mode=OneWay}">
                        <controls:ActionButton
                          x:Name="StartupSettings"
                          Text="{x:Bind Model.StartupText, Mode=OneWay}"
                          Glyph="{x:Bind Model.StartupGlyph, Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Model.StartupTip, Mode=OneWay}"
                          Command="{x:Bind Model.OpenStartup}"
                          AutomationProperties.AutomationId="StartupSettings"
                        />
                      </controls:SettingsRow>
                    </controls:SettingsRow.Detail>
                  </controls:SettingsRow>
                </StackPanel>
              </controls:SettingsSection>
              <controls:SettingsSection
                x:Name="NotificationsSection"
                Glyph="{x:Bind icons:Lucide.Bell}"
              >
                <StackPanel>
                  <controls:SettingsRow
                    Header="{x:Bind Model.ProblemNotifications.Label, Mode=OneWay}"
                    Error="{x:Bind Model.ProblemNotifications.Message, Mode=OneWay}"
                    Description="{x:Bind Model.Text.Get('settings', 'notifications_hint'), Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.ProblemNotifications.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.ProblemNotifications}"
                      IsOn="{x:Bind Model.ProblemNotifications.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.ProblemNotifications.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.ProblemNotifications.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="ProblemNotifications"
                    />
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    Header="{x:Bind Model.FinishedNotifications.Label, Mode=OneWay}"
                    Error="{x:Bind Model.FinishedNotifications.Message, Mode=OneWay}"
                    Description="{x:Bind Model.Text.Get('settings', 'notifications_hint'), Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.FinishedNotifications.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.FinishedNotifications}"
                      IsOn="{x:Bind Model.FinishedNotifications.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.FinishedNotifications.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.FinishedNotifications.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="FinishedNotifications"
                    />
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    Header="{x:Bind Model.AddedNotifications.Label, Mode=OneWay}"
                    Error="{x:Bind Model.AddedNotifications.Message, Mode=OneWay}"
                    Description="{x:Bind Model.Text.Get('settings', 'notifications_hint'), Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.AddedNotifications.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.AddedNotifications}"
                      IsOn="{x:Bind Model.AddedNotifications.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.AddedNotifications.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.AddedNotifications.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="AddedNotifications"
                    />
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    Header="{x:Bind Model.BackgroundNotifications.Label, Mode=OneWay}"
                    Error="{x:Bind Model.BackgroundNotifications.Message, Mode=OneWay}"
                    Description="{x:Bind Model.Text.Get('settings', 'notifications_hint'), Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.BackgroundNotifications.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.BackgroundNotifications}"
                      IsOn="{x:Bind Model.BackgroundNotifications.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.BackgroundNotifications.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.BackgroundNotifications.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="BackgroundNotifications"
                    />
                  </controls:SettingsRow>
                </StackPanel>
              </controls:SettingsSection>
              <controls:SettingsSection
                x:Name="LifecycleSection"
                Glyph="{x:Bind icons:Lucide.Rocket}"
              >
                <StackPanel>
                  <controls:SettingsRow
                    x:Name="TrayRow"
                    Header="{x:Bind Model.StartInTray.Label, Mode=OneWay}"
                    Error="{x:Bind Model.StartInTray.Message, Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.StartInTray.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.StartInTray}"
                      IsOn="{x:Bind Model.StartInTray.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.StartInTray.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.StartInTray.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="StartInTray"
                    />
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    IsAdvanced="True"
                    Header="{x:Bind Model.ShowSplash.Label, Mode=OneWay}"
                    Error="{x:Bind Model.ShowSplash.Message, Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.ShowSplash.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.ShowSplash}"
                      IsOn="{x:Bind Model.ShowSplash.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.ShowSplash.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.ShowSplash.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="ShowSplash"
                    />
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    IsAdvanced="True"
                    Header="{x:Bind Model.StartPaused.Label, Mode=OneWay}"
                    Error="{x:Bind Model.StartPaused.Message, Mode=OneWay}"
                    Description="{x:Bind Model.Text.Get('settings', 'start_paused_hint'), Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.StartPaused.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.StartPaused}"
                      IsOn="{x:Bind Model.StartPaused.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.StartPaused.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.StartPaused.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="StartPaused"
                    />
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    Header="{x:Bind Model.ConfirmExit.Label, Mode=OneWay}"
                    Error="{x:Bind Model.ConfirmExit.Message, Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.ConfirmExit.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.ConfirmExit}"
                      IsOn="{x:Bind Model.ConfirmExit.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.ConfirmExit.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.ConfirmExit.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="ConfirmExit"
                    />
                  </controls:SettingsRow>
                </StackPanel>
              </controls:SettingsSection>
              <controls:SettingsSection
                x:Name="PowerSection"
                Glyph="{x:Bind icons:Lucide.PlugZap}"
              >
                <StackPanel>
                  <controls:SettingsRow
                    Header="{x:Bind Model.PreventSleep.Label, Mode=OneWay}"
                    Error="{x:Bind Model.PreventSleep.Message, Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.PreventSleep.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.PreventSleep}"
                      IsOn="{x:Bind Model.PreventSleep.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.PreventSleep.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.PreventSleep.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="PreventSleep"
                    />
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    Margin="36,0,0,0"
                    Header="{x:Bind Model.Text.Get('settings', 'also_seeding'), Mode=OneWay}"
                    Error="{x:Bind Model.SeedingSleep.Message, Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.SeedingSleep.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.SeedingSleep}"
                      IsOn="{x:Bind Model.SeedingSleep.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.SeedingSleep.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.SeedingSleep.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="SeedingSleep"
                    />
                  </controls:SettingsRow>
                </StackPanel>
              </controls:SettingsSection>
              <controls:SettingsSection
                x:Name="UpdatesSection"
                Glyph="{x:Bind icons:Lucide.RefreshCw}"
              >
                <StackPanel>
                  <controls:SettingsRow
                    Header="{x:Bind Model.Updates.Label, Mode=OneWay}"
                    Error="{x:Bind Model.Updates.Message, Mode=OneWay}"
                    StateText="{x:Bind controls:SettingsRow.State(Model.Updates.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                  >
                    <ToggleSwitch
                      Tag="{x:Bind Model.Updates}"
                      IsOn="{x:Bind Model.Updates.IsOn, Mode=OneWay}"
                      IsEnabled="{x:Bind Model.Updates.CanEdit, Mode=OneWay}"
                      Toggled="OnToggle"
                      AutomationProperties.Name="{x:Bind Model.Updates.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="CheckUpdates"
                    />
                  </controls:SettingsRow>
                </StackPanel>
              </controls:SettingsSection>

              <controls:SettingsSection Header="{x:Bind Model.Text.Get('library', 'title'), Mode=OneWay}"
                Glyph="{x:Bind icons:Lucide.Film}">
                <StackPanel>
                <controls:SettingsRow x:Name="ProviderRow" Header="{x:Bind Main.Library.ProviderLabel, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ProviderChoice"
                      SelectionChanged="OnProvider" IsEnabled="{x:Bind Main.Library.IsAvailable, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Main.Library.ProviderLabel, Mode=OneWay}" />
                    <controls:ActionButton Text="{x:Bind Model.Text.Get('settings', 'edit'), Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind Model.Text.Get('library', 'configure_tip'), Mode=OneWay}"
                      Glyph="{x:Bind icons:Lucide.Pencil}" Command="{x:Bind Main.Library.ConfigureProvider}" />
                  </StackPanel>
                </controls:SettingsRow>
                <controls:SettingsRow Header="{x:Bind Main.Library.InformationLabel, Mode=OneWay}"
                  StateText="{x:Bind controls:SettingsRow.State(Main.Library.IsEnrichmentEnabled, Model.OnText, Model.OffText), Mode=OneWay}">
                  <controls:ActionButton x:Name="VideoInformation" Text="{x:Bind Main.Library.InformationAction, Mode=OneWay}" Glyph="{x:Bind icons:Lucide.Film}"
                    ToolTipService.ToolTip="{x:Bind Main.Library.InformationTip, Mode=OneWay}"
                    Command="{x:Bind Main.Library.Enable}" AutomationProperties.AutomationId="VideoInformation" />
                </controls:SettingsRow>
                </StackPanel>
              </controls:SettingsSection>
            </StackPanel>
            <StackPanel x:Name="Transfers" Spacing="16" Visibility="Collapsed">
              <controls:SettingsSection
                x:Name="DownloadsSection"
                Glyph="{x:Bind icons:Lucide.FolderDown}"
              >
                <StackPanel>
                  <controls:SettingsRow
                    Header="{x:Bind Model.UseLastFolder.Label, Mode=OneWay}"
                    Error="{x:Bind Model.UseLastFolder.Message, Mode=OneWay}"
                    Description="{x:Bind Model.Text.Get('settings', 'use_last_folder_hint'), Mode=OneWay}"
                  >
                    <ComboBox
                      Width="280"
                      Tag="{x:Bind Model.UseLastFolder}"
                      Loaded="OnChoiceLoaded"
                      SelectionChanged="OnChoice"
                      IsEnabled="{x:Bind Model.UseLastFolder.CanEdit, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind Model.UseLastFolder.Label, Mode=OneWay}"
                      AutomationProperties.AutomationId="UseLastFolder"
                    >
                      <ComboBoxItem Content="{x:Bind Model.Text.Get('settings', 'default_folder'), Mode=OneWay}">
                        <ComboBoxItem.Tag>
                          <x:Boolean>False</x:Boolean>
                        </ComboBoxItem.Tag>
                      </ComboBoxItem>
                      <ComboBoxItem Content="{x:Bind Model.Text.Get('settings', 'last_folder'), Mode=OneWay}">
                        <ComboBoxItem.Tag>
                          <x:Boolean>True</x:Boolean>
                        </ComboBoxItem.Tag>
                      </ComboBoxItem>
                    </ComboBox>
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    Header="{x:Bind Model.Destination.Label, Mode=OneWay}"
                    Error="{x:Bind Model.Destination.Message, Mode=OneWay}"
                  >
                      <Grid Width="360" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                          x:Name="Destination"
                          Tag="{x:Bind Model.Destination}"
                          FlowDirection="LeftToRight"
                          Text="{x:Bind Model.Destination.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{x:Bind Model.Destination.CanEdit, Mode=OneWay}"
                          PreviewKeyDown="OnFieldKey"
                          LostFocus="OnFieldDeparture"
                          AutomationProperties.Name="{x:Bind Model.Destination.Label, Mode=OneWay}"
                          AutomationProperties.HelpText="{x:Bind Model.Destination.Message, Mode=OneWay}"
                          AutomationProperties.AutomationId="DefaultDestination"
                        />
                        <controls:ActionButton
                          x:Name="Browse"
                          Tag="{x:Bind Model.Destination}"
                          Grid.Column="1"
                          Glyph="{x:Bind icons:Lucide.FolderSearch}"
                          Text="{x:Bind Model.Text.Get('add', 'browse'), Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('add', 'browse_tip'), Mode=OneWay}"
                          Click="OnFolder"
                          IsEnabled="{x:Bind Model.Destination.CanEdit, Mode=OneWay}"
                          AutomationProperties.AutomationId="BrowseDestination"
                        />
                      </Grid>
                  </controls:SettingsRow>
                  <controls:SettingsRow
                    Header="{x:Bind Model.UseIncompleteFolder.Label, Mode=OneWay}"
                    Error="{x:Bind Model.UseIncompleteFolder.Message, Mode=OneWay}"
