<UserControl
  x:Class="Syno.TinyTorrent.Views.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="using:Syno"
  xmlns:local="using:Syno.TinyTorrent.Views"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <x:Double x:Key="SettingsMarkOpacity">0.04</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <x:Double x:Key="SettingsMarkOpacity">0.03</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <x:Double x:Key="SettingsMarkOpacity">0</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="SettingsMarkStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="320" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorSecondaryBrush}" />
        <Setter Property="Opacity" Value="{ThemeResource SettingsMarkOpacity}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>
      <Style x:Key="SettingsHomeLinkStyle" TargetType="Button" BasedOn="{StaticResource TinyTorrentSettingsLinkStyle}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style x:Key="SettingsHomeGroupStyle" TargetType="controls:SettingsSection" BasedOn="{StaticResource TinyTorrentSettingsGroupStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:SettingsSection">
              <Border x:Name="Card" Style="{StaticResource TinyTorrentSettingsCardStyle}" Padding="0">
                <StackPanel>
                  <Border Padding="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource SubtitleTextBlockStyle}"
                      TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{TemplateBinding Header}"
                      AutomationProperties.HeadingLevel="Level2" />
                  </Border>
                  <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="Stretch" />
                </StackPanel>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="Root">
    <!-- Owner ruling: the page shows the window's acrylic and keeps the two
             gear marks. See Settings in docs/interface.md. -->
    <FontIcon
      Style="{StaticResource SettingsMarkStyle}"
      FontFamily="{x:Bind icons:Lucide.Font}"
      Glyph="{x:Bind icons:Lucide.Cog}"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Margin="-120,-100,0,0"
    />
    <FontIcon
      Style="{StaticResource SettingsMarkStyle}"
      FontFamily="{x:Bind icons:Lucide.Font}"
      Glyph="{x:Bind icons:Lucide.Cog}"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Margin="0,0,-160,-140"
    />
    <NavigationView
      x:Name="Categories"
      PaneDisplayMode="Auto"
      OpenPaneLength="264"
      CompactPaneLength="64"
      CompactModeThresholdWidth="0"
      ExpandedModeThresholdWidth="1100"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="False"
      IsSettingsVisible="False"
      IsPaneOpen="True"
      SelectionChanged="OnCategory"
      AutomationProperties.AutomationId="SettingsCategories"
    >
      <NavigationView.Resources>
        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <StaticResource x:Key="NavigationViewItemOnLeftIconBoxHeight" ResourceKey="TinyTorrentSurfaceIconSize" />
      </NavigationView.Resources>
      <NavigationView.PaneHeader>
        <Button x:Name="Brand" Command="{x:Bind Main.ReturnWorkspace, Mode=OneWay}"
          Style="{StaticResource DefaultButtonStyle}"
          Margin="8,16,8,24" Padding="0" MinWidth="0" HorizontalAlignment="Stretch"
          Background="{ThemeResource SubtleFillColorTransparentBrush}" BorderThickness="0"
          HorizontalContentAlignment="Left" AutomationProperties.AutomationId="SettingsBrand"
          AutomationProperties.Name="{x:Bind Main.ReturnText, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Main.ReturnText, Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="ms-appx:///Assets/tinyTorrent.svg" Width="40" Height="40" />
            <TextBlock Text="TinyTorrent" Style="{StaticResource TinyTorrentGroupTitleTextStyle}" VerticalAlignment="Center"
              Visibility="{x:Bind Categories.IsPaneOpen, Mode=OneWay}" />
          </StackPanel>
        </Button>
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
          <NavigationViewItem x:Name="HomeCategory" Tag="Home" />
          <NavigationViewItem
            x:Name="GeneralCategory"
            Tag="General"
            AutomationProperties.AutomationId="GeneralCategory"
          />
          <NavigationViewItem
            x:Name="TransfersCategory"
            Tag="Transfers"
            AutomationProperties.AutomationId="TransfersCategory"
          />
          <NavigationViewItem
            x:Name="LimitsCategory"
            Tag="Limits"
            AutomationProperties.AutomationId="LimitsCategory"
          />
          <NavigationViewItem
            x:Name="ScheduleCategory"
            Tag="Schedule"
            AutomationProperties.AutomationId="ScheduleCategory"
          />
          <NavigationViewItem
            x:Name="AppearanceCategory"
            Tag="Appearance"
            AutomationProperties.AutomationId="AppearanceCategory"
          />
          <NavigationViewItem
            x:Name="NetworkCategory"
            Tag="Network"
            AutomationProperties.AutomationId="NetworkCategory"
          />
          <NavigationViewItem
            x:Name="PluginsCategory"
            Tag="Plugins"
            AutomationProperties.AutomationId="PluginsCategory"
          />
          <NavigationViewItem
            x:Name="AdvancedCategory"
            Tag="Advanced"
            AutomationProperties.AutomationId="AdvancedCategory"
          />
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
          <NavigationViewItem x:Name="AdvancedMode" SelectsOnInvoked="False"
            AutomationProperties.AutomationId="AdvancedMode">
            <NavigationViewItem.Icon>
              <FontIcon x:Name="AdvancedModeIcon" FontFamily="{x:Bind icons:Lucide.Font}"
                FontSize="{StaticResource NavigationViewItemOnLeftIconBoxHeight}" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem x:Name="ReturnWorkspace" SelectsOnInvoked="False"
            AutomationProperties.Name="{x:Bind Main.ReturnText, Mode=OneWay}"
            AutomationProperties.AutomationId="ReturnWorkspace">
            <NavigationViewItem.Content>
              <TextBlock Text="{x:Bind Main.ReturnText, Mode=OneWay}"
                Style="{StaticResource TinyTorrentNavigationTextStyle}" />
            </NavigationViewItem.Content>
            <NavigationViewItem.Icon>
              <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.ArrowLeft}"
                FontSize="{StaticResource NavigationViewItemOnLeftIconBoxHeight}" />
            </NavigationViewItem.Icon>
          </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Grid x:Name="PageHost">
      <Grid x:Name="PageContent" Margin="0,16,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,0,24,24" MaxWidth="{StaticResource TinyTorrentSettingsWidth}" Spacing="16">
          <TextBlock x:Name="PageTitle" IsTextSelectionEnabled="True"
            Style="{StaticResource TinyTorrentPageTitleTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
            AutomationProperties.HeadingLevel="Level1" />
        <Grid x:Name="PageHeader"
          ColumnSpacing="24" RowSpacing="16" SizeChanged="OnHeaderSize">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid x:Name="HeaderIdentity" ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Image x:Name="PageArtwork" Width="96" Height="96" Stretch="Uniform"
              IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="IdentityTitle" IsTextSelectionEnabled="True"
                Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="PageSummary" Style="{StaticResource TinyTorrentTitleDetailTextStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
          <Grid x:Name="HeaderFacts" Grid.Column="1" ColumnSpacing="24" RowSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="FirstFact" ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <FontIcon x:Name="FirstIcon" FontFamily="{x:Bind icons:Lucide.Font}" FontSize="{StaticResource TinyTorrentHeaderIconSize}" VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="FirstCaption" Style="{StaticResource TinyTorrentTitleDetailTextStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FirstValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <Grid x:Name="SecondFact" Grid.Column="1" ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <FontIcon x:Name="SecondIcon" FontFamily="{x:Bind icons:Lucide.Font}" FontSize="{StaticResource TinyTorrentHeaderIconSize}" VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="SecondCaption" Style="{StaticResource TinyTorrentTitleDetailTextStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SecondValue" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
        </StackPanel>
      <ScrollViewer
        x:Name="Body"
        Grid.Row="1"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
      >
        <Grid Margin="24,8,24,32">
          <Grid x:Name="BodyContent" MaxWidth="{StaticResource TinyTorrentSettingsWidth}">
            <StackPanel x:Name="IndexContent" x:Load="False" Spacing="24">
              <Grid x:Name="HomeGrid" ColumnSpacing="8" RowSpacing="8" SizeChanged="OnHomeSize">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                  <controls:SettingsSection Header="{x:Bind Model.Text.Get('settings', 'home_downloads'), Mode=OneWay}"
                    Style="{StaticResource SettingsHomeGroupStyle}">
                    <StackPanel x:Name="HomeDownloads" />
                  </controls:SettingsSection>
                  <controls:SettingsSection Header="{x:Bind Model.Text.Get('settings', 'appearance'), Mode=OneWay}"
                    Style="{StaticResource SettingsHomeGroupStyle}">
                    <StackPanel>
                      <StackPanel Spacing="8" Margin="16">
                        <TextBlock Text="{x:Bind Model.Text.Get('settings', 'theme'), Mode=OneWay}" />
                        <ContentControl x:Name="HomeThemeContent" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                      </StackPanel>
                      <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                        <StackPanel x:Name="HomeAppearance" />
                      </Border>
                    </StackPanel>
                  </controls:SettingsSection>
                  <ContentControl x:Name="HomeIntegrationContent" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                </StackPanel>
                <StackPanel x:Name="HomeRight" Grid.Column="1" Spacing="8">
                  <controls:SettingsSection Header="{x:Bind Model.Text.Get('settings', 'plugins'), Mode=OneWay}"
                    Style="{StaticResource SettingsHomeGroupStyle}">
                    <StackPanel x:Name="HomeLibrary" />
                  </controls:SettingsSection>
                  <controls:SettingsSection Header="{x:Bind Model.Text.Get('settings', 'network'), Mode=OneWay}"
                    Style="{StaticResource SettingsHomeGroupStyle}">
                    <StackPanel x:Name="HomeNetwork" />
                  </controls:SettingsSection>
                  <controls:SettingsSection Header="{x:Bind Model.Text.Get('settings', 'schedule'), Mode=OneWay}"
                    Style="{StaticResource SettingsHomeGroupStyle}">
                    <StackPanel x:Name="HomeSchedule" />
                  </controls:SettingsSection>
                </StackPanel>
              </Grid>
            </StackPanel>
            <Grid x:Name="CategoryContent">
              <StackPanel x:Name="Plugins" x:Load="False" Spacing="24" Visibility="Collapsed">

                <controls:SettingsSection
                  Header="{x:Bind Model.Text.Get('settings', 'video_information'), Mode=OneWay}"
                  Glyph="{x:Bind icons:Lucide.Film}"
                  Style="{StaticResource TinyTorrentSettingsGroupStyle}"
                >
                  <StackPanel>
                    <controls:SettingsRow
                      x:Name="InformationRow"
                      Header="{x:Bind Model.Text.Get('library', 'provider'), Mode=OneWay}"
                    >
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                          x:Name="ProviderInformation"
                          Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                          Click="OnProviderInformation"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('library', 'provider_information'), Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Model.Text.Get('library', 'provider_information'), Mode=OneWay}"
                        >
                          <FontIcon
                            FontFamily="{x:Bind icons:Lucide.Font}"
                            Glyph="{x:Bind icons:Lucide.Info}"
                            FontSize="{StaticResource TinyTorrentButtonIconSize}"
                          />
                        </Button>
                        <Button
                          x:Name="ProviderKey"
                          Style="{StaticResource TinyTorrentSubtleButtonStyle}"
                          Click="OnProviderKey"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('library', 'key_tip'), Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Model.Text.Get('account', 'api_key'), Mode=OneWay}"
                          AutomationProperties.AutomationId="ProviderKey"
                        >
                          <FontIcon
                            FontFamily="{x:Bind icons:Lucide.Font}"
                            Glyph="{x:Bind icons:Lucide.KeyRound}"
                            FontSize="{StaticResource TinyTorrentButtonIconSize}"
                          />
                        </Button>
                        <ComboBox
                          x:Name="ProviderChoice"
                          Width="260"
                          SelectionChanged="OnProviderChoice"
                          IsEnabled="{x:Bind Main.Library.IsAvailable, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('library', 'information_tip'), Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Model.Text.Get('library', 'provider'), Mode=OneWay}"
                          AutomationProperties.AutomationId="VideoProvider"
                        />
                      </StackPanel>
                    </controls:SettingsRow>
                    <controls:SettingsRow
                      Header="{x:Bind Model.Text.Get('plugins', 'automatic_download'), Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('plugins', 'automatic_download_hint'), Mode=OneWay}"
                      StateText="{x:Bind controls:SettingsRow.State(AutomaticDownload.IsOn, Model.OnText, Model.OffText), Mode=OneWay}">
                      <ToggleSwitch x:Name="AutomaticDownload"
                        IsEnabled="{x:Bind Main.Library.IsAvailable, Mode=OneWay}"
                        Toggled="OnAutomaticDownload"
                        AutomationProperties.Name="{x:Bind Main.Library.DownloadLabel, Mode=OneWay}"
                        AutomationProperties.AutomationId="VideoAutomaticDownload" />
                    </controls:SettingsRow>
                    <controls:DatasetRow x:Name="ImdbRow" />
                    <controls:DatasetRow x:Name="CityRow" />
                    <controls:SettingsRow Header="{x:Bind Model.Text.Get('plugins', 'movies_with_information'), Mode=OneWay}" BorderThickness="0">
                      <TextBlock x:Name="VideoCoverage" Style="{StaticResource TinyTorrentTitleDetailTextStyle}" />
                    </controls:SettingsRow>
                  </StackPanel>
                </controls:SettingsSection>
                <ContentControl x:Name="SubtitlesContent" HorizontalContentAlignment="Stretch" />
                <controls:SettingsSection
                  Header="{x:Bind Model.Text.Get('request_protection', 'title'), Mode=OneWay}"
                  Style="{StaticResource TinyTorrentSettingsGroupStyle}">
                  <StackPanel>
                    <controls:SettingsRow x:Name="LookupsRow"
                      Header="{x:Bind Model.Text.Get('plugins', 'lookups'), Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('plugins', 'lookups_hint'), Mode=OneWay}"
                      Unit="{x:Bind Model.Text.Get('plugins', 'lookup_scope'), Mode=OneWay}">
                      <TextBox x:Name="LookupLimit" InputScope="Number" Width="160"
                        IsEnabled="{x:Bind Main.Library.IsAvailable, Mode=OneWay}"
                        Loaded="OnLookupLoaded" PreviewKeyDown="OnLookupKey" LostFocus="OnLookupDeparture"
                        ToolTipService.ToolTip="{x:Bind Model.Text.Get('plugins', 'lookups_hint'), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind Model.Text.Get('plugins', 'lookups'), Mode=OneWay}"
                        AutomationProperties.AutomationId="LookupLimit" />
                    </controls:SettingsRow>
                    <controls:SettingsRow x:Name="ProtectionRow" BorderThickness="0"
                      Header="{x:Bind Model.Text.Get('request_protection', 'reset'), Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('request_protection', 'reset_summary'), Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="ProtectionScope" Width="260" Loaded="OnProtectionLoaded"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('request_protection', 'reset_hint'), Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind Model.Text.Get('library', 'provider'), Mode=OneWay}"
                          AutomationProperties.AutomationId="ProtectionScope" />
                        <controls:ActionButton x:Name="ProtectionReset" Click="OnProtectionReset"
                          Glyph="{x:Bind icons:Lucide.RotateCcw}"
                          Text="{x:Bind Model.Text.Get('request_protection', 'reset_button'), Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind Model.Text.Get('request_protection', 'reset_hint'), Mode=OneWay}"
                          AutomationProperties.HelpText="{x:Bind Model.Text.Get('request_protection', 'reset_hint'), Mode=OneWay}"
                          AutomationProperties.AutomationId="ProtectionReset" />
                      </StackPanel>
                    </controls:SettingsRow>
                  </StackPanel>
                </controls:SettingsSection>
                <controls:SettingsExpander x:Name="DatabaseSummary" Visibility="Collapsed"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,0"
                  Expanding="OnDatabaseExpanding"
                  AutomationProperties.Name="{x:Bind Model.Text.Get('plugins', 'database'), Mode=OneWay}">
                  <controls:SettingsExpander.Header>
                    <Grid ColumnSpacing="24" MinHeight="68">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Database}"
                        Style="{StaticResource TinyTorrentGroupIconStyle}" />
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Model.Text.Get('plugins', 'database'), Mode=OneWay}" />
                        <TextBlock x:Name="DatabaseSize" Text="—"
                          Style="{StaticResource TinyTorrentTitleDetailTextStyle}" />
                      </StackPanel>
                    </Grid>
                  </controls:SettingsExpander.Header>
                  <StackPanel>
                    <controls:SettingsRow Header="{x:Bind Model.Text.Get('plugins', 'files'), Mode=OneWay}">
                      <TextBlock x:Name="LibraryFiles" Text="—" TextTrimming="CharacterEllipsis" />
                    </controls:SettingsRow>
                    <controls:SettingsRow Header="{x:Bind Model.Text.Get('plugins', 'information'), Mode=OneWay}">
                      <TextBlock x:Name="StoredInformation" Text="—" TextTrimming="CharacterEllipsis" />
                    </controls:SettingsRow>
                    <controls:SettingsRow Header="{x:Bind Model.Text.Get('plugins', 'subtitles'), Mode=OneWay}" BorderThickness="0">
                      <TextBlock x:Name="StoredSubtitles" Text="—" TextTrimming="CharacterEllipsis" />
                    </controls:SettingsRow>
                  </StackPanel>
                </controls:SettingsExpander>
              </StackPanel>
              <StackPanel x:Name="General" x:Load="False" Spacing="8" Visibility="Collapsed">
                <ContentControl x:Name="IntegrationContent" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                <controls:SettingsSection
                  x:Name="LifecycleSection" Margin="0,16,0,0"
                  Summary="{x:Bind Model.StartupSummary, Mode=OneWay}"
                  Glyph="{x:Bind icons:Lucide.Power}"
                >
                  <StackPanel>
                    <controls:SettingsRow
                      x:Name="TrayRow"
                      Header="{x:Bind Model.StartInTray.Label, Mode=OneWay}"
                      Error="{x:Bind Model.StartInTray.Message, Mode=OneWay}"
                      StateText="{x:Bind controls:SettingsRow.State(Model.StartInTray.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                    >
                      <ToggleSwitch
                        Tag="{x:Bind Model.StartInTray}"
                        IsOn="{x:Bind Model.StartInTray.IsOn, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.StartInTray.CanEdit, Mode=OneWay}"
                        Toggled="OnToggle"
                        AutomationProperties.Name="{x:Bind Model.StartInTray.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="StartInTray"
                      />
                    </controls:SettingsRow>
                    <controls:SettingsRow
                      Header="{x:Bind Model.ShowSplash.Label, Mode=OneWay}"
                      Error="{x:Bind Model.ShowSplash.Message, Mode=OneWay}"
                      StateText="{x:Bind controls:SettingsRow.State(Model.ShowSplash.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                    >
                      <ToggleSwitch
                        Tag="{x:Bind Model.ShowSplash}"
                        IsOn="{x:Bind Model.ShowSplash.IsOn, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.ShowSplash.CanEdit, Mode=OneWay}"
                        Toggled="OnToggle"
                        AutomationProperties.Name="{x:Bind Model.ShowSplash.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="ShowSplash"
                      />
                    </controls:SettingsRow>
                    <controls:SettingsRow
                      Header="{x:Bind Model.StartPaused.Label, Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('settings', 'start_paused_hint'), Mode=OneWay}"
                      Error="{x:Bind Model.StartPaused.Message, Mode=OneWay}"
                      StateText="{x:Bind controls:SettingsRow.State(Model.StartPaused.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                    >
                      <ToggleSwitch
                        Tag="{x:Bind Model.StartPaused}"
                        IsOn="{x:Bind Model.StartPaused.IsOn, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.StartPaused.CanEdit, Mode=OneWay}"
                        Toggled="OnToggle"
                        AutomationProperties.Name="{x:Bind Model.StartPaused.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="StartPaused"
                      />
                    </controls:SettingsRow>
                  </StackPanel>
                </controls:SettingsSection>
                <controls:SettingsSection
                  x:Name="NotificationsSection"
                  Glyph="{x:Bind icons:Lucide.Bell}"
                >
                  <StackPanel>
                    <controls:SettingsRow
                      Header="{x:Bind Model.ProblemNotifications.Label, Mode=OneWay}"
                      Error="{x:Bind Model.ProblemNotifications.Message, Mode=OneWay}"
                      StateText="{x:Bind controls:SettingsRow.State(Model.ProblemNotifications.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                    >
                      <ToggleSwitch
                        Tag="{x:Bind Model.ProblemNotifications}"
                        IsOn="{x:Bind Model.ProblemNotifications.IsOn, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.ProblemNotifications.CanEdit, Mode=OneWay}"
                        Toggled="OnToggle"
                        AutomationProperties.Name="{x:Bind Model.ProblemNotifications.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="ProblemNotifications"
                      />
                    </controls:SettingsRow>
                    <controls:SettingsRow
                      Header="{x:Bind Model.FinishedNotifications.Label, Mode=OneWay}"
                      Error="{x:Bind Model.FinishedNotifications.Message, Mode=OneWay}"
                      StateText="{x:Bind controls:SettingsRow.State(Model.FinishedNotifications.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                    >
                      <ToggleSwitch
                        Tag="{x:Bind Model.FinishedNotifications}"
                        IsOn="{x:Bind Model.FinishedNotifications.IsOn, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.FinishedNotifications.CanEdit, Mode=OneWay}"
                        Toggled="OnToggle"
                        AutomationProperties.Name="{x:Bind Model.FinishedNotifications.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="FinishedNotifications"
                      />
                    </controls:SettingsRow>
                    <controls:SettingsRow
                      Header="{x:Bind Model.AddedNotifications.Label, Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('settings', 'added_notifications_hint'), Mode=OneWay}"
                      Error="{x:Bind Model.AddedNotifications.Message, Mode=OneWay}"
                      StateText="{x:Bind controls:SettingsRow.State(Model.AddedNotifications.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                    >
                      <ToggleSwitch
                        Tag="{x:Bind Model.AddedNotifications}"
                        IsOn="{x:Bind Model.AddedNotifications.IsOn, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.AddedNotifications.CanEdit, Mode=OneWay}"
                        Toggled="OnToggle"
                        AutomationProperties.Name="{x:Bind Model.AddedNotifications.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="AddedNotifications"
                      />
                    </controls:SettingsRow>
                    <controls:SettingsRow
                      Header="{x:Bind Model.BackgroundNotifications.Label, Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('settings', 'background_notifications_hint'), Mode=OneWay}"
                      Error="{x:Bind Model.BackgroundNotifications.Message, Mode=OneWay}"
                      StateText="{x:Bind controls:SettingsRow.State(Model.BackgroundNotifications.IsOn, Model.OnText, Model.OffText), Mode=OneWay}"
                    >
                      <ToggleSwitch
                        Tag="{x:Bind Model.BackgroundNotifications}"
                        IsOn="{x:Bind Model.BackgroundNotifications.IsOn, Mode=OneWay}"
                        IsEnabled="{x:Bind Model.BackgroundNotifications.CanEdit, Mode=OneWay}"
                        Toggled="OnToggle"
                        AutomationProperties.Name="{x:Bind Model.BackgroundNotifications.Label, Mode=OneWay}"
