                    <controls:SettingsRow
                      IsAdvanced="True"
                      Header="{x:Bind Model.IpFamily.Label, Mode=OneWay}"
                      Description="{x:Bind Model.IpFamilyHint, Mode=OneWay}"
                      Error="{x:Bind Model.IpFamily.Message, Mode=OneWay}"
                    >
                      <ComboBox
                        Width="260"
                        Tag="{x:Bind Model.IpFamily}"
                        Loaded="OnChoiceLoaded"
                        SelectionChanged="OnChoice"
                        IsEnabled="{x:Bind Model.IpFamily.CanEdit, Mode=OneWay}"
