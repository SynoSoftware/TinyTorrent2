                        Loaded="OnTextLoaded"
                        PreviewKeyDown="OnFieldKey"
                        LostFocus="OnFieldDeparture"
                        AutomationProperties.Name="{x:Bind Model.FilePool.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="FilePool"
                      />
                    </controls:SettingsRow>
                  </StackPanel>
                </controls:SettingsSection>
                <controls:SettingsSection
                  x:Name="CheckingSection"
                  Summary="{x:Bind Model.CheckingSummary, Mode=OneWay}"
                  Glyph="{x:Bind icons:Lucide.Check}"
                >
                  <StackPanel>
                    <controls:SettingsRow
                      Unit="{x:Bind Model.Text.Get('units', 'mebibytes'), Mode=OneWay}"
                      Header="{x:Bind Model.CheckingMemory.Label, Mode=OneWay}"
                      Error="{x:Bind Model.CheckingMemory.Message, Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('settings', 'checking_memory_hint'), Mode=OneWay}"
                    >
                      <TextBox
                        InputScope="Number"
                        Width="160"
                        Tag="{x:Bind Model.CheckingMemory}"
                        Text="{x:Bind Model.CheckingMemory.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind Model.CheckingMemory.CanEdit, Mode=OneWay}"
                        Loaded="OnTextLoaded"
                        PreviewKeyDown="OnFieldKey"
                        LostFocus="OnFieldDeparture"
                        AutomationProperties.Name="{x:Bind Model.CheckingMemory.Label, Mode=OneWay}"
                        AutomationProperties.AutomationId="CheckingMemory"
                      />
                    </controls:SettingsRow>
                    <controls:SettingsRow
                      Header="{x:Bind Model.HashingThreads.Label, Mode=OneWay}"
                      Error="{x:Bind Model.HashingThreads.Message, Mode=OneWay}"
                      Description="{x:Bind Model.Text.Get('settings', 'hashing_threads_hint'), Mode=OneWay}"
                    >
                      <TextBox
                        InputScope="Number"
                        Width="160"
                        Tag="{x:Bind Model.HashingThreads}"
