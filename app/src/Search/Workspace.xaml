<UserControl
  x:Class="Syno.TinyTorrent.Search.Workspace"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Search"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:table="using:Syno.TableView"
  xmlns:icons="using:Syno"
>
  <UserControl.Resources>
    <DataTemplate x:Key="NameTemplate" x:DataType="local:Row">
      <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Tip}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon FontFamily="{ThemeResource LucideFont}" Glyph="{x:Bind Glyph}" Style="{StaticResource TinyTorrentStatusIconStyle}" AutomationProperties.AccessibilityView="Raw"/>
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource TinyTorrentIdentityTextStyle}" FlowDirection="LeftToRight"/>
        <FontIcon Grid.Column="2" FontFamily="{ThemeResource LucideFont}" Glyph="{x:Bind icons:Lucide.CircleHelp}" Style="{StaticResource TinyTorrentStatusIconStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowsUnverified}" ToolTipService.ToolTip="{x:Bind UnverifiedTip}" AutomationProperties.Name="{x:Bind UnverifiedTip}"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SizeTemplate" x:DataType="local:Row"><TextBlock Text="{x:Bind Size}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate>
    <DataTemplate x:Key="SourcesTemplate" x:DataType="local:Row"><TextBlock Text="{x:Bind Sources}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate>
    <DataTemplate x:Key="SeedsTemplate" x:DataType="local:Row"><TextBlock Text="{x:Bind Seeds}" ToolTipService.ToolTip="{x:Bind EstimateTip}" AutomationProperties.HelpText="{x:Bind EstimateTip}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate>
    <DataTemplate x:Key="PeersTemplate" x:DataType="local:Row"><TextBlock Text="{x:Bind Peers}" ToolTipService.ToolTip="{x:Bind EstimateTip}" AutomationProperties.HelpText="{x:Bind EstimateTip}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate>
    <DataTemplate x:Key="ObservedTemplate" x:DataType="local:Row"><TextBlock Text="{x:Bind Observed}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate>
    <DataTemplate x:Key="FileTemplate" x:DataType="local:Row">
      <controls:ActionButton Text="{x:Bind DownloadText}" Glyph="{x:Bind icons:Lucide.Download}" Command="{x:Bind DownloadFile}" Visibility="{x:Bind ShowsFile}" ToolTipService.ToolTip="{x:Bind FileTip}" Padding="8,4"/>
    </DataTemplate>
    <DataTemplate x:Key="TorrentTemplate" x:DataType="local:Row">
      <controls:ActionButton Text="{x:Bind DownloadText}" Glyph="{x:Bind icons:Lucide.Download}" Command="{x:Bind DownloadTorrent}" ToolTipService.ToolTip="{x:Bind TorrentTip}" Padding="8,4"/>
    </DataTemplate>
  </UserControl.Resources>
  <Grid x:Name="Surface">
    <table:Table x:Name="Results" SortMode="External" ItemsSource="{x:Bind Model.Rows, Mode=OneWay}" Visibility="{x:Bind Model.HasRows, Mode=OneWay}" AutomationProperties.Name="{x:Bind Model.Text.Get('catalogue', 'title'), Mode=OneWay}" AutomationProperties.AutomationId="CatalogueResults">
      <table:Table.Columns>
        <table:Column x:Name="NameColumn" Id="name" Width="340" MinWidth="160" CanHide="False" CellTemplate="{StaticResource NameTemplate}"/>
        <table:Column x:Name="SizeColumn" Id="size" CanShrink="False" CellAlignment="Right" CellTemplate="{StaticResource SizeTemplate}"/>
        <table:Column x:Name="SourcesColumn" Id="sources" CanShrink="False" CellAlignment="Right" CellTemplate="{StaticResource SourcesTemplate}"/>
        <table:Column x:Name="SeedsColumn" Id="seeds" CanShrink="False" CellAlignment="Right" CellTemplate="{StaticResource SeedsTemplate}"/>
        <table:Column x:Name="PeersColumn" Id="peers" CanShrink="False" CellAlignment="Right" CellTemplate="{StaticResource PeersTemplate}"/>
        <table:Column x:Name="ObservedColumn" Id="observed" CanShrink="False" CellTemplate="{StaticResource ObservedTemplate}"/>
        <table:Column x:Name="FileColumn" Id="file" CanShrink="False" CellTemplate="{StaticResource FileTemplate}"/>
        <table:Column x:Name="TorrentColumn" Id="torrent" CanShrink="False" CellTemplate="{StaticResource TorrentTemplate}"/>
      </table:Table.Columns>
    </table:Table>
    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind controls:Visibilities.Unless(Model.HasRows), Mode=OneWay}">
      <StackPanel Spacing="8" Margin="24,36,24,24" VerticalAlignment="Top">
        <TextBlock Text="{x:Bind Model.EmptyText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextAlignment="Center"/>
        <TextBlock Text="{x:Bind Model.EmptyDescription, Mode=OneWay}" Visibility="{x:Bind controls:Visibilities.HasText(Model.EmptyDescription), Mode=OneWay}" Style="{StaticResource TinyTorrentTitleDetailTextStyle}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" Margin="0,0,0,8"/>
        <ToggleSwitch x:Name="EnableIndexing" HorizontalAlignment="Center" IsOn="{x:Bind Indexing.IsOn, Mode=OneWay}" IsEnabled="{x:Bind Indexing.CanEdit, Mode=OneWay}" Visibility="{x:Bind Model.IsFirstUse, Mode=OneWay}" OnContent="{x:Bind Model.Text.Get('settings', 'on'), Mode=OneWay}" OffContent="{x:Bind Model.Text.Get('settings', 'off'), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Text.Get('catalogue', 'indexing_help'), Mode=OneWay}" Toggled="OnIndexingToggled" AutomationProperties.Name="{x:Bind Model.Text.Get('catalogue', 'indexing'), Mode=OneWay}" AutomationProperties.AutomationId="CatalogueEnableIndexing"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <controls:ActionButton Text="{x:Bind Model.Text.Get('catalogue', 'continue_search'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.Search}" Visibility="{x:Bind Model.ShowsContinue, Mode=OneWay}" IsEnabled="{x:Bind Model.CanContinue, Mode=OneWay}" Click="OnContinue"/>
          <controls:ActionButton Text="{x:Bind Model.Text.Get('catalogue', 'clear'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.X}" Visibility="{x:Bind Model.ShowsClear, Mode=OneWay}" Click="OnClear" AutomationProperties.AutomationId="CatalogueClearSearch"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <controls:ActionButton Text="{x:Bind Model.Text.Get('commands', 'open_folder'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.FolderOpen}" Visibility="{x:Bind Model.ShowsFolder, Mode=OneWay}" Click="OnFolder" AutomationProperties.AutomationId="CatalogueOpenFolder"/>
          <controls:ActionButton Text="{x:Bind Model.Text.Get('catalogue', 'repair'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.Wrench}" Visibility="{x:Bind Model.ShowsRepair, Mode=OneWay}" IsEnabled="{x:Bind Model.CanDownload, Mode=OneWay}" Click="OnRepair" AutomationProperties.AutomationId="CatalogueRepair"/>
          <controls:ActionButton Text="{x:Bind Model.Text.Get('catalogue', 'delete'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.Trash2}" Visibility="{x:Bind Model.ShowsRepair, Mode=OneWay}" IsEnabled="{x:Bind Model.CanDownload, Mode=OneWay}" Click="OnDelete" AutomationProperties.AutomationId="CatalogueDelete"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
