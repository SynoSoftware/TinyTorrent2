<UserControl
  x:Class="Syno.TinyTorrent.Search.InspectorPane"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Search"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:table="using:Syno.TableView"
  xmlns:icons="using:Syno"
>
  <controls:Pane x:Name="Surface" x:FieldModifier="internal" Dock="Bottom" CanClose="True" CanMaximize="True" Padding="0,0,4,4" AutomationProperties.AutomationId="CatalogueInspector">
    <controls:Pane.Header>
      <Grid ColumnSpacing="12" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind Model.HeadingGlyph, Mode=OneWay}" Style="{StaticResource TinyTorrentSurfaceIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}"/>
        <TextBlock Grid.Column="1" Text="{x:Bind Model.Heading, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Heading, Mode=OneWay}" Style="{StaticResource TinyTorrentGroupTitleTextStyle}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{x:Bind Model.Size, Mode=OneWay}" Style="{StaticResource TinyTorrentTitleDetailTextStyle}"/>
        <FontIcon Grid.Column="3" FontFamily="{ThemeResource LucideFont}" Glyph="{x:Bind icons:Lucide.CircleHelp}" Style="{StaticResource TinyTorrentStatusIconStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind Model.InspectsUnverified, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.UnverifiedTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind Model.UnverifiedTip, Mode=OneWay}"/>
      </Grid>
    </controls:Pane.Header>
    <controls:Pane.Navigation>
      <SelectorBar x:Name="Sections" Padding="0" SelectionChanged="OnSection" AutomationProperties.AutomationId="CatalogueInspectorSections">
        <SelectorBarItem x:Name="GeneralSection" Text="{x:Bind Model.Text.Get('catalogue', 'general'), Mode=OneWay}"><SelectorBarItem.Icon><FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Info}"/></SelectorBarItem.Icon></SelectorBarItem>
        <SelectorBarItem x:Name="AliasesSection" Text="{x:Bind Model.Text.Get('catalogue', 'aliases'), Mode=OneWay}" Visibility="{x:Bind controls:Visibilities.Unless(Model.InspectsTorrent), Mode=OneWay}"><SelectorBarItem.Icon><FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Tags}"/></SelectorBarItem.Icon></SelectorBarItem>
        <SelectorBarItem x:Name="FilesSection" Text="{x:Bind Model.Text.Get('catalogue', 'files'), Mode=OneWay}" Visibility="{x:Bind Model.OffersFiles, Mode=OneWay}"><SelectorBarItem.Icon><FontIcon Style="{StaticResource TinyTorrentStatusIconStyle}" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Files}"/></SelectorBarItem.Icon></SelectorBarItem>
      </SelectorBar>
    </controls:Pane.Navigation>
    <Grid x:Name="InspectorBody">
      <Grid x:Name="General">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.RowSpan="{x:Bind FactRows(Model.InspectsTorrent), Mode=OneWay}" Margin="16,12" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
            <controls:Section Header="{x:Bind Model.Text.Get('catalogue', 'summary'), Mode=OneWay}" Glyph="{x:Bind icons:Lucide.ChartNoAxesColumn}">
              <controls:Strip ColumnSpacing="32" RowSpacing="12">
                <controls:Field Style="{StaticResource TinyTorrentStatisticStyle}" Glyph="{x:Bind icons:Lucide.HardDrive}" Label="{x:Bind Model.Text.Get('catalogue', 'size'), Mode=OneWay}"><TextBlock Text="{x:Bind Model.Size, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Size, Mode=OneWay}" Style="{StaticResource TinyTorrentStatisticValueStyle}"/></controls:Field>
                <controls:Field Style="{StaticResource TinyTorrentStatisticStyle}" Glyph="{x:Bind icons:Lucide.Files}" Label="{x:Bind Model.Text.Get('catalogue', 'file_count'), Mode=OneWay}" Visibility="{x:Bind Model.InspectsTorrent, Mode=OneWay}"><TextBlock Text="{x:Bind Model.FileCount, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.FileCount, Mode=OneWay}" Style="{StaticResource TinyTorrentStatisticValueStyle}"/></controls:Field>
                <controls:Field Style="{StaticResource TinyTorrentStatisticStyle}" Glyph="{x:Bind icons:Lucide.Files}" Label="{x:Bind Model.Text.Get('catalogue', 'source_count'), Mode=OneWay}" Visibility="{x:Bind controls:Visibilities.Unless(Model.InspectsTorrent), Mode=OneWay}"><TextBlock Text="{x:Bind Model.SourceCount, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.SourceCount, Mode=OneWay}" Style="{StaticResource TinyTorrentStatisticValueStyle}"/></controls:Field>
                <controls:Field Style="{StaticResource TinyTorrentStatisticStyle}" Glyph="{x:Bind icons:Lucide.Tags}" Label="{x:Bind Model.Text.Get('catalogue', 'alias_count'), Mode=OneWay}" Visibility="{x:Bind controls:Visibilities.Unless(Model.InspectsTorrent), Mode=OneWay}"><TextBlock Text="{x:Bind Model.AliasCount, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.AliasCount, Mode=OneWay}" Style="{StaticResource TinyTorrentStatisticValueStyle}"/></controls:Field>
                <controls:Field Style="{StaticResource TinyTorrentStatisticStyle}" Glyph="{x:Bind icons:Lucide.Sprout}" Label="{x:Bind Model.Text.Get('catalogue', 'seeds'), Mode=OneWay}" Visibility="{x:Bind Model.InspectsTorrent, Mode=OneWay}"><TextBlock Text="{x:Bind Model.Seeds, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.EstimateTip, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Model.EstimateTip, Mode=OneWay}" Style="{StaticResource TinyTorrentStatisticValueStyle}"/></controls:Field>
                <controls:Field Style="{StaticResource TinyTorrentStatisticStyle}" Glyph="{x:Bind icons:Lucide.Users}" Label="{x:Bind Model.Text.Get('catalogue', 'peers'), Mode=OneWay}" Visibility="{x:Bind Model.InspectsTorrent, Mode=OneWay}"><TextBlock Text="{x:Bind Model.Peers, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.EstimateTip, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Model.EstimateTip, Mode=OneWay}" Style="{StaticResource TinyTorrentStatisticValueStyle}"/></controls:Field>
              </controls:Strip>
            </controls:Section>
            <Border Style="{StaticResource InspectorDividerStyle}" Visibility="{x:Bind Model.InspectsTorrent, Mode=OneWay}"/>
            <controls:Section Header="{x:Bind Model.Text.Get('inspector', 'properties'), Mode=OneWay}" Visibility="{x:Bind Model.InspectsTorrent, Mode=OneWay}" Glyph="{x:Bind icons:Lucide.Info}">
              <controls:FieldColumns>
                <controls:FieldColumns.Primary>
                  <StackPanel>
                    <controls:Field Glyph="{x:Bind icons:Lucide.Hash}" Label="{x:Bind Model.Text.Get('inspector', 'hash_v1'), Mode=OneWay}" Visibility="{x:Bind controls:Visibilities.HasText(Model.HashV1), Mode=OneWay}"><TextBlock Text="{x:Bind Model.HashV1, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.HashV1, Mode=OneWay}" Style="{StaticResource InspectorIdentifierStyle}"/></controls:Field>
                    <controls:Field Glyph="{x:Bind icons:Lucide.Hash}" Label="{x:Bind Model.Text.Get('inspector', 'hash_v2'), Mode=OneWay}" Visibility="{x:Bind controls:Visibilities.HasText(Model.HashV2), Mode=OneWay}"><TextBlock Text="{x:Bind Model.HashV2, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.HashV2, Mode=OneWay}" Style="{StaticResource InspectorIdentifierStyle}"/></controls:Field>
                    <controls:Field Glyph="{x:Bind icons:Lucide.MessageSquare}" Label="{x:Bind Model.Text.Get('inspector', 'comment'), Mode=OneWay}"><TextBlock Text="{x:Bind Model.Comment, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Comment, Mode=OneWay}" Style="{StaticResource InspectorValueStyle}"/></controls:Field>
                  </StackPanel>
                </controls:FieldColumns.Primary>
                <controls:FieldColumns.Secondary>
                  <StackPanel>
                    <controls:Field Glyph="{x:Bind icons:Lucide.Clock}" Label="{x:Bind Model.Text.Get('catalogue', 'observed'), Mode=OneWay}"><TextBlock Text="{x:Bind Model.Observed, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Observed, Mode=OneWay}" Style="{StaticResource InspectorValueStyle}"/></controls:Field>
                    <controls:Field Glyph="{x:Bind icons:Lucide.Eye}" Label="{x:Bind Model.Text.Get('catalogue', 'last_seen'), Mode=OneWay}"><TextBlock Text="{x:Bind Model.LastSeen, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.LastSeen, Mode=OneWay}" Style="{StaticResource InspectorValueStyle}"/></controls:Field>
                    <controls:Field Glyph="{x:Bind icons:Lucide.Calendar}" Label="{x:Bind Model.Text.Get('inspector', 'created'), Mode=OneWay}"><TextBlock Text="{x:Bind Model.Created, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Created, Mode=OneWay}" Style="{StaticResource InspectorValueStyle}"/></controls:Field>
                    <controls:Field Glyph="{x:Bind icons:Lucide.User}" Label="{x:Bind Model.Text.Get('inspector', 'creator'), Mode=OneWay}"><TextBlock Text="{x:Bind Model.Creator, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Model.Creator, Mode=OneWay}" Style="{StaticResource InspectorValueStyle}"/></controls:Field>
                  </StackPanel>
                </controls:FieldColumns.Secondary>
              </controls:FieldColumns>
            </controls:Section>
          </StackPanel>
        </ScrollViewer>
        <table:Table x:Name="SourceTable" Grid.Row="1" Margin="0,8,0,0" ItemsSource="{x:Bind Model.Sources, Mode=OneWay}" Visibility="{x:Bind controls:Visibilities.Unless(Model.InspectsTorrent), Mode=OneWay}" AutomationProperties.AutomationId="CatalogueSources">
          <table:Table.Columns>
            <table:Column x:Name="SourceName" Id="name" Width="320" MinWidth="160" CanHide="False"><table:Column.CellTemplate><DataTemplate x:DataType="local:SourceRow"><Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Tip}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" Style="{StaticResource TinyTorrentIdentityTextStyle}"/><FontIcon Grid.Column="1" FontFamily="{ThemeResource LucideFont}" Glyph="{x:Bind icons:Lucide.CircleHelp}" Style="{StaticResource TinyTorrentStatusIconStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowsUnverified}" ToolTipService.ToolTip="{x:Bind UnverifiedTip}" AutomationProperties.Name="{x:Bind UnverifiedTip}"/></Grid></DataTemplate></table:Column.CellTemplate></table:Column>
            <table:Column x:Name="SourceSize" Id="size" CanShrink="False" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="local:SourceRow"><TextBlock Text="{x:Bind Size}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate></table:Column.CellTemplate></table:Column>
            <table:Column x:Name="SourceFiles" Id="files" CanShrink="False" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="local:SourceRow"><TextBlock Text="{x:Bind Files}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate></table:Column.CellTemplate></table:Column>
            <table:Column x:Name="SourceSeeds" Id="seeds" CanShrink="False" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="local:SourceRow"><TextBlock Text="{x:Bind Seeds}" ToolTipService.ToolTip="{x:Bind EstimateTip}" AutomationProperties.HelpText="{x:Bind EstimateTip}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate></table:Column.CellTemplate></table:Column>
            <table:Column x:Name="SourcePeers" Id="peers" CanShrink="False" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="local:SourceRow"><TextBlock Text="{x:Bind Peers}" ToolTipService.ToolTip="{x:Bind EstimateTip}" AutomationProperties.HelpText="{x:Bind EstimateTip}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate></table:Column.CellTemplate></table:Column>
            <table:Column x:Name="SourceObserved" Id="observed" CanShrink="False"><table:Column.CellTemplate><DataTemplate x:DataType="local:SourceRow"><TextBlock Text="{x:Bind Observed}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate></table:Column.CellTemplate></table:Column>
            <table:Column x:Name="SourceSeen" Id="last_seen" CanShrink="False"><table:Column.CellTemplate><DataTemplate x:DataType="local:SourceRow"><TextBlock Text="{x:Bind LastSeen}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate></table:Column.CellTemplate></table:Column>
            <table:Column x:Name="SourceInspect" Id="inspect" CanShrink="False"><table:Column.CellTemplate><DataTemplate x:DataType="local:SourceRow"><controls:ActionButton Text="{x:Bind InspectText}" Glyph="{x:Bind icons:Lucide.Info}" Command="{x:Bind Inspect}" Padding="8,4"/></DataTemplate></table:Column.CellTemplate></table:Column>
          </table:Table.Columns>
        </table:Table>
        <controls:ActionButton Grid.Row="2" Text="{x:Bind Model.Text.Get('catalogue', 'download'), Mode=OneWay}" Command="{x:Bind Model.DownloadTorrent}" Visibility="{x:Bind Model.InspectsTorrent, Mode=OneWay}" Glyph="{x:Bind icons:Lucide.Download}" Margin="0,8,0,0" HorizontalAlignment="Right" AutomationProperties.AutomationId="CatalogueDownloadTorrent"/>
      </Grid>
      <table:Table x:Name="Aliases" ItemsSource="{x:Bind Model.Aliases, Mode=OneWay}" Visibility="Collapsed" AutomationProperties.AutomationId="CatalogueAliases">
        <table:Table.Columns>
          <table:Column x:Name="AliasName" Id="name" Width="400" MinWidth="160" CanHide="False"><table:Column.CellTemplate><DataTemplate x:DataType="local:AliasRow"><TextBlock Text="{x:Bind Name}" Style="{StaticResource TinyTorrentIdentityTextStyle}"/></DataTemplate></table:Column.CellTemplate></table:Column>
          <table:Column x:Name="AliasTorrents" Id="torrents" CanShrink="False" CellAlignment="Right"><table:Column.CellTemplate><DataTemplate x:DataType="local:AliasRow"><TextBlock Text="{x:Bind Torrents}" Style="{StaticResource TinyTorrentBodyTextStyle}"/></DataTemplate></table:Column.CellTemplate></table:Column>
          <table:Column x:Name="AliasSearch" Id="search" CanShrink="False"><table:Column.CellTemplate><DataTemplate x:DataType="local:AliasRow"><controls:ActionButton Text="{x:Bind SearchText}" Glyph="{x:Bind icons:Lucide.Search}" Command="{x:Bind Search}" Padding="8,4"/></DataTemplate></table:Column.CellTemplate></table:Column>
          <table:Column x:Name="AliasCopy" Id="copy" CanShrink="False"><table:Column.CellTemplate><DataTemplate x:DataType="local:AliasRow"><controls:ActionButton Text="{x:Bind CopyText}" Glyph="{x:Bind icons:Lucide.Copy}" Command="{x:Bind Copy}" Padding="8,4"/></DataTemplate></table:Column.CellTemplate></table:Column>
        </table:Table.Columns>
      </table:Table>
      <Grid x:Name="FileArea" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ContentControl x:Name="FilesHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <controls:ActionButton Grid.Row="1" Text="{x:Bind Model.Text.Get('catalogue', 'download'), Mode=OneWay}" Command="{x:Bind Model.DownloadFiles}" Glyph="{x:Bind icons:Lucide.Download}" Margin="0,8,0,0" HorizontalAlignment="Right"/>
      </Grid>
      <TextBlock x:Name="NoSelection" Text="{x:Bind Model.Text.Get('catalogue', 'no_selection'), Mode=OneWay}" Visibility="{x:Bind controls:Visibilities.Unless(Model.HasSelection), Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Grid>
  </controls:Pane>
</UserControl>
