<UserControl
  x:Class="Syno.TinyTorrent.Torrents.FileDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:torrents="using:Syno.TinyTorrent.Torrents"
  xmlns:icons="using:Syno"
>
  <UserControl.Resources>
    <DataTemplate x:Key="FileDialogTorrentTemplate" x:DataType="torrents:Torrent">
      <Grid ColumnSpacing="16" MinHeight="32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Text="{x:Bind Name, Mode=OneWay}"
          Style="{StaticResource TinyTorrentIdentityTextStyle}"
          TextWrapping="NoWrap"
          TextTrimming="CharacterEllipsis"
          IsTextSelectionEnabled="True"
          VerticalAlignment="Center"
        >
          <ToolTipService.ToolTip>
            <StackPanel>
              <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
              <TextBlock Text="{x:Bind SavePath, Mode=OneWay}" FlowDirection="LeftToRight" />
            </StackPanel>
          </ToolTipService.ToolTip>
        </TextBlock>
        <TextBlock
          Grid.Column="1"
          Text="{x:Bind SizeText, Mode=OneWay}"
          Style="{StaticResource TinyTorrentBodyTextStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          VerticalAlignment="Center"
        />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer
      MaxHeight="224"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
    >
      <StackPanel Spacing="12">
        <ItemsControl
          ItemsSource="{x:Bind Model.FileDraft.Torrents, Mode=OneWay}"
          ItemTemplate="{StaticResource FileDialogTorrentTemplate}"
          Visibility="{x:Bind Model.FileDraft.IsMove, Mode=OneWay}"
          IsTabStop="False"
        />
        <ItemsControl
          ItemsSource="{x:Bind Model.FileDraft.Folders, Mode=OneWay}"
          Visibility="{x:Bind Model.FileDraft.IsRemoval, Mode=OneWay}"
          IsTabStop="False"
        >
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="torrents:FolderGroup">
              <StackPanel>
                <Grid ColumnSpacing="8" MinHeight="24">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <FontIcon
                    FontFamily="{x:Bind icons:Lucide.Font}"
                    Glyph="{x:Bind icons:Lucide.Folder}"
                    FontSize="{StaticResource TinyTorrentInlineIconSize}"
                    VerticalAlignment="Center"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind Folder}"
                    ToolTipService.ToolTip="{x:Bind Folder}"
                    Style="{StaticResource TinyTorrentBodyTextStyle}"
                    FontWeight="SemiBold"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    FlowDirection="LeftToRight"
                    VerticalAlignment="Center"
                  />
                </Grid>
                <ItemsControl
                  ItemsSource="{x:Bind Torrents}"
                  IsTabStop="False"
                  Margin="24,0,0,0"
                  ItemTemplate="{StaticResource FileDialogTorrentTemplate}"
                />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Spacing="8" Visibility="{x:Bind Model.FileDraft.ShowsMoveShared, Mode=OneWay}">
          <TextBlock
            Text="{x:Bind Model.FileDraft.SharedText, Mode=OneWay}"
            Style="{StaticResource TinyTorrentBodyTextStyle}"
            IsTextSelectionEnabled="True"
            ToolTipService.ToolTip="{x:Bind Model.FileDraft.SharedText, Mode=OneWay}"
          />
          <CheckBox
            x:Name="IncludeShared"
            Content="{x:Bind Model.Text.Get('file_action', 'include_shared'), Mode=OneWay}"
            AutomationProperties.AutomationId="IncludeShared"
            IsChecked="{x:Bind Model.FileDraft.IncludeShared, Mode=TwoWay}"
            IsEnabled="{x:Bind Model.FileDraft.CanRefresh, Mode=OneWay}"
          />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <!-- The list scrolls while the deletion choice and its consequence stay
         visible, as Move's From and To rows do. -->
    <StackPanel
      Grid.Row="1"
      Spacing="12"
      Padding="0,16,0,0"
      Margin="0,16,0,0"
      BorderThickness="0,1,0,0"
      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
      Visibility="{x:Bind Model.FileDraft.IsRemoval, Mode=OneWay}"
    >
      <CheckBox
        Content="{x:Bind Model.FileDraft.DownloadedText, Mode=OneWay}"
        AutomationProperties.AutomationId="DeleteDownloaded"
        IsChecked="{x:Bind Model.FileDraft.DeleteDownloaded, Mode=TwoWay}"
        IsEnabled="{x:Bind Model.FileDraft.CanSubmit, Mode=OneWay}"
      />
      <CheckBox
        Content="{x:Bind Model.FileDraft.TorrentFilesText, Mode=OneWay}"
        AutomationProperties.AutomationId="DeleteTorrentFiles"
        IsChecked="{x:Bind Model.FileDraft.DeleteTorrentFiles, Mode=TwoWay}"
        IsEnabled="{x:Bind Model.FileDraft.CanSubmit, Mode=OneWay}"
        Visibility="{x:Bind Model.FileDraft.HasTorrentFiles, Mode=OneWay}"
      />
      <TextBlock
        Text="{x:Bind Model.FileDraft.SharedText, Mode=OneWay}"
        Visibility="{x:Bind Model.FileDraft.ShowsKeptShared, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
        IsTextSelectionEnabled="True"
        ToolTipService.ToolTip="{x:Bind Model.FileDraft.SharedText, Mode=OneWay}"
      />
    </StackPanel>
    <Border
      Grid.Row="1"
      BorderThickness="0,1,0,0"
      Padding="0,16,0,0"
      Margin="0,16,0,0"
      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
      Visibility="{x:Bind Model.FileDraft.IsMove, Mode=OneWay}"
    >
      <Grid ColumnSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Text="{x:Bind Model.Text.Get('file_action', 'current'), Mode=OneWay}"
          Style="{StaticResource TinyTorrentBodyTextStyle}"
          VerticalAlignment="Center"
        />
        <TextBlock
          Grid.Column="1"
          Margin="12,0,0,0"
          Text="{x:Bind Model.FileDraft.Locations, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Model.FileDraft.Locations, Mode=OneWay}"
          Style="{StaticResource TinyTorrentBodyTextStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          TextWrapping="NoWrap"
          TextTrimming="CharacterEllipsis"
          IsTextSelectionEnabled="True"
          FlowDirection="LeftToRight"
          VerticalAlignment="Center"
        />
        <TextBlock
          Grid.Row="1"
          x:Name="DestinationLabel"
          Margin="0,8,0,0"
          Text="{x:Bind Model.Text.Get('file_action', 'destination'), Mode=OneWay}"
          Style="{StaticResource TinyTorrentBodyTextStyle}"
          VerticalAlignment="Center"
        />
        <TextBox
          Grid.Row="1"
          Grid.Column="1"
          Margin="0,8,0,0"
          x:Name="Destination"
          AutomationProperties.AutomationId="MoveDestination"
          AutomationProperties.Name="{x:Bind Model.Text.Get('file_action', 'destination'), Mode=OneWay}"
          AutomationProperties.HelpText="{x:Bind Model.FileDraft.DestinationError, Mode=OneWay}"
          AutomationProperties.LabeledBy="{x:Bind DestinationLabel}"
          IsEnabled="{x:Bind Model.FileDraft.CanRefresh, Mode=OneWay}"
          Text="{x:Bind Model.FileDraft.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          ToolTipService.ToolTip="{x:Bind Model.FileDraft.Destination, Mode=OneWay}"
          FlowDirection="LeftToRight"
        />
        <controls:FieldHeader
          Grid.Row="2"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          Margin="0,8,0,0"
          Error="{x:Bind Model.FileDraft.DestinationError, Mode=OneWay}"
        />
        <controls:ActionButton
          Glyph="{x:Bind icons:Lucide.FolderSearch}"
          ToolTipService.ToolTip="{x:Bind Model.Text.Get('file_action', 'browse_tip'), Mode=OneWay}"
          x:Name="Browse"
          Text="{x:Bind Model.Text.Get('add', 'browse'), Mode=OneWay}"
          AutomationProperties.AutomationId="MoveBrowse"
          Grid.Row="1"
          Grid.Column="2"
          Margin="0,8,0,0"
          VerticalAlignment="Bottom"
          IsEnabled="{x:Bind Model.FileDraft.CanRefresh, Mode=OneWay}"
          Click="OnDestination"
        />
      </Grid>
    </Border>
    <ProgressRing
      Width="20"
      Height="20"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      IsActive="{x:Bind Model.FileDraft.IsPending, Mode=OneWay}"
      Visibility="{x:Bind Model.FileDraft.IsPending, Mode=OneWay}"
    />
    <StackPanel Grid.Row="2" Spacing="8">
      <InfoBar
        Margin="0,16,0,0"
        IsClosable="False"
        Severity="Error"
        IsOpen="{x:Bind Model.FileDraft.HasError, Mode=OneWay}"
        Visibility="{x:Bind Model.FileDraft.HasError, Mode=OneWay}"
        Message="{x:Bind Model.FileDraft.Message, Mode=OneWay}"
      >
        <InfoBar.ActionButton>
          <controls:ActionButton
            Glyph="{x:Bind icons:Lucide.RotateCw}"
            ToolTipService.ToolTip="{x:Bind Model.Text.Get('file_action', 'refresh_tip'), Mode=OneWay}"
            x:Name="Refresh"
            Text="{x:Bind Model.Text.Get('file_action', 'refresh'), Mode=OneWay}"
            AutomationProperties.AutomationId="RefreshFileScope"
            Click="OnRefresh"
            IsEnabled="{x:Bind Model.FileDraft.CanRefresh, Mode=OneWay}"
          />
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar
        Margin="0,16,0,0"
        IsClosable="False"
        Severity="Error"
        IsOpen="{x:Bind Model.CanRestart, Mode=OneWay}"
        Visibility="{x:Bind Model.CanRestart, Mode=OneWay}"
        Title="{x:Bind Model.CurrentStatus.Title, Mode=OneWay}"
        Message="{x:Bind Model.CurrentStatus.Body, Mode=OneWay}"
      >
        <InfoBar.ActionButton>
          <controls:ActionButton
            Glyph="{x:Bind icons:Lucide.RotateCcw}"
            ToolTipService.ToolTip="{x:Bind Model.Text.Get('connection', 'restart_tip'), Mode=OneWay}"
            AutomationProperties.AutomationId="FileRestart"
            Text="{x:Bind Model.RestartText, Mode=OneWay}"
            Command="{x:Bind Model.Restart}"
          />
        </InfoBar.ActionButton>
      </InfoBar>
    </StackPanel>
  </Grid>
</UserControl>
