<UserControl
  x:Class="Syno.TinyTorrent.Controls.TransferPair"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Controls"
  IsTabStop="False"
>
  <TextBlock
    Style="{x:Bind ValueStyle, Mode=OneWay}"
    FlowDirection="LeftToRight"
    TextTrimming="CharacterEllipsis"
    ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}"
    AutomationProperties.Name="{x:Bind Description, Mode=OneWay}"
  >
    <Run
      Text="{x:Bind local:TransferPair.Amount(Text, 'download', Download), Mode=OneWay}"
      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
    />
    <Run Text=" · " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Run
      Text="{x:Bind local:TransferPair.Amount(Text, 'upload', Upload), Mode=OneWay}"
      Foreground="{ThemeResource TinyTorrentUploadBrush}"
    />
    <Run Text="{x:Bind local:TransferPair.Separated(Total), Mode=OneWay}" />
  </TextBlock>
</UserControl>
