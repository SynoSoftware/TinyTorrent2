<UserControl
  x:Class="Syno.TinyTorrent.Controls.FileBrowser"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="using:Syno"
  xmlns:table="using:Syno.TableView"
  xmlns:local="using:Syno.TinyTorrent.Controls"
>
  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="Toolbar" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MaxWidth="220" />
      </Grid.ColumnDefinitions>
      <TextBlock
        Text="{x:Bind Model.Summary, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
        VerticalAlignment="Center"
      />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button
          x:Name="Priority"
          Content="{x:Bind Model.Text.Get('files', 'priority'), Mode=OneWay}"
          Click="OnPriority"
          IsEnabled="False"
        />
        <Button
          Style="{StaticResource TinyTorrentSubtleButtonStyle}"
          Click="OnExpand"
          Visibility="{x:Bind Model.CanExpand, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Model.Text.Get('files', 'expand_all'), Mode=OneWay}"
          AutomationProperties.Name="{x:Bind Model.Text.Get('files', 'expand_all'), Mode=OneWay}"
        >
          <FontIcon
            FontFamily="{x:Bind icons:Lucide.Font}"
            Glyph="{x:Bind icons:Lucide.ChevronsUpDown}"
            FontSize="{StaticResource TinyTorrentButtonIconSize}"
          />
        </Button>
        <Button
          Style="{StaticResource TinyTorrentSubtleButtonStyle}"
          Click="OnCollapse"
          Visibility="{x:Bind Model.HasFolders, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Model.Text.Get('files', 'collapse_all'), Mode=OneWay}"
          AutomationProperties.Name="{x:Bind Model.Text.Get('files', 'collapse_all'), Mode=OneWay}"
        >
          <FontIcon
            FontFamily="{x:Bind icons:Lucide.Font}"
            Glyph="{x:Bind icons:Lucide.ChevronsDownUp}"
            FontSize="{StaticResource TinyTorrentButtonIconSize}"
          />
        </Button>
      </StackPanel>
      <AutoSuggestBox
        PlaceholderText="{x:Bind Model.Text.Get('files', 'search'), Mode=OneWay}"
        Grid.Column="2"
        VerticalAlignment="Center"
        QueryIcon="Find"
        Text="{x:Bind Model.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      />
    </Grid>
    <table:Table
      x:Name="Files"
      Grid.Row="1"
      ItemsSource="{x:Bind Model.Roots, Mode=OneWay}"
      PreviewKeyDown="OnFilesKey"
    >
      <table:Table.Columns>
        <table:Column x:Name="NameColumn" Id="name" Width="360" CellAlignment="Stretch">
          <table:Column.Header>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox
                x:Name="All"
                IsChecked="{x:Bind Model.AllMatching, Mode=OneWay}"
                IsEnabled="{x:Bind Model.IsEnabled, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Model.AllLabel, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Model.AllLabel, Mode=OneWay}"
                Click="OnAll"
              />
              <TextBlock
                Text="{x:Bind Model.Text.Get('files', 'name'), Mode=OneWay}"
                VerticalAlignment="Center"
              />
            </StackPanel>
          </table:Column.Header>
          <table:Column.CellTemplate>
            <DataTemplate x:DataType="local:FileNode">
              <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Path}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                  MinWidth="0"
                  IsChecked="{x:Bind Wanted, Mode=TwoWay}"
                  IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind Path}"
                />
                <FontIcon
                  Grid.Column="1"
                  FontFamily="{x:Bind icons:Lucide.Font}"
                  Glyph="{x:Bind Glyph}"
                  FontSize="{StaticResource TinyTorrentInlineIconSize}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  AutomationProperties.AccessibilityView="Raw"
                />
                <TextBlock
                  Grid.Column="2"
                  Text="{x:Bind Name}"
                  Style="{StaticResource TinyTorrentIdentityTextStyle}"
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                />
                <ProgressRing
                  Grid.Column="3"
                  Width="{StaticResource TinyTorrentInlineIconSize}"
                  Height="{StaticResource TinyTorrentInlineIconSize}"
                  IsActive="{x:Bind IsLoading, Mode=OneWay}"
                  Visibility="{x:Bind IsLoading, Mode=OneWay}"
                  AutomationProperties.AccessibilityView="Raw"
                />
                <TextBlock
                  Grid.Column="3"
                  Text="{x:Bind TooMany, Mode=OneWay}"
                  Visibility="{x:Bind IsTooMany, Mode=OneWay}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  VerticalAlignment="Center"
                  TextWrapping="NoWrap"
                />
              </Grid>
            </DataTemplate>
          </table:Column.CellTemplate>
        </table:Column>
        <table:Column x:Name="SizeColumn" Id="size" Width="110" CanShrink="False" CellAlignment="Right">
          <table:Column.CellTemplate>
            <DataTemplate x:DataType="local:FileNode">
              <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" VerticalAlignment="Center" />
            </DataTemplate>
          </table:Column.CellTemplate>
        </table:Column>
        <table:Column x:Name="ProgressColumn" Id="progress" Width="148" CanShrink="False" CellAlignment="Stretch">
          <table:Column.CellTemplate>
            <DataTemplate x:DataType="local:FileNode">
              <Grid VerticalAlignment="Center" RowSpacing="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:Overlay Height="4">
                  <ProgressBar
                    Style="{x:Bind local:Progress.SelectStyle(IsComplete), Mode=OneWay}"
                    Value="{x:Bind ProgressValue, Mode=OneWay}"
                    IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                  />
                </local:Overlay>
                <TextBlock
                  Grid.Row="1"
                  Text="{x:Bind ProgressText, Mode=OneWay}"
                  Style="{StaticResource CaptionTextBlockStyle}"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  TextWrapping="NoWrap"
                />
              </Grid>
            </DataTemplate>
          </table:Column.CellTemplate>
        </table:Column>
        <table:Column x:Name="PriorityColumn" Id="priority" Width="200" CanShrink="False" CellAlignment="Stretch">
          <table:Column.CellTemplate>
            <DataTemplate x:DataType="local:FileNode">
              <ComboBox
                HorizontalAlignment="Stretch"
                SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}"
                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Path}"
              >
                <ComboBoxItem Visibility="{x:Bind IsFolder}">
                  <TextBlock Text="{x:Bind Unchanged, Mode=OneWay}" />
                </ComboBoxItem>
                <ComboBoxItem>
                  <TextBlock Text="{x:Bind Skip, Mode=OneWay}" />
                </ComboBoxItem>
                <ComboBoxItem>
                  <TextBlock Text="{x:Bind Low, Mode=OneWay}" />
                </ComboBoxItem>
                <ComboBoxItem>
                  <TextBlock Text="{x:Bind Normal, Mode=OneWay}" />
                </ComboBoxItem>
                <ComboBoxItem>
                  <TextBlock Text="{x:Bind High, Mode=OneWay}" />
                </ComboBoxItem>
              </ComboBox>
            </DataTemplate>
          </table:Column.CellTemplate>
        </table:Column>
      </table:Table.Columns>
    </table:Table>
    <TextBlock
      Grid.Row="2"
      Text="{x:Bind Model.Note, Mode=OneWay}"
      Visibility="{x:Bind Model.HasNote, Mode=OneWay}"
      Style="{StaticResource CaptionTextBlockStyle}"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
  </Grid>
</UserControl>
