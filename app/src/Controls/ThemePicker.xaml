<UserControl
  x:Class="Syno.TinyTorrent.Controls.ThemePicker"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="using:Syno"
>
  <UserControl.Resources>
    <x:Double x:Key="RadioButtonsColumnSpacing">8</x:Double>
    <Style x:Key="SettingsThemeTileStyle" TargetType="RadioButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border
              x:Name="Tile"
              Padding="4"
              CornerRadius="8"
              BorderThickness="2"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            >
              <Border.BackgroundTransition>
                <BrushTransition Duration="0:0:0.083" />
              </Border.BackgroundTransition>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter
                        Target="Tile.Background"
                        Value="{ThemeResource SubtleFillColorSecondaryBrush}"
                      />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                      <Setter
                        Target="Tile.Background"
                        Value="{ThemeResource SubtleFillColorTertiaryBrush}"
                      />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                      <Setter Target="Tile.Opacity" Value="0.5" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition
                      From="Unchecked"
                      To="Checked"
                      GeneratedDuration="{StaticResource ControlFastAnimationDuration}"
                    />
                    <VisualTransition
                      From="Checked"
                      To="Unchecked"
                      GeneratedDuration="{StaticResource ControlFastAnimationDuration}"
                    />
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter
                        Target="Tile.BorderBrush"
                        Value="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      />
                      <Setter Target="Selected.Opacity" Value="1" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Grid>
                <ContentPresenter
                  Content="{TemplateBinding Content}"
                  HorizontalContentAlignment="Stretch"
                />
                <FontIcon
                  x:Name="Selected"
                  FontFamily="{ThemeResource LucideFont}"
                  Glyph="{x:Bind icons:Lucide.Check}"
                  FontSize="{StaticResource TinyTorrentInlineIconSize}"
                  Opacity="0"
                  AutomationProperties.AccessibilityView="Raw"
                  IsHitTestVisible="False"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="6,0,6,6"
                />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <RadioButtons
    x:Name="Theme"
    MaxColumns="3"
    SizeChanged="OnTilesSize"
    SelectionChanged="OnTheme"
    IsEnabled="{x:Bind Model.CanSelectTheme, Mode=OneWay}"
    AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'theme'), Mode=OneWay}"
    AutomationProperties.AutomationId="Theme"
  >
    <RadioButton
      x:Name="SystemTheme"
      AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'system_theme'), Mode=OneWay}"
      ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'system_theme'), Mode=OneWay}"
      Tag="system"
      Style="{StaticResource SettingsThemeTileStyle}"
    >
      <StackPanel>
        <Grid SizeChanged="OnPreviewSize">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Source="ms-appx:///Assets/ThemeLight.jpg" Stretch="UniformToFill" />
          <Image Grid.Column="1" Source="ms-appx:///Assets/ThemeDark.jpg" Stretch="UniformToFill" />
        </Grid>
        <TextBlock
          Text="{x:Bind Model.Text.Get('settings', 'system_theme'), Mode=OneWay}"
          Margin="6,8,28,6"
          TextTrimming="CharacterEllipsis"
        />
      </StackPanel>
    </RadioButton>
    <RadioButton
      x:Name="LightTheme"
      AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'light_theme'), Mode=OneWay}"
      ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'light_theme'), Mode=OneWay}"
      Tag="light"
      Style="{StaticResource SettingsThemeTileStyle}"
    >
      <StackPanel>
        <Grid SizeChanged="OnPreviewSize">
          <Image Source="ms-appx:///Assets/ThemeLight.jpg" Stretch="UniformToFill" />
        </Grid>
        <TextBlock
          Text="{x:Bind Model.Text.Get('settings', 'light_theme'), Mode=OneWay}"
          Margin="6,8,28,6"
          TextTrimming="CharacterEllipsis"
        />
      </StackPanel>
    </RadioButton>
    <RadioButton
      x:Name="DarkTheme"
      AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'dark_theme'), Mode=OneWay}"
      ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'dark_theme'), Mode=OneWay}"
      Tag="dark"
      Style="{StaticResource SettingsThemeTileStyle}"
    >
      <StackPanel>
        <Grid SizeChanged="OnPreviewSize">
          <Image Source="ms-appx:///Assets/ThemeDark.jpg" Stretch="UniformToFill" />
        </Grid>
        <TextBlock
          Text="{x:Bind Model.Text.Get('settings', 'dark_theme'), Mode=OneWay}"
          Margin="6,8,28,6"
          TextTrimming="CharacterEllipsis"
        />
      </StackPanel>
    </RadioButton>
  </RadioButtons>
</UserControl>
