<UserControl
  x:Class="Syno.TinyTorrent.Controls.PeerMap"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  IsTabStop="True"
  UseSystemFocusVisuals="True"
>
  <Grid>
    <Grid x:Name="Drawing" FlowDirection="LeftToRight" />
    <TextBlock x:Name="Failure" Margin="12" HorizontalAlignment="Center"
      VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Visibility="Collapsed">
      <TextBlock x:Name="Ink" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      <Border x:Name="Land" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
      <Border x:Name="Edge" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
      <Border x:Name="Download" Background="{ThemeResource AccentFillColorDefaultBrush}" />
      <Border x:Name="Upload" Background="{ThemeResource TinyTorrentUploadBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
