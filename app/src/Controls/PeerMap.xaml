<UserControl
  x:Class="Syno.TinyTorrent.Controls.PeerMap"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  IsTabStop="True"
  UseSystemFocusVisuals="True"
>
  <Grid>
    <Grid x:Name="Drawing" FlowDirection="LeftToRight" />
    <StackPanel
      x:Name="Navigation"
      Orientation="Horizontal"
      Spacing="8"
      Margin="8"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Visibility="Collapsed"
    >
      <TextBlock
        x:Name="ZoomLabel"
        VerticalAlignment="Center"
        Style="{StaticResource CaptionTextBlockStyle}"
        IsHitTestVisible="False"
      />
      <Button x:Name="FitButton" Click="OnFit">
        <FontIcon x:Name="FitGlyph" FontSize="16" />
      </Button>
    </StackPanel>
    <TextBlock
      x:Name="Failure"
      Margin="12"
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      TextWrapping="Wrap"
      Visibility="Collapsed"
    />
    <StackPanel Visibility="Collapsed">
      <TextBlock x:Name="Ink" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      <Border x:Name="Land" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" />
      <Border x:Name="Edge" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
      <Border x:Name="Download" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <Border x:Name="Upload" Background="{ThemeResource TinyTorrentUploadBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
