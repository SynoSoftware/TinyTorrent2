<UserControl
  x:Class="Syno.TinyTorrent.Controls.Speedometer"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  IsTabStop="True"
  UseSystemFocusVisuals="True"
>
  <Grid RowSpacing="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="12,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon x:Name="Icon" FontSize="20" AutomationProperties.AccessibilityView="Raw" />
      <TextBlock x:Name="Label" Grid.Column="1" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="Unit" Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
    <Grid x:Name="Drawing" Grid.Row="1" Height="136" FlowDirection="LeftToRight" />
    <StackPanel Visibility="Collapsed">
      <TextBlock x:Name="Ink" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      <TextBlock x:Name="Muted" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <Border x:Name="Accent" Background="{ThemeResource AccentTextFillColorPrimaryBrush}" />
      <Border x:Name="Track" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
