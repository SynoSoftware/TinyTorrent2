<UserControl x:Class="Syno.TinyTorrent.Controls.SpeedGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:Double x:Key="SpeedGraphFillOpacity">0.16</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:Double x:Key="SpeedGraphFillOpacity">0.2</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Double x:Key="SpeedGraphFillOpacity">0</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock x:Name="Download" TextWrapping="Wrap" /><TextBlock x:Name="Upload" TextWrapping="Wrap" /></StackPanel>
        <TextBlock x:Name="Maximum" Grid.Row="1" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid x:Name="Plot" Grid.Row="2" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" SizeChanged="OnSize" FlowDirection="LeftToRight">
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Path x:Name="DownloadArea" Grid.RowSpan="4" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{ThemeResource SpeedGraphFillOpacity}" AutomationProperties.AccessibilityView="Raw" />
            <Path x:Name="DownloadLine" Grid.RowSpan="4" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" AutomationProperties.AccessibilityView="Raw" />
            <Path x:Name="UploadLine" Grid.RowSpan="4" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeDashArray="4,3" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="NoHistory" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
        </Grid>
        <Grid Grid.Row="3" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="Start" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="End" Grid.Column="1" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
    </Grid>
</UserControl>
