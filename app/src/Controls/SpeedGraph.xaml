<UserControl
  x:Class="Syno.TinyTorrent.Controls.SpeedGraph"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  IsTabStop="True"
  UseSystemFocusVisuals="True"
  KeyDown="OnKey"
  GotFocus="OnFocus"
  LostFocus="OnBlur"
>
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <x:Double x:Key="SpeedGraphFillOpacity">0.16</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <x:Double x:Key="SpeedGraphFillOpacity">0.2</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <x:Double x:Key="SpeedGraphFillOpacity">0</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style
        x:Key="SpeedGraphTickStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
      >
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid RowSpacing="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        x:Name="Title"
        Style="{StaticResource BodyStrongTextBlockStyle}"
        VerticalAlignment="Center"
      />
      <Button x:Name="Live" Grid.Column="1" Visibility="Collapsed" Click="OnLive" />
      <SelectorBar x:Name="Ranges" Grid.Column="2" Padding="0" SelectionChanged="OnRange">
        <SelectorBarItem x:Name="FiveMinutes" />
        <SelectorBarItem x:Name="Hour" />
        <SelectorBarItem x:Name="SixHours" />
        <SelectorBarItem x:Name="Day" />
      </SelectorBar>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Line
          X2="18"
          VerticalAlignment="Center"
          Stroke="{ThemeResource AccentFillColorDefaultBrush}"
          StrokeThickness="2"
        />
        <TextBlock
          x:Name="DownloadLegend"
          Grid.Column="1"
          Style="{StaticResource TinyTorrentBodyTextStyle}"
          IsTextSelectionEnabled="True"
        >
          <Run x:Name="DownloadLabel" />
          <Run Text=" " />
          <Run x:Name="DownloadValue" FontWeight="SemiBold" />
          <Run Text=" · " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Run x:Name="DownloadDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </TextBlock>
      </Grid>
      <Grid Grid.Column="1" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Line
          X2="18"
          VerticalAlignment="Center"
          Stroke="{ThemeResource TextFillColorPrimaryBrush}"
          StrokeThickness="2"
          StrokeDashArray="3,2.25"
        />
        <TextBlock
          x:Name="UploadLegend"
          Grid.Column="1"
          Style="{StaticResource TinyTorrentBodyTextStyle}"
          IsTextSelectionEnabled="True"
        >
          <Run x:Name="UploadLabel" />
          <Run Text=" " />
          <Run x:Name="UploadValue" FontWeight="SemiBold" />
          <Run Text=" · " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <Run x:Name="UploadDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </TextBlock>
      </Grid>
    </Grid>
    <TextBlock
      x:Name="Maximum"
      Grid.Row="2"
      HorizontalAlignment="Right"
      Style="{StaticResource CaptionTextBlockStyle}"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
    />
    <Grid
      x:Name="Plot"
      Grid.Row="3"
      Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
      SizeChanged="OnSize"
      FlowDirection="LeftToRight"
      PointerPressed="OnPressed"
      PointerMoved="OnPointer"
      PointerReleased="OnReleased"
      PointerCaptureLost="OnReleased"
      PointerExited="OnPointerExit"
      PointerCanceled="OnPointerExit"
      PointerWheelChanged="OnWheel"
    >
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Border
        Grid.Row="1"
        BorderThickness="0,1,0,0"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
      />
      <Border
        Grid.Row="2"
        BorderThickness="0,1,0,0"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
      />
      <Border
        Grid.Row="3"
        BorderThickness="0,1,0,0"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
      />
      <Path
        x:Name="Ticks"
        Grid.RowSpan="4"
        Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
        StrokeThickness="1"
        StrokeDashArray="2,3"
        AutomationProperties.AccessibilityView="Raw"
      />
      <Path
        x:Name="DownloadArea"
        Grid.RowSpan="4"
        Fill="{ThemeResource AccentFillColorDefaultBrush}"
        Opacity="{ThemeResource SpeedGraphFillOpacity}"
        AutomationProperties.AccessibilityView="Raw"
      />
      <Path
        x:Name="DownloadLine"
        Grid.RowSpan="4"
        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
        StrokeThickness="1.5"
        StrokeLineJoin="Round"
        AutomationProperties.AccessibilityView="Raw"
      />
      <Path
        x:Name="UploadLine"
        Grid.RowSpan="4"
        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
        StrokeThickness="1.5"
        StrokeLineJoin="Round"
        StrokeDashArray="4,3"
        AutomationProperties.AccessibilityView="Raw"
      />
      <Canvas
        x:Name="Marker"
        Grid.RowSpan="4"
        Visibility="Collapsed"
        AutomationProperties.AccessibilityView="Raw"
      >
        <Line
          x:Name="MarkerLine"
          Stroke="{ThemeResource TextFillColorSecondaryBrush}"
          StrokeThickness="1"
        />
        <Ellipse
          x:Name="DownloadDot"
          Width="7"
          Height="7"
          Fill="{ThemeResource AccentFillColorDefaultBrush}"
        />
        <Ellipse
          x:Name="UploadDot"
          Width="7"
          Height="7"
          Fill="{ThemeResource ControlAltFillColorSecondaryBrush}"
          Stroke="{ThemeResource TextFillColorPrimaryBrush}"
          StrokeThickness="1.5"
        />
      </Canvas>
      <TextBlock
        x:Name="NoHistory"
        Grid.RowSpan="4"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        TextWrapping="Wrap"
        Margin="16"
      />
    </Grid>
    <Grid x:Name="TickLabels" Grid.Row="4" FlowDirection="LeftToRight" />
  </Grid>
</UserControl>
