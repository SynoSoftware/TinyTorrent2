<UserControl x:Class="Syno.TinyTorrent.Controls.SpeedGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock x:Name="Download" TextWrapping="Wrap" /><TextBlock x:Name="Upload" TextWrapping="Wrap" /></StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid><TextBlock x:Name="Maximum" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="0" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
            <Grid x:Name="Plot" Grid.Column="1" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" SizeChanged="OnSize" FlowDirection="LeftToRight">
                <Path x:Name="DownloadLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" AutomationProperties.AccessibilityView="Raw" />
                <Path x:Name="UploadLine" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeDashArray="4,3" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="NoHistory" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
            </Grid>
        </Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="Start" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="End" Grid.Column="1" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
    </Grid>
</UserControl>
