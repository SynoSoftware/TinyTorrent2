<UserControl x:Class="Syno.TinyTorrent.Controls.InspectorSplit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    Height="16" IsTabStop="True" UseSystemFocusVisuals="True">
    <primitives:Thumb x:Name="Handle" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
    <primitives:Thumb.Template>
        <ControlTemplate TargetType="primitives:Thumb">
            <Grid Background="Transparent">
                <Border Width="32" Height="2" CornerRadius="1" VerticalAlignment="Center"
                    Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            </Grid>
        </ControlTemplate>
    </primitives:Thumb.Template>
    </primitives:Thumb>
</UserControl>
