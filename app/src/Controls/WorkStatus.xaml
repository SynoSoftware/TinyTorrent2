<UserControl x:Class="Syno.TinyTorrent.Controls.WorkStatus"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icons="using:Syno">
  <Grid x:Name="Layout" ColumnSpacing="6" VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <FontIcon x:Name="Icon" Grid.RowSpan="2" Style="{StaticResource TinyTorrentStatusIconStyle}"
      FontSize="{StaticResource TinyTorrentSurfaceIconSize}"
      FontFamily="{x:Bind icons:Lucide.Font}" AutomationProperties.AccessibilityView="Raw" />
    <TextBlock x:Name="Label" Grid.Column="1" Style="{StaticResource TinyTorrentStatusTextStyle}"
      TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="Count" Grid.Column="2" Style="{StaticResource TinyTorrentStatusTextStyle}" />
    <ProgressBar x:Name="Progress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
      Margin="0,4,0,0" VerticalAlignment="Center" />
    <Button x:Name="Cancel" Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center"
      Style="{StaticResource TinyTorrentSubtleButtonStyle}">
      <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.X}"
        FontSize="{StaticResource TinyTorrentInlineIconSize}" AutomationProperties.AccessibilityView="Raw" />
    </Button>
  </Grid>
</UserControl>
