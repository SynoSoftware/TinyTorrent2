<UserControl
  x:Class="Syno.TinyTorrent.Controls.SpeedLimits"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Syno.TinyTorrent.Controls"
  xmlns:icons="using:Syno">
  <StackPanel Spacing="8">
    <Border x:Name="ModeCard" Style="{StaticResource TinyTorrentSettingsCardStyle}">
      <Grid ColumnSpacing="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <FontIcon FontFamily="{x:Bind icons:Lucide.Font}"
          Glyph="{x:Bind icons:Lucide.SlidersHorizontal}" FontSize="20" />
        <controls:SettingsRow x:Name="ModeRow" Grid.Column="1"
          Header="{x:Bind Main.Text.Get('transfer_limits', 'control'), Mode=OneWay}"
          Description="{x:Bind Main.LimitsSummary, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Main.LimitsNow, Mode=OneWay}"
          BorderThickness="0" />
      </Grid>
    </Border>
    <Grid x:Name="Profiles" ColumnSpacing="8" RowSpacing="8" Margin="0,16,0,0" SizeChanged="OnProfilesSize">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="8">
        <TextBlock Text="{x:Bind Model.Text.Get('settings', 'standard_caps'), Mode=OneWay}"
          Style="{StaticResource TinyTorrentGroupTitleTextStyle}" TextTrimming="CharacterEllipsis"
          ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'standard_caps'), Mode=OneWay}" />
        <Border x:Name="StandardCard" Style="{StaticResource TinyTorrentSettingsCardStyle}">
          <StackPanel x:Name="StandardRows" />
        </Border>
      </StackPanel>
      <StackPanel x:Name="AlternativeProfile" Grid.Column="1" Spacing="8">
        <TextBlock Text="{x:Bind Model.Text.Get('settings', 'alternative_caps'), Mode=OneWay}"
          Style="{StaticResource TinyTorrentGroupTitleTextStyle}" TextTrimming="CharacterEllipsis"
          ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'alternative_caps'), Mode=OneWay}" />
        <Border x:Name="AlternativeCard" Style="{StaticResource TinyTorrentSettingsCardStyle}">
          <StackPanel x:Name="AlternativeRows" />
        </Border>
      </StackPanel>
    </Grid>
    <Button x:Name="Connection" Click="OnConnection"
      Style="{StaticResource TinyTorrentSettingsLinkStyle}"
      AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'connection_setup'), Mode=OneWay}">
      <Grid ColumnSpacing="24" MinHeight="36">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <FontIcon FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.Gauge}" FontSize="20" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'connection_setup'), Mode=OneWay}"
            Style="{StaticResource TinyTorrentBodyTextStyle}" TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'connection_setup'), Mode=OneWay}" />
          <TextBlock Text="{x:Bind Model.Text.Get('settings', 'setup_hint'), Mode=OneWay}"
            Style="{StaticResource TinyTorrentTitleDetailTextStyle}" TextTrimming="CharacterEllipsis"
            ToolTipService.ToolTip="{x:Bind Model.Text.Get('settings', 'setup_hint'), Mode=OneWay}" />
        </StackPanel>
        <FontIcon Grid.Column="2" FontFamily="{x:Bind icons:Lucide.Font}" Glyph="{x:Bind icons:Lucide.ChevronRight}" FontSize="12" />
      </Grid>
    </Button>
  </StackPanel>
</UserControl>
