<UserControl
  x:Class="Syno.TinyTorrent.Controls.PeriodEditor"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Controls"
  xmlns:views="using:Syno.TinyTorrent.Views"
  xmlns:icons="using:Syno"
>
  <StackPanel>
    <Grid ColumnSpacing="16" Padding="0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <local:FieldHeader x:Name="PeriodError" VerticalAlignment="Center"
        Label="{x:Bind Model.Text.Get('settings', 'period_mode'), Mode=OneWay}"
        Error="{x:Bind Model.PeriodMessage, Mode=OneWay}" />
      <RadioButtons x:Name="PeriodMode" Grid.Column="1" MaxColumns="2" HorizontalAlignment="Left"
        SelectedIndex="{x:Bind Model.Draft.ModeIndex, Mode=TwoWay, FallbackValue=0}"
        IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
        AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'period_mode'), Mode=OneWay}"
        AutomationProperties.AutomationId="PeriodMode">
        <RadioButton Content="{x:Bind Model.Text.Get('settings', 'alternative'), Mode=OneWay}"
          AutomationProperties.AutomationId="AlternativeMode" />
        <RadioButton Content="{x:Bind Model.Text.Get('settings', 'pause_transfers'), Mode=OneWay}"
          AutomationProperties.AutomationId="PausedMode" />
      </RadioButtons>
    </Grid>
    <Grid ColumnSpacing="16" Padding="0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <local:FieldHeader x:Name="DaysRow" VerticalAlignment="Center"
        Label="{x:Bind Model.Text.Get('settings', 'days'), Mode=OneWay}"
        Error="{x:Bind Model.DaysMessage, Mode=OneWay}" />
      <ContentControl Grid.Column="1" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
        IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}" IsTabStop="False">
        <ItemsRepeater ItemsSource="{x:Bind Model.Draft.Days, Mode=OneWay}">
          <ItemsRepeater.Layout>
            <UniformGridLayout Orientation="Horizontal" MinItemWidth="72" MinItemHeight="40" MaximumRowsOrColumns="7" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="views:DayChoice">
              <CheckBox
                MinWidth="0"
                Content="{x:Bind Abbreviation, Mode=OneWay}"
                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
              />
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ContentControl>
    </Grid>
    <Grid x:Name="Times" ColumnSpacing="16" Padding="0,16" SizeChanged="OnTimesSize">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel x:Name="StartPair" Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center" Text="{x:Bind Model.Text.Get('settings', 'start_time'), Mode=OneWay}" />
        <TimePicker x:Name="StartTime" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"
          SelectedTime="{x:Bind Model.Draft.Start, Mode=TwoWay}"
          IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'start_time'), Mode=OneWay}"
          AutomationProperties.AutomationId="PeriodStart" />
      </StackPanel>
      <StackPanel x:Name="EndPair" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center" Text="{x:Bind Model.Text.Get('settings', 'end_time'), Mode=OneWay}" />
        <TimePicker x:Name="EndTime" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch"
          SelectedTime="{x:Bind Model.Draft.End, Mode=TwoWay}"
          IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
          AutomationProperties.Name="{x:Bind Model.Text.Get('settings', 'end_time'), Mode=OneWay}"
          AutomationProperties.AutomationId="PeriodEnd" />
      </StackPanel>
      <local:ActionButton x:Name="Delete" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
        Glyph="{x:Bind icons:Lucide.Trash2}"
        Text="{x:Bind Model.Text.Get('settings', 'delete'), Mode=OneWay}"
        IsEnabled="{x:Bind Model.CanEdit, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind Model.OpenPeriod.DeleteName, Mode=OneWay}"
        Click="OnDelete"
        AutomationProperties.Name="{x:Bind Model.OpenPeriod.DeleteName, Mode=OneWay}"
        AutomationProperties.AutomationId="DeletePeriod" />
    </Grid>
  </StackPanel>
</UserControl>
