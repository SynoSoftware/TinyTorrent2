      <Style x:Key="TinyTorrentNavigationTextStyle" TargetType="TextBlock"
        BasedOn="{StaticResource TinyTorrentBodyTextStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextLineBounds" Value="Tight" />
      </Style>
      <Style TargetType="NavigationViewItem">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style
        x:Key="TinyTorrentStatusTextStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource TinyTorrentBodyTextStyle}"
      >
        <Setter Property="TextLineBounds" Value="Tight" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="TinyTorrentStatusIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="{StaticResource TinyTorrentInlineIconSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>      <Style
        x:Key="TinyTorrentTitleDetailTextStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource BodyTextBlockStyle}"
      >
        <Setter Property="TextLineBounds" Value="Tight" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="TinyTorrentProgressStyle" TargetType="ProgressBar"
        BasedOn="{StaticResource DefaultProgressBarStyle}">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="4" />
      </Style>
      <Style x:Key="TinyTorrentMutedProgressStyle" TargetType="ProgressBar"
        BasedOn="{StaticResource TinyTorrentProgressStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style x:Key="TinyTorrentSurfaceIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="{StaticResource TinyTorrentSurfaceIconSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>
      <Style
        x:Key="TinyTorrentGroupIconStyle"
        TargetType="FontIcon"
        BasedOn="{StaticResource TinyTorrentSurfaceIconStyle}"
      >
        <Setter Property="FontSize" Value="{StaticResource TinyTorrentHeaderIconSize}" />
      </Style>
      <Style TargetType="controls:Pane">
        <Setter
          Property="Background"
          Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
        />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:Pane">
              <Grid
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
              >
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                  x:Name="Heading"
                  MinHeight="40"
                  Padding="16,0,8,0"
                  BorderThickness="0,0,0,1"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                >
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter
                    x:Name="Navigation"
                    Content="{TemplateBinding Navigation}"
                    VerticalContentAlignment="Center"
                  />
                  <ContentPresenter
                    x:Name="Identity"
                    Grid.Column="1"
                    Content="{TemplateBinding Header}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                  />
                  <ContentPresenter
                    x:Name="Actions"
                    Grid.Column="2"
                    Content="{TemplateBinding Actions}"
                    VerticalContentAlignment="Center"
                  />
                </Grid>
                <ContentPresenter
                  Grid.Row="1"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- A group at dialog density: a quiet surface, lighter than a card. -->
      <Style x:Key="TinyTorrentSectionStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter
          Property="Background"
          Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
      </Style>
      <!-- A sub-group inside a settings card: a tint without a border. -->
      <Style x:Key="TinyTorrentInnerCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{ThemeResource TinyTorrentInnerCardBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
      </Style>
      <!-- WinUI's 5-pixel top padding puts a check box label's letters one
                 pixel above the middle of the box; 6 pixels centres them. -->
      <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="Padding" Value="8,6,0,0" />
      </Style>
      <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
      </Style>
      <!-- WinUI's even 4-pixel MenuBarItem margins put a heading's letters one
                 pixel below the middle of the menu bar; 3 above and 5 below centre them. -->
      <Style TargetType="MenuBarItem">
        <Setter Property="Margin" Value="4,3,4,5" />
      </Style>
      <Style x:Key="TinyTorrentSettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16,0" />
      </Style>
      <Style x:Key="TinyTorrentSettingsLinkStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Padding" Value="16" />
      </Style>
      <Style TargetType="controls:SettingsExpander">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:SettingsExpander">
              <Grid MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}">
                <!-- Native states own the header; SettingsExpander owns the drawer height. -->
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="ExpandStates">
                    <VisualState x:Name="ExpandDown">
                      <VisualState.Setters>
                        <Setter Target="ExpanderHeader.CornerRadius"
                          Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopCornerRadiusFilterConverter}}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CollapseUp" />
                    <VisualState x:Name="ExpandUp">
                      <VisualState.Setters>
                        <Setter Target="ExpanderHeader.CornerRadius"
                          Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomCornerRadiusFilterConverter}}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CollapseDown" />
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="ExpandDirectionStates">
                    <VisualState x:Name="Down" />
                    <VisualState x:Name="Up">
                      <VisualState.Setters>
                        <Setter Target="ExpanderHeader.Style" Value="{StaticResource ExpanderHeaderUpStyle}" />
                        <Setter Target="ExpanderContent.BorderThickness" Value="{StaticResource ExpanderContentUpBorderThickness}" />
                        <Setter Target="ExpanderContent.CornerRadius"
                          Value="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TopCornerRadiusFilterConverter}}" />
                        <Setter Target="ExpanderHeader.(Grid.Row)" Value="1" />
                        <Setter Target="ExpanderContentClip.(Grid.Row)" Value="0" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ToggleButton x:Name="ExpanderHeader"
                  AutomationProperties.AutomationId="ExpanderToggleButton"
                  Style="{StaticResource ExpanderHeaderDownStyle}"
                  Background="{ThemeResource ExpanderHeaderBackground}"
                  BackgroundSizing="{TemplateBinding BackgroundSizing}"
                  BorderBrush="{ThemeResource ExpanderHeaderBorderBrush}"
                  BorderThickness="{ThemeResource ExpanderHeaderBorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  MinHeight="{TemplateBinding MinHeight}" IsEnabled="{TemplateBinding IsEnabled}"
                  Padding="{ThemeResource ExpanderHeaderPadding}" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="{StaticResource ExpanderHeaderHorizontalContentAlignment}"
                  VerticalContentAlignment="{StaticResource ExpanderHeaderVerticalContentAlignment}"
                  Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Border x:Name="ExpanderContentClip" Grid.Row="1" Height="0" Visibility="Collapsed">
                  <!-- Measure the full body independently of the animated clip height. -->
                  <StackPanel>
                    <Border x:Name="ExpanderContent"
                      Background="{TemplateBinding Background}" BackgroundSizing="{TemplateBinding BackgroundSizing}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{StaticResource ExpanderContentDownBorderThickness}"
                      CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BottomCornerRadiusFilterConverter}}"
                      MinHeight="{TemplateBinding MinHeight}" Padding="{TemplateBinding Padding}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Top">
                      <ContentPresenter Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="controls:SettingsSection">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:SettingsSection">
              <controls:SettingsExpander x:Name="SectionExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="{TemplateBinding Padding}"
                IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                AutomationProperties.Name="{TemplateBinding Header}">
                <controls:SettingsExpander.Header>
                  <Grid x:Name="HeaderLayout" MinHeight="68" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontFamily="{ThemeResource LucideFont}" Glyph="{TemplateBinding Glyph}"
                      FontSize="{StaticResource TinyTorrentHeaderIconSize}" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{TemplateBinding Header}"
                        Style="{StaticResource TinyTorrentBodyTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{TemplateBinding Header}"
                        AutomationProperties.HeadingLevel="Level2" />
                      <TextBlock x:Name="SummaryLabel"
                        Style="{StaticResource TinyTorrentTitleDetailTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </controls:SettingsExpander.Header>
                <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
              </controls:SettingsExpander>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ItemsPanelTemplate x:Key="TinyTorrentLanguagePanel">
        <controls:WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
      <Style x:Key="TinyTorrentSettingsGroupStyle" TargetType="controls:SettingsSection">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:SettingsSection">
              <StackPanel Spacing="8">
                <StackPanel Spacing="8">
                  <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource TinyTorrentGroupTitleTextStyle}"
                    TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{TemplateBinding Header}"
                    AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock x:Name="SummaryLabel" Style="{StaticResource TinyTorrentTitleDetailTextStyle}"
                    TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>
                <Border x:Name="GroupCard" Style="{StaticResource TinyTorrentSettingsCardStyle}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                </Border>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="controls:SettingsRow">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
          <Setter.Value>
            <TransitionCollection>
              <RepositionThemeTransition IsStaggeringEnabled="False" />
            </TransitionCollection>
          </Setter.Value>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:SettingsRow">
              <Grid x:Name="RowRoot" Padding="0,10" MinHeight="52" ColumnSpacing="16"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" MinHeight="32" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter x:Name="IconPresenter" Content="{TemplateBinding Icon}"
                    Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" />
                  <StackPanel Grid.Column="1" Spacing="4">
                    <controls:FieldHeader
                      Label="{TemplateBinding Header}"
                      Error="{TemplateBinding Error}" Caution="{TemplateBinding Caution}" />
                    <TextBlock x:Name="DescriptionLabel" Text="{TemplateBinding Description}"
                      Style="{StaticResource TinyTorrentTitleDetailTextStyle}"
                      TextTrimming="CharacterEllipsis"
                      ToolTipService.ToolTip="{TemplateBinding Description}" />
                  </StackPanel>
                </Grid>
                <Grid
                  x:Name="ContentLayout"
                  Grid.Column="1"
                  ColumnSpacing="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                >
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="StateColumn" Width="Auto" />
                    <ColumnDefinition x:Name="ValueColumn" Width="Auto" />
                    <ColumnDefinition x:Name="UnitColumn" Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock
                    x:Name="StateLabel"
                    Text="{TemplateBinding StateText}"
                    Margin="0,0,12,0"
                    Style="{StaticResource TinyTorrentBodyTextStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                  />
                  <ContentPresenter
                    x:Name="ContentHost"
                    Grid.Column="1"
                    Content="{TemplateBinding Content}"
                    Background="Transparent"
                    HorizontalAlignment="Right"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  />
                  <TextBlock
                    x:Name="UnitLabel"
                    Grid.Column="2"
                    Text="{TemplateBinding Unit}"
                    Margin="12,0,0,0"
                    Style="{StaticResource TinyTorrentBodyTextStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                  />
                  <ContentPresenter
                    x:Name="UnitSelectorHost"
                    Grid.Column="2"
                    Content="{TemplateBinding UnitSelector}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                  />
                </Grid>
                <ContentPresenter
                  x:Name="DetailPresenter"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="0,8,0,0"
                  Content="{TemplateBinding Detail}"
                  Visibility="{Binding Detail.Visibility, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Collapsed}"
                />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="InspectorDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
      </Style>
      <Style x:Key="InspectorRailStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
      </Style>
      <Style TargetType="controls:Section">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HeaderStyle" Value="{StaticResource TinyTorrentGroupTitleTextStyle}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:Section">
              <StackPanel Spacing="12">
                <Grid ColumnSpacing="12" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon
                    x:Name="Icon"
                    Glyph="{TemplateBinding Glyph}"
                    FontFamily="{ThemeResource LucideFont}"
                    Style="{StaticResource TinyTorrentGroupIconStyle}"
                  />
                  <StackPanel Grid.Column="1" Spacing="4">
                    <Grid HorizontalAlignment="Left">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                        Text="{TemplateBinding Header}"
                        Style="{TemplateBinding HeaderStyle}"
                        ToolTipService.ToolTip="{TemplateBinding Header}"
                        AutomationProperties.HeadingLevel="Level2"
                      />
                      <ContentControl
                        x:Name="HeaderDetailHost"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Content="{TemplateBinding HeaderDetail}"
                        IsTabStop="False"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      />
                    </Grid>
                    <ContentControl
                      x:Name="DetailHost"
                      Content="{TemplateBinding Detail}"
                      IsTabStop="False"
                      HorizontalContentAlignment="Stretch"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    />
                  </StackPanel>
                  <ContentControl
                    Grid.Column="2"
                    Content="{TemplateBinding Action}"
                    IsTabStop="False"
                    VerticalAlignment="Center"
                  />
                </Grid>
                <ContentPresenter
                  Content="{TemplateBinding Content}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                />
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style
        x:Key="InspectorValueStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource TinyTorrentStatusTextStyle}"
      >
        <Setter Property="IsTextSelectionEnabled" Value="True" />
      </Style>
      <Style
        x:Key="InspectorIdentifierStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource InspectorValueStyle}"
      >
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
      </Style>
      <Style
        x:Key="InspectorStatisticValueStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource BodyLargeTextBlockStyle}"
      >
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <!-- The strip sizes each column to its widest value, so a value that changes length must not move the others. -->
        <Setter Property="MinWidth" Value="112" />
      </Style>
      <Style
        x:Key="InspectorIconStyle"
        TargetType="FontIcon"
        BasedOn="{StaticResource TinyTorrentStatusIconStyle}"
      >
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
      </Style>
      <!-- A property: icon, label and value on one row. The value and its action
               sit in a left-aligned Grid, so its star column fits the value and the
               action follows it, while a long value still trims before the action. -->
      <Style TargetType="controls:Field">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:Field">
              <Grid ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid
                  ColumnSpacing="8"
                  Padding="{TemplateBinding Padding}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                >
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <FontIcon
                    FontFamily="{ThemeResource LucideFont}"
                    Glyph="{TemplateBinding Glyph}"
                    Style="{StaticResource InspectorIconStyle}"
                  />
                  <TextBlock
                    Grid.Column="1"
                    Text="{TemplateBinding Label}"
                    Style="{StaticResource TinyTorrentBodyTextStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    ToolTipService.ToolTip="{TemplateBinding Label}"
                  />
                </Grid>
                <Grid
                  Grid.Column="1"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  ColumnSpacing="4"
                >
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter
                    Content="{TemplateBinding Content}"
                    Padding="{TemplateBinding Padding}"
                  />
                  <!-- A second ContentPresenter here fails layout with E_INVALIDARG
                                       when the General view opens; a ContentControl does not. -->
                  <ContentControl
                    Grid.Column="1"
                    Content="{TemplateBinding Action}"
                    IsTabStop="False"
                  />
                </Grid>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- A statistic: its icon beside the caption, with the value below the caption.
               The transparent background makes the whole statistic a double-click target. -->
      <Style x:Key="InspectorStatisticStyle" TargetType="controls:Field">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:Field">
              <StackPanel Orientation="Horizontal" Spacing="12" Background="Transparent">
                <FontIcon
                  FontFamily="{ThemeResource LucideFont}"
                  Glyph="{TemplateBinding Glyph}"
                  Style="{StaticResource InspectorIconStyle}"
                  FontSize="{StaticResource TinyTorrentHeaderIconSize}"
                />
                <StackPanel>
                  <TextBlock
                    Text="{TemplateBinding Label}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="NoWrap"
                  />
                  <ContentPresenter Content="{TemplateBinding Content}" />
                </StackPanel>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- WinUI's DefaultContentDialogStyle template, changed only in the title
                 and in CommandSpace with the column numbers and widths its button
                 states set. The title is one line after the Glyph icon. The buttons
                 keep their natural width, at the right with Footer filling the
                 space at their left, or centred when there is no Footer; the row
                 has 16 pixels of padding above and below instead of 24. -->
      <Style TargetType="controls:Dialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="TitleTemplate">
          <Setter.Value>
            <DataTemplate>
              <TextBlock
                Text="{Binding}"
                Style="{StaticResource TinyTorrentSurfaceTitleTextStyle}"
              />
            </DataTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:Dialog">
              <Border x:Name="Container">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="DialogShowingStates">
                    <VisualStateGroup.Transitions>
                      <VisualTransition To="DialogHidden">
                        <Storyboard>
                          <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="LayoutRoot"
                            Storyboard.TargetProperty="Visibility"
                          >
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible" />
                          </ObjectAnimationUsingKeyFrames>
                          <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="LayoutRoot"
                            Storyboard.TargetProperty="IsHitTestVisible"
                          >
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="False" />
                          </ObjectAnimationUsingKeyFrames>
                          <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="ScaleTransform"
                            Storyboard.TargetProperty="ScaleX"
                          >
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                            <SplineDoubleKeyFrame
                              KeyTime="{StaticResource ControlFastAnimationDuration}"
                              KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                              Value="1.05"
                            />
                          </DoubleAnimationUsingKeyFrames>
                          <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="ScaleTransform"
                            Storyboard.TargetProperty="ScaleY"
                          >
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                            <SplineDoubleKeyFrame
                              KeyTime="{StaticResource ControlFastAnimationDuration}"
                              KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                              Value="1.05"
                            />
                          </DoubleAnimationUsingKeyFrames>
                          <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="LayoutRoot"
                            Storyboard.TargetProperty="Opacity"
                          >
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                            <LinearDoubleKeyFrame
                              KeyTime="{StaticResource ControlFasterAnimationDuration}"
                              Value="0.0"
                            />
                          </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                      </VisualTransition>
                      <VisualTransition To="DialogShowing">
                        <Storyboard>
                          <ObjectAnimationUsingKeyFrames
                            Storyboard.TargetName="LayoutRoot"
                            Storyboard.TargetProperty="Visibility"
                          >
                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="Visible" />
                          </ObjectAnimationUsingKeyFrames>
                          <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="ScaleTransform"
                            Storyboard.TargetProperty="ScaleX"
                          >
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.05" />
                            <SplineDoubleKeyFrame
                              KeyTime="{StaticResource ControlNormalAnimationDuration}"
                              KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                              Value="1.0"
                            />
                          </DoubleAnimationUsingKeyFrames>
                          <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="ScaleTransform"
                            Storyboard.TargetProperty="ScaleY"
                          >
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.05" />
                            <SplineDoubleKeyFrame
                              KeyTime="{StaticResource ControlNormalAnimationDuration}"
                              KeySpline="{StaticResource ControlFastOutSlowInKeySpline}"
                              Value="1.0"
                            />
                          </DoubleAnimationUsingKeyFrames>
                          <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetName="LayoutRoot"
                            Storyboard.TargetProperty="Opacity"
                          >
                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.0" />
                            <LinearDoubleKeyFrame
                              KeyTime="{StaticResource ControlFasterAnimationDuration}"
                              Value="1.0"
                            />
                          </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                      </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="DialogHidden" />
                    <VisualState x:Name="DialogShowing">
                      <VisualState.Setters>
                        <Setter Target="PrimaryButton.IsTabStop" Value="True" />
                        <Setter Target="SecondaryButton.IsTabStop" Value="True" />
                        <Setter Target="CloseButton.IsTabStop" Value="True" />
                        <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                        <Setter Target="BackgroundElement.TabFocusNavigation" Value="Cycle" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DialogShowingWithoutSmokeLayer">
                      <VisualState.Setters>
                        <Setter Target="PrimaryButton.IsTabStop" Value="True" />
                        <Setter Target="SecondaryButton.IsTabStop" Value="True" />
                        <Setter Target="CloseButton.IsTabStop" Value="True" />
                        <Setter Target="LayoutRoot.Visibility" Value="Visible" />
                        <Setter Target="LayoutRoot.Background" Value="{x:Null}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="DialogSizingStates">
                    <VisualState x:Name="DefaultDialogSizing" />
                    <VisualState x:Name="FullDialogSizing">
                      <VisualState.Setters>
                        <Setter Target="BackgroundElement.VerticalAlignment" Value="Stretch" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="ButtonsVisibilityStates">
                    <VisualState x:Name="AllVisible">
                      <VisualState.Setters>
                        <Setter
                          Target="FirstSpacer.Width"
                          Value="{ThemeResource ContentDialogButtonSpacing}"
                        />
                        <Setter Target="SecondaryColumn.Width" Value="Auto" />
                        <Setter Target="SecondaryButton.(Grid.Column)" Value="3" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NoneVisible">
                      <VisualState.Setters>
                        <Setter Target="CommandSpace.Visibility" Value="Collapsed" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PrimaryVisible">
                      <VisualState.Setters>
                        <Setter Target="PrimaryButton.(Grid.Column)" Value="5" />
                        <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                        <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SecondaryVisible">
                      <VisualState.Setters>
                        <Setter Target="SecondaryButton.(Grid.Column)" Value="5" />
                        <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                        <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CloseVisible">
                      <VisualState.Setters>
                        <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                        <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PrimaryAndSecondaryVisible">
                      <VisualState.Setters>
                        <Setter Target="SecondaryButton.(Grid.Column)" Value="5" />
                        <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PrimaryAndCloseVisible">
                      <VisualState.Setters>
                        <Setter Target="SecondaryButton.Visibility" Value="Collapsed" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SecondaryAndCloseVisible">
                      <VisualState.Setters>
                        <Setter Target="PrimaryButton.Visibility" Value="Collapsed" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="DefaultButtonStates">
                    <VisualState x:Name="NoDefaultButton" />
                    <VisualState x:Name="PrimaryAsDefaultButton">
                      <VisualState.Setters>
                        <Setter
                          Target="PrimaryButton.Style"
                          Value="{StaticResource AccentButtonStyle}"
                        />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="SecondaryAsDefaultButton">
                      <VisualState.Setters>
                        <Setter
                          Target="SecondaryButton.Style"
                          Value="{StaticResource AccentButtonStyle}"
                        />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CloseAsDefaultButton">
                      <VisualState.Setters>
                        <Setter
                          Target="CloseButton.Style"
                          Value="{StaticResource AccentButtonStyle}"
                        />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="DialogBorderStates">
                    <VisualState x:Name="NoBorder" />
                    <VisualState x:Name="AccentColorBorder">
                      <VisualState.Setters>
                        <Setter
                          Target="BackgroundElement.BorderBrush"
                          Value="{ThemeResource SystemControlForegroundAccentBrush}"
                        />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid x:Name="LayoutRoot" Visibility="Collapsed">
                  <Rectangle
                    x:Name="SmokeLayerBackground"
                    Fill="{ThemeResource ContentDialogSmokeFill}"
                  />
                  <Border
                    x:Name="BackgroundElement"
                    Background="{TemplateBinding Background}"
                    FlowDirection="{TemplateBinding FlowDirection}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinWidth="{ThemeResource ContentDialogMinWidth}"
                    MaxWidth="{ThemeResource ContentDialogMaxWidth}"
                    MinHeight="{ThemeResource ContentDialogMinHeight}"
                    MaxHeight="{ThemeResource ContentDialogMaxHeight}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5"
                  >
                    <Border.RenderTransform>
                      <ScaleTransform x:Name="ScaleTransform" />
                    </Border.RenderTransform>
                    <Grid x:Name="DialogSpace" CornerRadius="{ThemeResource OverlayCornerRadius}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <ScrollViewer
                        x:Name="ContentScrollViewer"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled"
                        ZoomMode="Disabled"
                        IsTabStop="False"
                      >
                        <Grid
                          Background="{ThemeResource ContentDialogTopOverlay}"
                          Padding="{ThemeResource ContentDialogPadding}"
                          BorderThickness="{ThemeResource ContentDialogSeparatorThickness}"
                          BorderBrush="{ThemeResource ContentDialogSeparatorBorderBrush}"
                        >
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <Grid
                            x:Name="TitleArea"
                            Margin="{ThemeResource ContentDialogTitleMargin}"
                            ColumnSpacing="12"
                          >
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                              x:Name="TitleIcon"
                              Style="{StaticResource TinyTorrentSurfaceIconStyle}"
                            />
                            <ContentControl
                              x:Name="Title"
                              Grid.Column="1"
                              Content="{TemplateBinding Title}"
                              ContentTemplate="{TemplateBinding TitleTemplate}"
                              FontFamily="{StaticResource ContentControlThemeFontFamily}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsTabStop="False"
                            >
                              <ContentControl.Template>
                                <ControlTemplate TargetType="ContentControl">
                                  <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    TextWrapping="NoWrap"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  />
                                </ControlTemplate>
                              </ContentControl.Template>
                            </ContentControl>
                          </Grid>
                          <ContentPresenter
                            x:Name="Content"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            FontSize="{StaticResource ControlContentThemeFontSize}"
                            FontFamily="{StaticResource ContentControlThemeFontFamily}"
                            Foreground="{TemplateBinding Foreground}"
                            Grid.Row="1"
                            TextWrapping="Wrap"
                          />
                        </Grid>
                      </ScrollViewer>
                      <Grid
                        x:Name="CommandSpace"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        XYFocusKeyboardNavigation="Enabled"
                        Padding="24,16"
                        Background="{TemplateBinding Background}"
                      >
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition x:Name="PrimaryColumn" Width="Auto" />
                          <ColumnDefinition x:Name="FirstSpacer" Width="0" />
                          <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                          <ColumnDefinition
                            x:Name="SecondSpacer"
                            Width="{ThemeResource ContentDialogButtonSpacing}"
                          />
                          <ColumnDefinition x:Name="CloseColumn" Width="Auto" />
                          <ColumnDefinition x:Name="EndColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <!-- A ContentPresenter would show the dialog's Content when Footer is null. -->
                        <ContentControl
                          x:Name="FooterHost"
                          Content="{TemplateBinding Footer}"
                          IsTabStop="False"
                          Margin="0,0,24,0"
                          VerticalAlignment="Center"
                        />
                        <controls:ActionButton
                          x:Name="PrimaryButton"
                          Glyph="{TemplateBinding PrimaryGlyph}"
                          ToolTipService.ToolTip="{TemplateBinding PrimaryToolTip}"
                          IsTabStop="False"
                          Grid.Column="1"
                          MinWidth="120"
                          MinHeight="{ThemeResource ContentDialogButtonMinHeight}"
                          VerticalContentAlignment="Center"
                          Text="{TemplateBinding PrimaryButtonText}"
                          IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                          Style="{TemplateBinding PrimaryButtonStyle}"
                          ElementSoundMode="FocusOnly"
                          HorizontalAlignment="Stretch"
                        />
                        <controls:ActionButton
                          x:Name="SecondaryButton"
                          Glyph="{TemplateBinding SecondaryGlyph}"
                          ToolTipService.ToolTip="{TemplateBinding SecondaryToolTip}"
                          IsTabStop="False"
                          Grid.Column="1"
                          MinWidth="120"
                          MinHeight="{ThemeResource ContentDialogButtonMinHeight}"
                          VerticalContentAlignment="Center"
                          Text="{TemplateBinding SecondaryButtonText}"
                          IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
                          Style="{TemplateBinding SecondaryButtonStyle}"
                          ElementSoundMode="FocusOnly"
                          HorizontalAlignment="Stretch"
                        />
                        <controls:ActionButton
                          x:Name="CloseButton"
                          Glyph="{TemplateBinding CloseGlyph}"
                          ToolTipService.ToolTip="{TemplateBinding CloseToolTip}"
                          IsTabStop="False"
                          Grid.Column="5"
                          MinWidth="120"
                          MinHeight="{ThemeResource ContentDialogButtonMinHeight}"
                          VerticalContentAlignment="Center"
                          Text="{TemplateBinding CloseButtonText}"
                          Style="{TemplateBinding CloseButtonStyle}"
                          ElementSoundMode="FocusOnly"
                          HorizontalAlignment="Stretch"
                        />
                      </Grid>
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
