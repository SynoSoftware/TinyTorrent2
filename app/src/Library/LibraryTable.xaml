<UserControl
  x:Class="Syno.TinyTorrent.Library.LibraryTable"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Library">
  <UserControl.Resources>
    <DataTemplate x:Key="Name" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" FlowDirection="LeftToRight" /></DataTemplate>
    <DataTemplate x:Key="Folder" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Folder, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" FlowDirection="LeftToRight" /></DataTemplate>
    <DataTemplate x:Key="Title" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Type" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Type, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Year" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Year, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Genres" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Genres, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Cast" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Cast, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Artist" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Artist, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Album" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Album, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Track" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Track, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Duration" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Duration, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Size" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Size, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Modified" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Modified, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
    <DataTemplate x:Key="Kind" x:DataType="local:LibraryRow"><TextBlock Text="{x:Bind Kind, Mode=OneWay}" Style="{StaticResource TinyTorrentBodyTextStyle}" /></DataTemplate>
  </UserControl.Resources>
  <Grid x:Name="Host" />
</UserControl>
