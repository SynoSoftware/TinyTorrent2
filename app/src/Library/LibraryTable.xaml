<UserControl
  x:Class="Syno.TinyTorrent.Library.LibraryTable"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TinyTorrent.Library"
  xmlns:table="using:Syno.TableView"
>
  <UserControl.Resources>
    <DataTemplate x:Key="Name" x:DataType="local:LibraryRow">
      <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Failure, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
          FontFamily="{ThemeResource LucideFont}"
          Glyph="{x:Bind Glyph, Mode=OneWay}"
          Style="{StaticResource TinyTorrentStatusIconStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          AutomationProperties.AccessibilityView="Raw"
        />
        <TextBlock
          Grid.Column="1"
          Text="{x:Bind Name, Mode=OneWay}"
          Style="{StaticResource TinyTorrentIdentityTextStyle}"
          FlowDirection="LeftToRight"
        />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Folder" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Folder, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        FlowDirection="LeftToRight"
      />
    </DataTemplate>
    <DataTemplate x:Key="Title" x:DataType="local:LibraryRow">
      <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Failure, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon
          FontFamily="{ThemeResource LucideFont}"
          Glyph="{x:Bind Glyph, Mode=OneWay}"
          Style="{StaticResource TinyTorrentStatusIconStyle}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          AutomationProperties.AccessibilityView="Raw"
        />
        <TextBlock
          Grid.Column="1"
          Text="{x:Bind Title, Mode=OneWay}"
          Style="{StaticResource TinyTorrentIdentityTextStyle}"
        />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="Type" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Type, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Year" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind YearCell, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Subtitles" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Subtitles, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind SubtitlesTip, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="ImdbRating" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind ImdbRating, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind ImdbTip, Mode=OneWay}"
        AutomationProperties.HelpText="{x:Bind ImdbTip, Mode=OneWay}"
        Style="{x:Bind local:LibraryTable.RatingStyle(Entry.Ratings, local:RatingSource.Imdb), Mode=OneWay}"
      />
    </DataTemplate>
    <DataTemplate x:Key="TmdbRating" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind TmdbRating, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind TmdbTip, Mode=OneWay}"
        AutomationProperties.HelpText="{x:Bind TmdbTip, Mode=OneWay}"
        Style="{x:Bind local:LibraryTable.RatingStyle(Entry.Ratings, local:RatingSource.Tmdb), Mode=OneWay}"
      />
    </DataTemplate>
    <DataTemplate x:Key="RottenTomatoesRating" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind RottenTomatoesRating, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind RottenTomatoesTip, Mode=OneWay}"
        AutomationProperties.HelpText="{x:Bind RottenTomatoesTip, Mode=OneWay}"
        Style="{x:Bind local:LibraryTable.RatingStyle(Entry.Ratings, local:RatingSource.RottenTomatoes), Mode=OneWay}"
      />
    </DataTemplate>
    <DataTemplate x:Key="PopcornmeterRating" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind PopcornmeterRating, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind PopcornmeterTip, Mode=OneWay}"
        AutomationProperties.HelpText="{x:Bind PopcornmeterTip, Mode=OneWay}"
        Style="{x:Bind local:LibraryTable.RatingStyle(Entry.Ratings, local:RatingSource.Popcornmeter), Mode=OneWay}"
      />
    </DataTemplate>
    <DataTemplate x:Key="MetacriticRating" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind MetacriticRating, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind MetacriticTip, Mode=OneWay}"
        AutomationProperties.HelpText="{x:Bind MetacriticTip, Mode=OneWay}"
        Style="{x:Bind local:LibraryTable.RatingStyle(Entry.Ratings, local:RatingSource.Metacritic), Mode=OneWay}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Genres" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind GenresCell, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Cast" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind CastCell, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Artist" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Artist, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Album" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Album, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Track" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Track, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Duration" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Duration, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Bitrate" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Bitrate, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Resolution" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Resolution, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Size" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Size, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Modified" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Modified, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      />
    </DataTemplate>
    <DataTemplate x:Key="Kind" x:DataType="local:LibraryRow">
      <TextBlock
        Text="{x:Bind Kind, Mode=OneWay}"
        Style="{StaticResource TinyTorrentBodyTextStyle}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      />
    </DataTemplate>
    <DataTemplate x:Key="LibraryVideosTable">
      <table:Table AutomationProperties.AutomationId="LibraryTable">
        <table:Table.Columns>
          <table:Column
            Id="title"
            CellTemplate="{StaticResource Title}"
            Width="300"
            MinWidth="160"
            CanHide="False"
          />
          <table:Column Id="type" CellTemplate="{StaticResource Type}" />
          <table:Column Id="year" CellTemplate="{StaticResource Year}" />
          <table:Column
            Id="duration"
            CellTemplate="{StaticResource Duration}"
            CellAlignment="Right"
          />
          <table:Column
            Id="resolution"
            CellTemplate="{StaticResource Resolution}"
            IsVisible="False"
          />
          <table:Column
            Id="bitrate"
            CellTemplate="{StaticResource Bitrate}"
            CellAlignment="Right"
            IsVisible="False"
          />
          <table:Column Id="subtitles" CellTemplate="{StaticResource Subtitles}" />
          <table:Column
            Id="imdb"
            CellTemplate="{StaticResource ImdbRating}"
            Width="110"
            CellAlignment="Right"
          />
          <table:Column
            Id="tmdb"
            CellTemplate="{StaticResource TmdbRating}"
            Width="110"
            CellAlignment="Right"
          />
          <table:Column
            Id="rottentomatoes"
            CellTemplate="{StaticResource RottenTomatoesRating}"
            Width="140"
            CellAlignment="Right"
          />
          <table:Column
            Id="popcornmeter"
            CellTemplate="{StaticResource PopcornmeterRating}"
            Width="120"
            CellAlignment="Right"
          />
          <table:Column
            Id="metacritic"
            CellTemplate="{StaticResource MetacriticRating}"
            Width="110"
            CellAlignment="Right"
            IsVisible="False"
          />
          <table:Column Id="genres" CellTemplate="{StaticResource Genres}" />
          <table:Column Id="cast" CellTemplate="{StaticResource Cast}" IsVisible="False" />
          <table:Column
            Id="size"
            CellTemplate="{StaticResource Size}"
            Width="110"
            CellAlignment="Right"
            IsVisible="False"
          />
          <table:Column
            Id="name"
            CellTemplate="{StaticResource Name}"
            Width="300"
            IsVisible="False"
          />
          <table:Column
            Id="folder"
            CellTemplate="{StaticResource Folder}"
            Width="300"
            IsVisible="False"
          />
          <table:Column Id="modified" CellTemplate="{StaticResource Modified}" IsVisible="False" />
        </table:Table.Columns>
      </table:Table>
    </DataTemplate>
    <DataTemplate x:Key="LibraryMusicTable">
      <table:Table AutomationProperties.AutomationId="LibraryTable">
        <table:Table.Columns>
          <table:Column
            Id="title"
            CellTemplate="{StaticResource Title}"
            Width="300"
            MinWidth="160"
            CanHide="False"
          />
          <table:Column Id="artist" CellTemplate="{StaticResource Artist}" />
          <table:Column Id="album" CellTemplate="{StaticResource Album}" />
          <table:Column Id="track" CellTemplate="{StaticResource Track}" />
          <table:Column
            Id="duration"
            CellTemplate="{StaticResource Duration}"
            CellAlignment="Right"
          />
          <table:Column Id="year" CellTemplate="{StaticResource Year}" />
          <table:Column
            Id="bitrate"
            CellTemplate="{StaticResource Bitrate}"
            CellAlignment="Right"
            IsVisible="False"
          />
          <table:Column Id="genres" CellTemplate="{StaticResource Genres}" IsVisible="False" />
          <table:Column
            Id="name"
            CellTemplate="{StaticResource Name}"
            Width="300"
            IsVisible="False"
          />
          <table:Column
            Id="folder"
            CellTemplate="{StaticResource Folder}"
            Width="300"
            IsVisible="False"
          />
          <table:Column
            Id="size"
            CellTemplate="{StaticResource Size}"
            Width="110"
            CellAlignment="Right"
            IsVisible="False"
          />
          <table:Column Id="modified" CellTemplate="{StaticResource Modified}" IsVisible="False" />
        </table:Table.Columns>
      </table:Table>
    </DataTemplate>
    <DataTemplate x:Key="LibraryFilesTable">
      <table:Table AutomationProperties.AutomationId="LibraryTable">
        <table:Table.Columns>
          <table:Column
            Id="name"
            CellTemplate="{StaticResource Name}"
            Width="300"
            MinWidth="160"
            CanHide="False"
          />
          <table:Column Id="folder" CellTemplate="{StaticResource Folder}" Width="300" />
          <table:Column
            Id="size"
            CellTemplate="{StaticResource Size}"
            Width="110"
            CellAlignment="Right"
          />
          <table:Column Id="modified" CellTemplate="{StaticResource Modified}" />
          <table:Column Id="kind" CellTemplate="{StaticResource Kind}" IsVisible="False" />
          <table:Column
            Id="title"
            CellTemplate="{StaticResource Title}"
            Width="300"
            IsVisible="False"
          />
          <table:Column
            Id="duration"
            CellTemplate="{StaticResource Duration}"
            CellAlignment="Right"
            IsVisible="False"
          />
          <table:Column
            Id="resolution"
            CellTemplate="{StaticResource Resolution}"
            IsVisible="False"
          />
          <table:Column
            Id="bitrate"
            CellTemplate="{StaticResource Bitrate}"
            CellAlignment="Right"
            IsVisible="False"
          />
        </table:Table.Columns>
      </table:Table>
    </DataTemplate>
  </UserControl.Resources>
  <Grid x:Name="Host" />
</UserControl>
