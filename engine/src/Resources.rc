#include <windows.h>
#include "Resources.h"
#define PRODUCT_NAME "TinyTorrent"
// The resource compiler drops TT_VERSION's escaped quotes, so the text is
// built from the numeric parts.
#define TEXT_OF(value) #value
#define VERSION_TEXT(major, minor, build, revision) TEXT_OF(major.minor.build.revision)
IDR_ENGLISH_TEXT RCDATA "Resources/en.json"
IDI_TINYTORRENT ICON "../../resources/TinyTorrent.ico"
IDR_SPANISH_TEXT RCDATA "Resources/es.json"
STRINGTABLE
BEGIN
    IDS_PRODUCT_NAME PRODUCT_NAME
END
// Task Manager, Startup apps and the firewall prompt show FileDescription;
// without it they show the bare file name.
VS_VERSION_INFO VERSIONINFO
FILEVERSION TT_VERSION_MAJOR, TT_VERSION_MINOR, TT_VERSION_BUILD, TT_VERSION_REVISION
PRODUCTVERSION TT_VERSION_MAJOR, TT_VERSION_MINOR, TT_VERSION_BUILD, TT_VERSION_REVISION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", PRODUCT_NAME
            VALUE "ProductName", PRODUCT_NAME
            VALUE "FileVersion", VERSION_TEXT(TT_VERSION_MAJOR, TT_VERSION_MINOR, TT_VERSION_BUILD, TT_VERSION_REVISION)
            VALUE "ProductVersion", VERSION_TEXT(TT_VERSION_MAJOR, TT_VERSION_MINOR, TT_VERSION_BUILD, TT_VERSION_REVISION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
