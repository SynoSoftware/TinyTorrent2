<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{537AA260-FEA5-49AC-A79E-E79BF6AE966B}</ProjectGuid>
    <RootNamespace>Engine</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />

  <!-- After Microsoft.Cpp.Default.props, which imports Directory.Build.props and so ArtifactsPath. -->
  <PropertyGroup>
    <OutDir>$(ArtifactsPath)\bin\$(MSBuildProjectName)\$(Configuration)\</OutDir>
    <IntDir>$(ArtifactsPath)\obj\$(MSBuildProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <!-- The dependencies that Dependencies.ps1 builds into 3rdParty: static libraries and, with
       RuntimeLibrary below, the static C runtime, so the engine is one executable with no
       dependency DLLs beside it. -->
  <PropertyGroup>
    <ThirdPartyPath>$(MSBuildThisFileDirectory)..\..\3rdParty\</ThirdPartyPath>
    <!-- External, so warnings and code analysis report only the engine's own code. -->
    <ExternalIncludePath>$(ThirdPartyPath)$(Configuration)\include;$(ThirdPartyPath)boost;$(ThirdPartyPath)json\include;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <DisableAnalyzeExternal>true</DisableAnalyzeExternal>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ThirdPartyPath)$(Configuration)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>torrent-rasterbar.lib;libssl.lib;libcrypto.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- libtorrent's Debug build prints assertion backtraces through dbghelp. -->
      <AdditionalDependencies Condition="'$(Configuration)'=='Debug'">dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>Precompiled.h</PrecompiledHeaderFile>
      <ForcedIncludeFiles>Precompiled.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>advapi32.lib;shell32.lib;user32.lib;ole32.lib;uuid.lib;crypt32.lib;iphlpapi.lib;propsys.lib;dwmapi.lib;uxtheme.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="Precompiled.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Main.cpp" />
    <ClCompile Include="Engine.cpp" />
    <ClCompile Include="Engine\Session.cpp" />
    <ClCompile Include="Engine\Settings.cpp" />
    <ClCompile Include="Engine\Policy.cpp" />
    <ClCompile Include="Engine\Details.cpp" />
    <ClCompile Include="Engine\History.cpp" />
    <ClCompile Include="Engine\Files.cpp" />
    <ClCompile Include="Engine\Previews.cpp" />
    <ClCompile Include="Engine\Additions.cpp" />
    <ClCompile Include="Engine\Commands.cpp" />
    <ClCompile Include="Engine\Queue.cpp" />
    <ClCompile Include="Engine\Checkpoints.cpp" />
    <ClCompile Include="Engine\Exit.cpp" />
    <ClCompile Include="Engine\Alerts.cpp" />
    <ClCompile Include="Changes.cpp" />
    <ClCompile Include="Log.cpp" />
    <ClCompile Include="Torrent.cpp" />
    <ClCompile Include="Store.cpp" />
    <ClCompile Include="Strings.cpp" />
    <ClCompile Include="Registration.cpp" />
    <ClCompile Include="Pipe.cpp" />
    <ClCompile Include="Desktop\Application.cpp" />
    <ClCompile Include="Desktop\PowerRequest.cpp" />
    <ClCompile Include="Desktop\Splash.cpp" />
    <ClCompile Include="Desktop\Tray.cpp" />
    <ResourceCompile Include="Resources.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Dependencies.ps1" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />

  <!-- A build never starts Dependencies.ps1, so a build after 3rdParty was moved or removed
       stops here instead of downloading and compiling every dependency again. The repository
       owner runs the script. Design-time builds skip the check, so the project still opens in
       Visual Studio without 3rdParty. -->
  <Target Name="Dependencies" Condition="!Exists('$(ThirdPartyPath)complete') And '$(DesignTimeBuild)' != 'true'">
    <Error Text="3rdParty has no complete installation. A build never creates it: the repository owner runs engine\src\Dependencies.ps1." />
  </Target>

  <!-- libtorrent's public compile definitions, as its build in 3rdParty exported them. A
       definition that differs from the library's changes libtorrent's types under the engine
       and corrupts memory at runtime with no build error. IntelliSense reads them through
       GetClCommandLines. -->
  <Target Name="LibtorrentDefinitions" DependsOnTargets="Dependencies" BeforeTargets="ClCompile;GetClCommandLines">
    <ReadLinesFromFile File="$(ThirdPartyPath)$(Configuration)\libtorrent.definitions">
      <Output TaskParameter="Lines" ItemName="LibtorrentDefinition" />
    </ReadLinesFromFile>
    <Error Condition="'@(LibtorrentDefinition)' == '' And '$(DesignTimeBuild)' != 'true'" Text="$(ThirdPartyPath)$(Configuration)\libtorrent.definitions is missing. A build never creates it: the repository owner runs engine\src\Dependencies.ps1." />
    <PropertyGroup>
      <LibtorrentDefinitions>@(LibtorrentDefinition)</LibtorrentDefinitions>
    </PropertyGroup>
    <ItemGroup>
      <ClCompile>
        <PreprocessorDefinitions>$(LibtorrentDefinitions);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
