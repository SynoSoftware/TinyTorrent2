<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Must match the app projects. They declare x86;x64;ARM64 and have no AnyCPU, so a
         solution defaulting to AnyCPU cannot map onto them. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RootNamespace>Syno.TableView</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
  </ItemGroup>

  <!-- Strings reads the control's text from this file by its logical name. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The table's generated menu and sort glyphs draw from Lucide, so a host does not have to
       supply an icon font for them to look right. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Lucide\src\Lucide.csproj" />
  </ItemGroup>
</Project>
