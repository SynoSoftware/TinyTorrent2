<Page
  x:Class="Syno.TableViewSample.Planning.PlanPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TableViewSample.Planning"
  xmlns:t="using:Syno.TableView"
>
  <Grid Padding="12" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock
      Text="Project plan — expand activities, sort siblings, and select across branches."
      Style="{StaticResource BodyTextStyle}"
    />
    <t:Table x:Name="Table" Grid.Row="1" AutomationProperties.Name="Project plan">
      <t:Table.Columns>
        <t:Column x:Name="NameColumn" DisplayName="Activity" Width="400">
          <t:Column.CellTemplate>
            <DataTemplate x:DataType="local:Activity">
              <TextBlock
                Text="{x:Bind Name}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
              />
            </DataTemplate>
          </t:Column.CellTemplate>
        </t:Column>
        <t:Column x:Name="HoursColumn" DisplayName="Hours" Width="120" CellAlignment="Right">
          <t:Column.CellTemplate>
            <DataTemplate x:DataType="local:Activity">
              <TextBlock Text="{x:Bind Hours}" VerticalAlignment="Center" />
            </DataTemplate>
          </t:Column.CellTemplate>
        </t:Column>
      </t:Table.Columns>
    </t:Table>
  </Grid>
</Page>
