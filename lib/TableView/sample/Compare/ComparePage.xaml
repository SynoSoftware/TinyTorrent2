<Page
  x:Class="Syno.TableViewSample.Compare.ComparePage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Syno.TableViewSample.Compare"
  xmlns:t="using:Syno.TableView"
>
  <Page.Resources>
    <!-- Name starts at 12 and the speed ends 12 before the right edge, which is where the
         table's default cell padding puts the same two texts. -->
    <DataTemplate x:Key="RowTemplate" x:DataType="local:CompareRow">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="236" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="96" />
        </Grid.ColumnDefinitions>
        <TextBlock
          Grid.Column="0"
          Text="{x:Bind Name}"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis"
        />
        <TextBlock
          Grid.Column="2"
          Text="{x:Bind SpeedText, Mode=OneWay}"
          VerticalAlignment="Center"
          TextAlignment="Right"
        />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid Padding="12" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Update speeds" Click="OnUpdateSpeeds" />
      <Button Content="Switch list" Click="OnSwitchList" />
      <Button Content="Replace rows" Click="OnReplaceRows" />
      <ToggleButton x:Name="AutoButton" Content="Auto" Click="OnAutoClicked" />
      <ToggleButton x:Name="RowCountButton" Content="Rows: 40" Click="OnRowCountClicked" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" RowSpacing="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="TableView" Style="{StaticResource SubtitleTextBlockStyle}" />
        <t:Table
          x:Name="Table"
          Grid.Row="1"
          AutomationProperties.Name="TableView"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
        >
          <t:Table.Columns>
            <t:Column x:Name="NameColumn" DisplayName="Name" Width="260">
              <t:Column.CellTemplate>
                <DataTemplate x:DataType="local:CompareRow">
                  <TextBlock
                    Text="{x:Bind Name}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                  />
                </DataTemplate>
              </t:Column.CellTemplate>
            </t:Column>
            <t:Column x:Name="SpeedColumn" DisplayName="Speed" Width="120" CellAlignment="Right">
              <t:Column.CellTemplate>
                <DataTemplate x:DataType="local:CompareRow">
                  <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" VerticalAlignment="Center" />
                </DataTemplate>
              </t:Column.CellTemplate>
            </t:Column>
          </t:Table.Columns>
        </t:Table>
      </Grid>

      <Grid Grid.Column="1" RowSpacing="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Plain WinUI ListView" Style="{StaticResource SubtitleTextBlockStyle}" />
        <ListView
          x:Name="Plain"
          Grid.Row="1"
          AutomationProperties.Name="Plain WinUI ListView"
          SelectionMode="Extended"
          ItemTemplate="{StaticResource RowTemplate}"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
        />
      </Grid>
    </Grid>
  </Grid>
</Page>
