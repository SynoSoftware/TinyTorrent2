<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Must match the app projects. They declare x86;x64;ARM64 and have no AnyCPU, so a
         solution defaulting to AnyCPU cannot map onto them. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RootNamespace>Synapse</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
  </ItemGroup>

  <!--
    The control's own icon font, so a host does not have to supply one for the table's generated
    menu to look right. Byte-identical to the copy already vendored in LabForms and Pharmacy, which
    is where the ms-appx font syntax used in Generic.xaml comes from.
  -->
  <ItemGroup>
    <Content Include="Assets\Fonts\lucide.ttf" />
  </ItemGroup>
</Project>
