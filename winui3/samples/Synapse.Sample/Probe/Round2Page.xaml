<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Synapse_Sample.Round2Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synapse_Sample"
    Background="White">

    <Page.Resources>

        <!--  Content starts with a hard-edged 6 DIP pure-blue marker at content x = 0.
              A pixel scan for blue then reports the content origin with no glyph
              anti-aliasing to argue about.  -->
        <DataTemplate x:Key="MarkerTemplate">
            <StackPanel Orientation="Horizontal" Height="32">
                <Border Width="6" Background="#FF0000FF" />
                <TextBlock Text="H" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!--  Same marker, but preceded by 60 DIP of empty content so the container's own
              left-hand chrome (selection indicator, check box, focus rectangle) is not
              painted over by the marker.  -->
        <DataTemplate x:Key="GutterTemplate">
            <StackPanel Orientation="Horizontal" Height="32">
                <Border Width="60" Background="Transparent" />
                <Border Width="6" Background="#FF0000FF" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <TextBlock Text="{Binding}" Height="28" FontSize="14" />
        </DataTemplate>

        <!--  Row template: custom panel root, 2000 DIP of cells, one distinct colour each.  -->
        <DataTemplate x:Key="RowTemplate">
            <local:RowPanel>
                <Border Background="#FF101080"><TextBlock Margin="4" Text="c0" Foreground="White" /></Border>
                <Border Background="#FF20A0FF"><TextBlock Margin="4" Text="c1" Foreground="White" /></Border>
                <Border Background="#FF30C030"><TextBlock Margin="4" Text="c2" Foreground="White" /></Border>
                <Border Background="#FFFFD000"><TextBlock Margin="4" Text="c3" Foreground="Black" /></Border>
                <Border Background="#FFFF6000"><TextBlock Margin="4" Text="c4" Foreground="Black" /></Border>
                <Border Background="#FFE00040"><TextBlock Margin="4" Text="c5" Foreground="White" /></Border>
                <Border Background="#FF9000C0"><TextBlock Margin="4" Text="c6" Foreground="White" /></Border>
                <Border Background="#FF00C0C0"><TextBlock Margin="4" Text="c7" Foreground="Black" /></Border>
                <Border Background="#FF80FF00"><TextBlock Margin="4" Text="c8" Foreground="Black" /></Border>
                <Border Background="#FF404040"><TextBlock Margin="4" Text="c9" Foreground="White" /></Border>
            </local:RowPanel>
        </DataTemplate>

        <Style x:Key="TightItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="TableItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <ItemsPanelTemplate x:Key="IspPanel">
            <ItemsStackPanel />
        </ItemsPanelTemplate>

    </Page.Resources>

    <Grid>
        <Grid x:Name="Host"
              Width="900"
              Height="400"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="White" />
    </Grid>
</Page>
