<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Synapse_Sample.Round4Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synapse_Sample">

    <Page.Resources>

        <Style x:Key="R4RowStyle" TargetType="ListViewItem"
               BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <DataTemplate x:Key="R4PlainRow">
            <Grid Height="32" Background="Transparent">
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{Binding Name}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="R4CellRow">
            <local:RowPanel>
                <Border Background="#FF101080"><TextBlock Margin="4" Text="c0" Foreground="White" /></Border>
                <Border Background="#FF20A0FF"><TextBlock Margin="4" Text="c1" Foreground="White" /></Border>
                <Border Background="#FF30C030"><TextBlock Margin="4" Text="c2" Foreground="White" /></Border>
                <Border Background="#FFFFD000"><TextBlock Margin="4" Text="c3" Foreground="Black" /></Border>
                <Border Background="#FFFF6000"><TextBlock Margin="4" Text="c4" Foreground="Black" /></Border>
                <Border Background="#FFE00040"><TextBlock Margin="4" Text="c5" Foreground="White" /></Border>
                <Border Background="#FF9000C0"><TextBlock Margin="4" Text="c6" Foreground="White" /></Border>
                <Border Background="#FF00C0C0"><TextBlock Margin="4" Text="c7" Foreground="Black" /></Border>
                <Border Background="#FF80FF00"><TextBlock Margin="4" Text="c8" Foreground="Black" /></Border>
                <Border Background="#FF404040"><TextBlock Margin="4" Text="c9" Foreground="White" /></Border>
            </local:RowPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="R4Isp">
            <ItemsStackPanel />
        </ItemsPanelTemplate>

    </Page.Resources>

    <Grid>
        <Grid x:Name="Host"
              Width="900"
              Height="560"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
    </Grid>
</Page>
