<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Synapse_Sample.TableDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synapse_Sample"
    xmlns:t="using:Synapse"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:ThemeBrush x:Key="ThemeBrush" />

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="IndexCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind Index}"
                       Style="{StaticResource CellText}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

        <!--
            Name, fault indicator and pending badge, which is what the reference host draws here
            too. Both extra elements are x:Load: a few rows in a thousand carry a fault and two
            carry the pending badge, so the rest build neither.
        -->
        <DataTemplate x:Key="NameCell" x:DataType="local:DemoRow">
            <Grid VerticalAlignment="Center"
                  ColumnSpacing="6"
                  Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="FaultIcon"
                          x:Load="{x:Bind HasFault}"
                          Grid.Column="0"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE783;"
                          FontSize="14"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          AutomationProperties.Name="Fault">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind Fault}" />
                    </ToolTipService.ToolTip>
                </FontIcon>

                <TextBlock Grid.Column="1"
                           Style="{StaticResource CellText}"
                           Text="{x:Bind Name}" />

                <Border x:Name="PendingBadge"
                        x:Load="{x:Bind IsPending, Mode=OneWay}"
                        Grid.Column="2"
                        Padding="6,1"
                        CornerRadius="3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                    <TextBlock Text="Cancelling&#x2026;"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!--
            A Grid, not a StackPanel: the declared column cannot fit every label, so the label needs
            a bounded column to trim inside instead of being cut.
        -->
        <DataTemplate x:Key="StateCell" x:DataType="local:DemoRow">
            <Border Padding="8,2"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="{x:Bind StateGlyph, Mode=OneWay}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Foreground="{x:Bind StateAccentKey, Mode=OneWay, Converter={StaticResource ThemeBrush}}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind StateText, Mode=OneWay}"
                               FontSize="12"
                               Style="{StaticResource CellText}"
                               Foreground="{x:Bind StateAccentKey, Mode=OneWay, Converter={StaticResource ThemeBrush}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProgressCell" x:DataType="local:DemoRow">
            <Grid VerticalAlignment="Center" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0"
                             Minimum="0"
                             Maximum="100"
                             Height="4"
                             Value="{x:Bind Progress, Mode=OneWay}" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ProgressText, Mode=OneWay}"
                               FontSize="11.5" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource CellText}"
                               Text="{x:Bind DoneText, Mode=OneWay}"
                               FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Both directions, drawn together: a job pulls assets in and writes frames out. -->
        <DataTemplate x:Key="ThroughputCell" x:DataType="local:DemoRow">
            <Grid VerticalAlignment="Center" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource CellText}"
                           Text="{x:Bind InRateText, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource CellText}"
                           Text="{x:Bind OutRateText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WorkersCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind WorkersText, Mode=OneWay}"
                       Style="{StaticResource CellText}"
                       TextAlignment="Right" />
        </DataTemplate>

        <DataTemplate x:Key="YieldCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind YieldText, Mode=OneWay}"
                       Style="{StaticResource CellText}"
                       TextAlignment="Right" />
        </DataTemplate>

        <DataTemplate x:Key="RemainingCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind RemainingText, Mode=OneWay}"
                       Style="{StaticResource CellText}" />
        </DataTemplate>

        <DataTemplate x:Key="SubmittedCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind SubmittedText}"
                       Style="{StaticResource CellText}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="FinishedCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind FinishedText, Mode=OneWay}"
                       Style="{StaticResource CellText}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="ActionCell" x:DataType="local:DemoRow">
            <Button Content="Details"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="OnDetailsClick" />
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="Caption"
                       Text="Render queue"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="Status"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <t:TableView x:Name="Table"
                     Grid.Row="1"
                     AutomationProperties.Name="Render queue"
                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                     BorderThickness="1">
            <t:TableView.Columns>
                <!-- The sort key no tick moves: a reversal of this column is the same operation
                     whatever the feed is doing, which is what makes two runs comparable. -->
                <t:TableColumn x:Name="IndexColumn"
                               DisplayName="#"
                               Width="56"
                               MinWidth="44"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource IndexCell}" />
                <t:TableColumn x:Name="NameColumn"
                               DisplayName="Job"
                               Width="300"
                               MinWidth="160"
                               CellAlignment="Stretch"
                               CellTemplate="{StaticResource NameCell}" />
                <t:TableColumn x:Name="StateColumn"
                               DisplayName="State"
                               Width="150"
                               MinWidth="120"
                               CellTemplate="{StaticResource StateCell}" />
                <!-- A bar has to fill its column, so this cell is stretched, not left-aligned. -->
                <t:TableColumn x:Name="ProgressColumn"
                               DisplayName="Progress"
                               Width="240"
                               MinWidth="160"
                               CellAlignment="Stretch"
                               CellTemplate="{StaticResource ProgressCell}" />
                <!-- Sorted by this, every publish gives a different order: it is the case
                     specification 9's settling interval exists for. -->
                <t:TableColumn x:Name="ThroughputColumn"
                               DisplayName="Throughput"
                               Width="170"
                               MinWidth="140"
                               CellAlignment="Stretch"
                               CellTemplate="{StaticResource ThroughputCell}" />
                <t:TableColumn x:Name="WorkersColumn"
                               DisplayName="Workers"
                               Width="100"
                               MinWidth="80"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource WorkersCell}" />
                <t:TableColumn x:Name="YieldColumn"
                               DisplayName="Yield"
                               Width="80"
                               MinWidth="60"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource YieldCell}" />
                <t:TableColumn x:Name="RemainingColumn"
                               DisplayName="Remaining"
                               Width="110"
                               MinWidth="80"
                               CellTemplate="{StaticResource RemainingCell}" />
                <t:TableColumn x:Name="SubmittedColumn"
                               DisplayName="Submitted"
                               Width="150"
                               MinWidth="130"
                               CellTemplate="{StaticResource SubmittedCell}" />
                <t:TableColumn x:Name="FinishedColumn"
                               DisplayName="Finished"
                               Width="150"
                               MinWidth="130"
                               CellTemplate="{StaticResource FinishedCell}" />
                <t:TableColumn x:Name="ActionColumn"
                               DisplayName="Action"
                               Width="110"
                               MinWidth="100"
                               CellTemplate="{StaticResource ActionCell}" />
            </t:TableView.Columns>
        </t:TableView>
    </Grid>
</Page>
